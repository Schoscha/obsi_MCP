      name: "edit_file"
      arguments_json: "{\"Instruction\":\"Conditionally render modals in App.tsx\", \"ReplacementContent\":\"      {/* Full 32-Chapter Task Checklist Modal */}\\n      {isChecklistOpen && (\\n        <GlassChecklistModal\\n          isOpen={isChecklistOpen}\\n          onClose={() => setIsChecklistOpen(false)}\\n          tasks={tasks}\\n          onToggleTask={handleToggleTask}\\n          onBatchTogglePhase={handleBatchTogglePhase}\\n          themeMode={themeMode}\\n        />\\n      )}\\n\\n      {/* RRF Simulator & Hybrid Search Modal */}\\n      {isSimulatorOpen && (\\n        <GlassSimulatorModal\\n          isOpen={isSimulatorOpen}\\n          onClose={() => setIsSimulatorOpen(false)}\\n          themeMode={themeMode}\\n        />\\n      )}\\n\\n      {/* Interactive Obsidian Markdown Note Reader & Editor */}\\n      {isNoteModalOpen && selectedNote && (\\n        <GlassNoteModal\\n          isOpen={isNoteModalOpen}\\n          onClose={() => setIsNoteModalOpen(false)}\\n          note={selectedNote}\\n          onSaveNote={handleSaveNote}\\n          themeMode={themeMode}\\n        />\\n      )}\\n\\n      {/* Interactive Obsidian 2D Graph View Modal */}\\n      {isGraphOpen && (\\n        <GlassGraphModal\\n          isOpen={isGraphOpen}\\n          onClose={() => setIsGraphOpen(false)}\\n          themeMode={themeMode}\\n          onSelectNode={(nodeName) => {\\n            showNotification(`Knoten im Graph fokussiert: ${nodeName}`);\\n          }}\\n        />\\n      )}\\n\\n      {/* Full Concept & Sinnhaftigkeit Analysis Modal */}\\n      {isAnalysisOpen && (\\n        <GlassAnalysisModal\\n          isOpen={isAnalysisOpen}\\n          onClose={() => setIsAnalysisOpen(false)}\\n          themeMode={themeMode}\\n          onOpenChecklist={() => setIsChecklistOpen(true)}\\n          onOpenAudio={() => setIsAudioPlayerOpen(true)}\\n        />\\n      )}\\n\\n      {/* News & Release Notes Modal */}\\n      {isNewsOpen && (\\n        <GlassNewsModal\\n          isOpen={isNewsOpen}\\n          onClose={() => setIsNewsOpen(false)}\\n          themeMode={themeMode}\\n        />\\n      )}\\n\\n      {/* Spoken Audio Explanation Player Modal */}\\n      {isAudioPlayerOpen && (\\n        <GlassAudioPlayerModal\\n          isOpen={isAudioPlayerOpen}\\n          onClose={() => setIsAudioPlayerOpen(false)}\\n          themeMode={themeMode}\\n        />\\n      )}\", \"TargetContent\":\"      {/* Full 32-Chapter Task Checklist Modal */}\\n      <GlassChecklistModal\\n        isOpen={isChecklistOpen}\\n        onClose={() => setIsChecklistOpen(false)}\\n        tasks={tasks}\\n        onToggleTask={handleToggleTask}\\n        onBatchTogglePhase={handleBatchTogglePhase}\\n        themeMode={themeMode}\\n      />\\n\\n      {/* RRF Simulator & Hybrid Search Modal */}\\n      <GlassSimulatorModal\\n        isOpen={isSimulatorOpen}\\n        onClose={() => setIsSimulatorOpen(false)}\\n        themeMode={themeMode}\\n      />\\n\\n      {/* Interactive Obsidian Markdown Note Reader & Editor */}\\n      <GlassNoteModal\\n        isOpen={isNoteModalOpen}\\n        onClose={() => setIsNoteModalOpen(false)}\\n        note={selectedNote}\\n        onSaveNote={handleSaveNote}\\n        themeMode={themeMode}\\n      />\\n\\n      {/* Interactive Obsidian 2D Graph View Modal */}\\n      <GlassGraphModal\\n        isOpen={isGraphOpen}\\n        onClose={() => setIsGraphOpen(false)}\\n        themeMode={themeMode}\\n        onSelectNode={(nodeName) => {\\n          showNotification(`Knoten im Graph fokussiert: ${nodeName}`);\\n        }}\\n      />\\n\\n      {/* Full Concept & Sinnhaftigkeit Analysis Modal */}\\n      <GlassAnalysisModal\\n        isOpen={isAnalysisOpen}\\n        onClose={() => setIsAnalysisOpen(false)}\\n        themeMode={themeMode}\\n        onOpenChecklist={() => setIsChecklistOpen(true)}\\n        onOpenAudio={() => setIsAudioPlayerOpen(true)}\\n      />\\n\\n      {/* News & Release Notes Modal */}\\n      <GlassN