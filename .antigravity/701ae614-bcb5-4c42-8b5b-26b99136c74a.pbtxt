    replacement_chunks {
      replacement_content: "import { X, BookOpen, CheckCircle, ShieldCheck, Zap, Layers, AlertTriangle } from \'lucide-react\';\n\ninterface Props {\n  isOpen: boolean;\n  onClose: () => void;\n  themeMode: \'weiss\' | \'bunt\';\n  onOpenChecklist: () => void;\n}\n\nexport const GlassAnalysisModal = ({\n  isOpen,\n  onClose,\n  themeMode,\n  onOpenChecklist,\n}: Props) => {\n  if (!isOpen) return null;\n  const isWeiss = themeMode === \'weiss\';\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-6 bg-black/45 backdrop-blur-md animate-in fade-in duration-200\">\n      <div\n        className={`w-full max-w-4xl max-h-[92vh] rounded-3xl flex flex-col glass-rainbow-edge overflow-hidden shadow-2xl transition-all duration-300 ${\n          isWeiss ? \'glass-white text-slate-800\' : \'glass-bunt text-slate-100\'\n        }`}\n      >\n        {/* Header */}\n        <div className=\"p-4 sm:p-6 border-b border-slate-300/40 flex items-center justify-between\">\n          <div className=\"flex items-center gap-3\">\n            <div\n              className={`w-9 h-9 rounded-xl flex items-center justify-center ${\n                isWeiss ? \'bg-indigo-600 text-white\' : \'bg-cyan-400 text-slate-950 font-bold\'\n              }`}\n            >\n              <BookOpen className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <h2 className=\"text-lg font-bold font-display text-slate-900 dark:text-white\">\n                Analyse & Sinnhaftigkeit des Konzepts\n              </h2>\n              <p className=\"text-xs text-slate-600 dark:text-slate-300\">\n                Blake Crosley 2026 Leitfaden \302\267 Ist die kombinierte Version umsetzbar?\n              </p>\n            </div>\n          </div>\n\n          <button\n            onClick={onClose}\n            className={`p-2 rounded-full transition-all cursor-pointer ${\n              isWeiss ? \'hover:bg-slate-200 text-slate-700\' : \'hover:bg-white/20 text-slate-200\'\n            }`}\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Content Body */}\n        <div className=\"flex-1 overflow-y-auto p-4 sm:p-6 space-y-5 text-xs leading-relaxed\">\n          {/* Kern-Urteil Box */}\n          <div\n            className={`p-4 rounded-2xl border ${\n              isWeiss\n                ? \'bg-emerald-50/80 border-emerald-300 text-emerald-950\'\n                : \'bg-emerald-950/40 border-emerald-500/50 text-emerald-200\'\n            }`}\n          >\n            <div className=\"flex items-center gap-2 font-bold text-sm mb-1 text-emerald-600 dark:text-emerald-400\">\n              <CheckCircle className=\"w-4 h-4\" />\n              <span>Klares Fazit: Hochgradig sinnvoll und 100% praxistauglich!</span>\n            </div>\n            <p>\n              Die Kombination aus <strong>Obsidian MCP</strong>, <strong>SQLite FTS5 (BM25)</strong>,{\' \'}\n              <strong>sqlite-vec</strong>, <strong>Model2Vec</strong> und <strong>Claude Code</strong> l\303\266st das\n              gr\303\266\303\237te Problem moderner KI-Agenten: <em>Fehlender oder falscher lokaler Kontext ohne exorbitante Latenz oder Cloud-Kosten.</em>\n            </p>\n          </div>\n\n          {/* 3 Hauptfragen beantwortet */}\n          <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n            <div\n              className={`p-4 rounded-2xl border ${\n                isWeiss ? \'bg-white/70 border-slate-200\' : \'bg-white/5 border-white/10\'\n              }`}\n            >\n              <div className=\"flex items-center gap-2 font-bold text-slate-900 dark:text-white mb-2\">\n                <Zap className=\"w-4 h-4 text-amber-500\" />\n                <span>1. Sinn & Sinnhaftigkeit</span>\n              </div>\n              <p className=\"text-slate-600 dark:text-slate-300\">\n                Reine Vektorsuche scheitert bei exakten Bezeichnern (z.B. Funktionsnamen, Ticket-IDs). Reine Keyword-Suche scheitert bei Synonymen. Die RRF-Fusion ($k=60$) kombiniert beide Welten verlustfrei.\n              </p>\n            </div>\n\n            <div\n              className={`p-4 rounded-2xl border ${\n                isWeiss ? \'bg-white/70 border-slate-200\' : \'bg-white/5 border-white/10\'\n              }`}\n            >\n              <div className=\"flex items-center gap-2 font-bold text-slate-900 dark:text-white mb-2\">\n                <ShieldCheck className=\"w-4 h-4 text-indigo-500\" />\n                <span>2. Machbarkeit</span>\n              </div>\n              <p className=\"text-slate-600 dark:text-slate-300\">\n                Vollst\303\244ndig lokal. Durch <strong>Model2Vec (30 MB)</strong> und <strong>SQLite</strong> entf\303\244llt jeglicher GPU- oder Cloud-Zwang. 16.000 Notizen indizieren in 4 Minuten, Abfragen dauern nur 23 Millisekunden.\n              </p>\n            </div>\n\n            <div\n              className={`p-4 rounded-2xl border ${\n                isWeiss ? \'bg-white/70 border-slate-200\' : \'bg-white/5 border-white/10\'\n              }`}\n            >\n              <div className=\"flex items-center gap-2 font-bold text-slate-900 dark:text-white mb-2\">\n                <Layers className=\"w-4 h-4 text-cyan-500\" />\n                <span>3. Agenten-Integration</span>\n              </div>\n              <p className=\"text-slate-600 dark:text-slate-300\">\n                \303\234ber <code>UserPromptSubmit</code>-Hooks in Claude Code injiziert das System genau den richtigen Ausschnitt (max. 1.500 Tokens) \342\200\223 ohne den Claude Prompt Cache zu invalidieren.\n              </p>\n            </div>\n          </div>\n\n          {/* Gefahren & Fallstricke */}\n          <div\n            className={`p-4 rounded-2xl border ${\n              isWeiss ? \'bg-amber-50/70 border-amber-200\' : \'bg-amber-950/20 border-amber-500/30\'\n            }`}\n          >\n            <div className=\"flex items-center gap-2 font-bold text-amber-700 dark:text-amber-400 mb-1.5\">\n              <AlertTriangle className=\"w-4 h-4\" />\n              <span>Die 3 kritischen Fallstricke aus dem Leitfaden:</span>\n            </div>\n            <ul className=\"space-y-1.5 text-slate-700 dark:text-slate-300 pl-2\">\n              <li>\n                <strong>1. NPM Namenskollision:</strong> <code>obsidian-mcp</code> (StevenStavrakis) verwenden \342\200\223 <em>nicht</em> das veraltete Plugin-gebundene Paket.\n              </li>\n              <li>\n                <strong>2. Pfad f\303\274r Claude Code MCP:</strong> Muss in <code>~/.claude.json</code> registriert werden (nicht in <code>settings.json</code>).\n              </li>\n              <li>\n                <strong>3. Token-Budget-Deckelung:</strong> Kontext zwingend auf max. 4.000 Tokens kappen, um Kontext-Rotting und hohe API-Kosten zu verhindern.\n              </li>\n            </ul>\n          </div>\n        </div>\n\n        {/* Footer */}\n        <div className=\"p-4 sm:p-6 border-t border-slate-300/40 flex items-center justify-between bg-white/10\">\n          <span className=\"text-xs text-slate-500\">Alle 32 Kapitel stehen als interaktive Taskliste bereit.</span>\n          <button\n            onClick={() => {\n              onClose();\n              onOpenChecklist();\n            }}\n            className={`px-4 py-2 rounded-xl text-xs font-bold transition-all cursor-pointer ${\n              isWeiss\n                ? \'bg-indigo-600 hover:bg-indigo-700 text-white\'\n                : \'bg-cyan-400 hover:bg-cyan-300 text-slate-950 font-bold\'\n            }`}\n          >\n            Zur 32-Kapitel Taskliste wechseln\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
