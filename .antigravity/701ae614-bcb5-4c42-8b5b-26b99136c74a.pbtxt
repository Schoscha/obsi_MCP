  view_file {
    absolute_path_uri: "file:///src/components/GlassAudioPlayerModal.tsx"
    end_line: 453
    content: "import { useState, useEffect, useRef } from \'react\';\nimport {\n  X,\n  Play,\n  Pause,\n  SkipBack,\n  SkipForward,\n  Volume2,\n  VolumeX,\n  Sparkles,\n  Headphones,\n  CheckCircle2,\n  ListMusic,\n  Gauge,\n  RotateCcw,\n} from \'lucide-react\';\nimport { AUDIO_EXPLANATION_CHAPTERS, AudioChapter } from \'../data/audioExplanationData\';\n\ninterface Props {\n  isOpen: boolean;\n  onClose: () => void;\n  themeMode: \'weiss\' | \'bunt\';\n}\n\nexport const GlassAudioPlayerModal = ({ isOpen, onClose, themeMode }: Props) => {\n  if (!isOpen) return null;\n\n  const isWeiss = themeMode === \'weiss\';\n  const [currentChapterIdx, setCurrentChapterIdx] = useState(0);\n  const [isPlaying, setIsPlaying] = useState(false);\n  const [rate, setRate] = useState(1.0);\n  const [selectedVoice, setSelectedVoice] = useState<SpeechSynthesisVoice | null>(null);\n  const [availableVoices, setAvailableVoices] = useState<SpeechSynthesisVoice[]>([]);\n  const [progressPercent, setProgressPercent] = useState(0);\n  const [isMuted, setIsMuted] = useState(false);\n\n  const utteranceRef = useRef<SpeechSynthesisUtterance | null>(null);\n  const progressTimerRef = useRef<any>(null);\n\n  const currentChapter = AUDIO_EXPLANATION_CHAPTERS[currentChapterIdx];\n\n  // Initialize available German voices\n  useEffect(() => {\n    const updateVoices = () => {\n      if (typeof window !== \'undefined\' && \'speechSynthesis\' in window) {\n        const voices = window.speechSynthesis.getVoices();\n        const germanVoices = voices.filter(\n          (v) => v.lang.startsWith(\'de\') || v.lang.startsWith(\'DE\')\n        );\n        setAvailableVoices(germanVoices.length > 0 ? germanVoices : voices);\n\n        // Pick best natural German voice\n        const preferred =\n          germanVoices.find((v) => v.name.includes(\'Google\') || v.name.includes(\'Natural\')) ||\n          germanVoices[0] ||\n          voices[0];\n        if (preferred) setSelectedVoice(preferred);\n      }\n    };\n\n    updateVoices();\n    if (typeof window !== \'undefined\' && \'speechSynthesis\' in window) {\n      window.speechSynthesis.onvoiceschanged = updateVoices;\n    }\n\n    return () => {\n      if (typeof window !== \'undefined\' && \'speechSynthesis\' in window) {\n        window.speechSynthesis.cancel();\n      }\n    };\n  }, []);\n\n  // Handle Playback\n  const playChapter = (index: number, startRate = rate) => {\n    if (typeof window === \'undefined\' || !(\'speechSynthesis\' in window)) return;\n\n    window.speechSynthesis.cancel();\n    clearInterval(progressTimerRef.current);\n\n    const chapter = AUDIO_EXPLANATION_CHAPTERS[index];\n    if (!chapter) return;\n\n    const utterance = new SpeechSynthesisUtterance(chapter.text);\n    utterance.lang = \'de-DE\';\n    utterance.rate = startRate;\n    if (selectedVoice) utterance.voice = selectedVoice;\n\n    let charCount = 0;\n    const totalChars = chapter.text.length;\n\n    utterance.onboundary = (e) => {\n      if (e.charIndex !== undefined) {\n        charCount = e.charIndex;\n        setProgressPercent(Math.min(Math.round((charCount / totalChars) * 100), 100));\n      }\n    };\n\n    utterance.onend = () => {\n      setIsPlaying(false);\n      setProgressPercent(100);\n      clearInterval(progressTimerRef.current);\n\n      // Auto-advance to next chapter if available\n      if (index < AUDIO_EXPLANATION_CHAPTERS.length - 1) {\n        setTimeout(() => {\n          setCurrentChapterIdx(index + 1);\n          playChapter(index + 1, startRate);\n        }, 800);\n      }\n    };\n\n    utterance.onerror = () => {\n      setIsPlaying(false);\n      clearInterval(progressTimerRef.current);\n    };\n\n    utteranceRef.current = utterance;\n    window.speechSynthesis.speak(utterance);\n    setIsPlaying(true);\n    setCurrentChapterIdx(index);\n    setProgressPercent(0);\n\n    // Simulated backup progress ticker\n    const intervalMs = Math.max(Math.floor((chapter.text.length * 50) / (100 * startRate)), 200);\n    let p = 0;\n    progressTimerRef.current = setInterval(() => {\n      p += 1;\n      if (p <= 98) setProgressPercent((prev) => Math.max(prev, p));\n    }, intervalMs);\n  };\n\n  const togglePlay = () => {\n    if (typeof window === \'undefined\' || !(\'speechSynthesis\' in window)) return;\n\n    if (isPlaying) {\n      window.speechSynthesis.cancel();\n      clearInterval(progressTimerRef.current);\n      setIsPlaying(false);\n    } else {\n      playChapter(currentChapterIdx, rate);\n    }\n  };\n\n  const handleNextChapter = () => {\n    if (currentChapterIdx < AUDIO_EXPLANATION_CHAPTERS.length - 1) {\n      const nextIdx = currentChapterIdx + 1;\n      setCurrentChapterIdx(nextIdx);\n      if (isPlaying) playChapter(nextIdx, rate);\n      else setProgressPercent(0);\n    }\n  };\n\n  const handlePrevChapter = () => {\n    if (currentChapterIdx > 0) {\n      const prevIdx = currentChapterIdx - 1;\n      setCurrentChapterIdx(prevIdx);\n      if (isPlaying) playChapter(prevIdx, rate);\n      else setProgressPercent(0);\n    }\n  };\n\n  const handleRateChange = () => {\n    const rates = [1.0, 1.25, 1.5, 0.9];\n    const curIdx = rates.indexOf(rate);\n    const nextRate = rates[(curIdx + 1) % rates.length];\n    setRate(nextRate);\n    if (isPlaying) {\n      playChapter(currentChapterIdx, nextRate);\n    }\n  };\n\n  const handleClose = () => {\n    if (typeof window !== \'undefined\' && \'speechSynthesis\' in window) {\n      window.speechSynthesis.cancel();\n    }\n    clearInterval(progressTimerRef.current);\n    setIsPlaying(false);\n    onClose();\n  };\n\n  // Waveform bar heights\n  const bars = [\n    12, 28, 45, 60, 35, 70, 85, 95, 55, 75, 90, 65, 40, 80, 100, 70, 50, 85, 60, 45, 75, 30, 50,\n    20,\n  ];\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-6 bg-black/55 backdrop-blur-md animate-in fade-in duration-200\">\n      <div\n        className={`w-full max-w-4xl max-h-[92vh] rounded-3xl flex flex-col glass-rainbow-edge overflow-hidden shadow-2xl transition-all duration-300 ${\n          isWeiss ? \'glass-white text-slate-800\' : \'glass-bunt text-slate-100\'\n        }`}\n      >\n        {/* Header */}\n        <div className=\"p-4 sm:p-6 border-b border-slate-300/40 flex items-center justify-between\">\n          <div className=\"flex items-center gap-3\">\n            <div\n              className={`w-10 h-10 rounded-2xl flex items-center justify-center ${\n                isWeiss\n                  ? \'bg-gradient-to-tr from-indigo-600 to-purple-600 text-white shadow-md\'\n                  : \'bg-gradient-to-tr from-cyan-400 to-fuchsia-500 text-slate-950 font-bold shadow-lg\'\n              }`}\n            >\n              <Headphones className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <span className=\"text-[10px] font-mono font-bold px-2 py-0.5 rounded-full bg-indigo-500/20 text-indigo-600 dark:text-cyan-300 border border-indigo-500/30\">\n                  DEUTSCHE AUDIO-ERKL\303\204RUNG\n                </span>\n                <span className=\"text-[11px] font-mono text-slate-500\">\n                  Kapitel {currentChapterIdx + 1} von {AUDIO_EXPLANATION_CHAPTERS.length}\n                </span>\n              </div>\n              <h2 className=\"text-lg font-bold font-display text-slate-900 dark:text-white mt-0.5\">\n                Obsidian Hybrid Retrieval & MCP System\n              </h2>\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-2\">\n            <button\n              onClick={handleRateChange}\n              className={`px-2.5 py-1.5 rounded-xl text-xs font-mono font-bold flex items-center gap-1 transition-all cursor-pointer ${\n                isWeiss\n                  ? \'bg-white text-indigo-700 border border-slate-200 hover:bg-slate-50 shadow-sm\'\n                  : \'bg-white/10 text-cyan-300 border border-white/20 hover:bg-white/20\'\n              }`}\n              title=\"Geschwindigkeit anpassen\"\n            >\n              <Gauge className=\"w-3.5 h-3.5\" />\n              <span>{rate}x</span>\n            </button>\n\n            <button\n              onClick={handleClose}\n              className={`p-2 rounded-full transition-all cursor-pointer ${\n                isWeiss ? \'hover:bg-slate-200 text-slate-700\' : \'hover:bg-white/20 text-slate-200\'\n              }`}\n            >\n              <X className=\"w-5 h-5\" />\n            </button>\n          </div>\n        </div>\n\n        {/* Audio Waveform & Player Deck */}\n        <div\n          className={`p-5 sm:p-6 border-b border-slate-300/40 flex flex-col items-center justify-center relative overflow-hidden ${\n            isWeiss ? \'bg-gradient-to-b from-indigo-50/50 to-white/40\' : \'bg-black/30\'\n          }`}\n        >\n          {/* Animated Waveform Visualizer */}\n          <div className=\"h-16 w-full max-w-lg flex items-center justify-center gap-1.5 px-4 mb-3\">\n            {bars.map((barH, i) => {\n              const activeHeight = isPlaying ? Math.max(15, (barH * (0.4 + (i % 5) * 0.15))) : 12;\n              return (\n                <div\n                  key={i}\n                  className={`w-1.5 rounded-full transition-all duration-150 ${\n                    isWeiss\n                      ? isPlaying\n                        ? \'bg-gradient-to-t from-indigo-600 to-purple-500 shadow-sm\'\n                        : \'bg-indigo-300/40\'\n                      : isPlaying\n                      ? \'bg-gradient-to-t from-cyan-400 via-fuchsia-400 to-amber-300 shadow-lg\'\n                      : \'bg-white/20\'\n                  }`}\n                  style={{\n                    height: `${activeHeight}%`,\n                    animation: isPlaying ? `pulse 1.${(i % 4) + 2}s infinite ease-in-out` : \'none\',\n                  }}\n                />\n              );\n            })}\n          </div>\n\n          {/* Current Chapter Title & Subtitle */}\n          <div className=\"text-center max-w-xl mb-4 px-2\">\n            <h3 className=\"text-base sm:text-lg font-bold font-display text-slate-900 dark:text-white\">\n              {currentChapter.title}\n            </h3>\n            <p className=\"text-xs text-slate-600 dark:text-slate-300 mt-1\">\n              {currentChapter.subtitle}\n            </p>\n          </div>\n\n          {/* Progress Bar with scrubber */}\n          <div className=\"w-full max-w-md flex items-center gap-3 mb-4 text-xs font-mono text-slate-500\">\n            <span>\n              {Math.floor((progressPercent * 60) / 10000)}:\n              {String(Math.floor(((progressPercent * 60) / 100) % 60)).padStart(2, \'0\')}\n            </span>\n\n            <div className=\"flex-1 h-2 rounded-full bg-slate-300/40 overflow-hidden relative\">\n              <div\n                className={`h-full transition-all duration-200 rounded-full ${\n                  isWeiss\n                    ? \'bg-gradient-to-r from-indigo-600 to-purple-600\'\n                    : \'bg-gradient-to-r from-cyan-400 to-fuchsia-500\'\n                }`}\n                style={{ width: `${progressPercent}%` }}\n              />\n            </div>\n\n            <span>{currentChapter.durationEst}</span>\n          </div>\n\n          {/* Control Buttons */}\n          <div className=\"flex items-center gap-4\">\n            <button\n              onClick={handlePrevChapter}\n              disabled={currentChapterIdx === 0}\n              className={`p-2.5 rounded-full transition-all cursor-pointer ${\n                currentChapterIdx === 0\n                  ? \'opacity-30 cursor-not-allowed\'\n                  : isWeiss\n                  ? \'hover:bg-slate-200 text-slate-700\'\n                  : \'hover:bg-white/20 text-slate-200\'\n              }`}\n              title=\"Vorheriges Kapitel\"\n            >\n              <SkipBack className=\"w-5 h-5\" />\n            </button>\n\n            {/* Main Play / Pause Button */}\n            <button\n              onClick={togglePlay}\n              className={`w-14 h-14 rounded-full flex items-center justify-center transition-all transform hover:scale-105 active:scale-95 cursor-pointer shadow-xl ${\n                isWeiss\n                  ? \'bg-indigo-600 hover:bg-indigo-700 text-white shadow-indigo-500/30\'\n                  : \'bg-gradient-to-tr from-cyan-400 to-fuchsia-500 text-slate-950 font-bold shadow-cyan-500/30\'\n              }`}\n              title={isPlaying ? \'Pause\' : \'Abspielen\'}\n            >\n              {isPlaying ? (\n                <Pause className=\"w-6 h-6 fill-current\" />\n              ) : (\n                <Play className=\"w-6 h-6 fill-current ml-0.5\" />\n              )}\n            </button>\n\n            <button\n              onClick={handleNextChapter}\n              disabled={currentChapterIdx === AUDIO_EXPLANATION_CHAPTERS.length - 1}\n              className={`p-2.5 rounded-full transition-all cursor-pointer ${\n                currentChapterIdx === AUDIO_EXPLANATION_CHAPTERS.length - 1\n                  ? \'opacity-30 cursor-not-allowed\'\n                  : isWeiss\n                  ? \'hover:bg-slate-200 text-slate-700\'\n                  : \'hover:bg-white/20 text-slate-200\'\n              }`}\n              title=\"N\303\244chstes Kapitel\"\n            >\n              <SkipForward className=\"w-5 h-5\" />\n            </button>\n          </div>\n        </div>\n\n        {/* Bottom Split: Chapter Playlist (Left) & Spoken Transcript (Right) */}\n        <div className=\"flex-1 flex flex-col md:flex-row overflow-hidden\">\n          {/* Chapter Playlist Drawer */}\n          <div\n            className={`w-full md:w-80 border-b md:border-b-0 md:border-r border-slate-300/40 p-4 overflow-y-auto space-y-1.5 ${\n              isWeiss ? \'bg-white/40\' : \'bg-black/20\'\n            }`}\n          >\n            <div className=\"text-[11px] font-mono uppercase tracking-wider text-slate-500 font-bold px-2 mb-2 flex items-center justify-between\">\n              <span>Kapitel\303\274bersicht</span>\n              <ListMusic className=\"w-3.5 h-3.5\" />\n            </div>\n\n            {AUDIO_EXPLANATION_CHAPTERS.map((chap, idx) => {\n              const isSelected = idx === currentChapterIdx;\n              return (\n                <div\n                  key={chap.id}\n                  onClick={() => {\n                    setCurrentChapterIdx(idx);\n                    playChapter(idx, rate);\n                  }}\n                  className={`p-2.5 rounded-xl cursor-pointer text-xs transition-all flex items-center justify-between gap-2 ${\n                    isSelected\n                      ? isWeiss\n                        ? \'bg-indigo-50 border border-indigo-200 text-indigo-950 font-bold shadow-sm\'\n                        : \'bg-white/20 border border-cyan-400/50 text-white font-bold shadow-md\'\n                      : isWeiss\n                      ? \'hover:bg-white/70 text-slate-700\'\n                      : \'hover:bg-white/10 text-slate-300\'\n                  }`}\n                >\n                  <div className=\"flex items-center gap-2 min-w-0\">\n                    <span\n                      className={`w-5 h-5 rounded-full flex items-center justify-center font-mono text-[10px] shrink-0 ${\n                        isSelected\n                          ? isWeiss\n                            ? \'bg-indigo-600 text-white\'\n                            : \'bg-cyan-400 text-slate-950 font-bold\'\n                          : \'bg-slate-200 dark:bg-white/10 text-slate-600 dark:text-slate-400\'\n                      }`}\n                    >\n                      {idx + 1}\n                    </span>\n                    <span className=\"truncate text-[11px]\">{chap.title.replace(/^\\d+\\.\\s*/, \'\')}</span>\n                  </div>\n\n                  <span className=\"text-[10px] font-mono text-slate-400 shrink-0\">\n                    {chap.durationEst}\n                  </span>\n                </div>\n              );\n            })}\n          </div>\n\n          {/* Spoken Text Transcript Drawer */}\n          <div className=\"flex-1 p-4 sm:p-6 overflow-y-auto\">\n            <div className=\"flex items-center justify-between mb-3 text-xs font-medium text-slate-500\">\n              <span className=\"uppercase tracking-wider font-mono text-[11px]\">\n                Gesprochener Text (Transkript)\n              </span>\n              <span className=\"text-[11px] font-mono\">\n                {selectedVoice ? selectedVoice.name : \'System-Stimme (Deutsch)\'}\n              </span>\n            </div>\n\n            <div\n              className={`p-4 rounded-2xl border text-xs sm:text-sm leading-relaxed whitespace-pre-line font-normal transition-all ${\n                isWeiss\n                  ? \'bg-white/80 border-slate-200 text-slate-800\'\n                  : \'bg-white/5 border-white/10 text-slate-200\'\n              }`}\n            >\n              {currentChapter.text}\n            </div>\n\n            <div className=\"mt-4 flex items-center justify-between text-xs text-slate-500 font-mono\">\n              <span>Tipp: Klicke auf \'Play\', um die Erkl\303\244rung laut vorzulesen.</span>\n              <button\n                onClick={() => {\n                  navigator.clipboard.writeText(\n                    AUDIO_EXPLANATION_CHAPTERS.map((c) => `# ${c.title}\\n\\n${c.text}`).join(\'\\n\\n---\\n\\n\')\n                  );\n                }}\n                className=\"hover:text-indigo-600 dark:hover:text-cyan-300 underline cursor-pointer\"\n              >\n                Volltext kopieren\n              </button>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    raw_content: "import { useState, useEffect, useRef } from \'react\';\nimport {\n  X,\n  Play,\n  Pause,\n  SkipBack,\n  SkipForward,\n  Volume2,\n  VolumeX,\n  Sparkles,\n  Headphones,\n  CheckCircle2,\n  ListMusic,\n  Gauge,\n  RotateCcw,\n} from \'lucide-react\';\nimport { AUDIO_EXPLANATION_CHAPTERS, AudioChapter } from \'../data/audioExplanationData\';\n\ninterface Props {\n  isOpen: boolean;\n  onClose: () => void;\n  themeMode: \'weiss\' | \'bunt\';\n}\n\nexport const GlassAudioPlayerModal = ({ isOpen, onClose, themeMode }: Props) => {\n  if (!isOpen) return null;\n\n  const isWeiss = themeMode === \'weiss\';\n  const [currentChapterIdx, setCurrentChapterIdx] = useState(0);\n  const [isPlaying, setIsPlaying] = useState(false);\n  const [rate, setRate] = useState(1.0);\n  const [selectedVoice, setSelectedVoice] = useState<SpeechSynthesisVoice | null>(null);\n  const [availableVoices, setAvailableVoices] = useState<SpeechSynthesisVoice[]>([]);\n  const [progressPercent, setProgressPercent] = useState(0);\n  const [isMuted, setIsMuted] = useState(false);\n\n  const utteranceRef = useRef<SpeechSynthesisUtterance | null>(null);\n  const progressTimerRef = useRef<any>(null);\n\n  const currentChapter = AUDIO_EXPLANATION_CHAPTERS[currentChapterIdx];\n\n  // Initialize available German voices\n  useEffect(() => {\n    const updateVoices = () => {\n      if (typeof window !== \'undefined\' && \'speechSynthesis\' in window) {\n        const voices = window.speechSynthesis.getVoices();\n        const germanVoices = voices.filter(\n          (v) => v.lang.startsWith(\'de\') || v.lang.startsWith(\'DE\')\n        );\n        setAvailableVoices(germanVoices.length > 0 ? germanVoices : voices);\n\n        // Pick best natural German voice\n        const preferred =\n          germanVoices.find((v) => v.name.includes(\'Google\') || v.name.includes(\'Natural\')) ||\n          germanVoices[0] ||\n          voices[0];\n        if (preferred) setSelectedVoice(preferred);\n      }\n    };\n\n    updateVoices();\n    if (typeof window !== \'undefined\' && \'speechSynthesis\' in window) {\n      window.speechSynthesis.onvoiceschanged = updateVoices;\n    }\n\n    return () => {\n      if (typeof window !== \'undefined\' && \'speechSynthesis\' in window) {\n        window.speechSynthesis.cancel();\n      }\n    };\n  }, []);\n\n  // Handle Playback\n  const playChapter = (index: number, startRate = rate) => {\n    if (typeof window === \'undefined\' || !(\'speechSynthesis\' in window)) return;\n\n    window.speechSynthesis.cancel();\n    clearInterval(progressTimerRef.current);\n\n    const chapter = AUDIO_EXPLANATION_CHAPTERS[index];\n    if (!chapter) return;\n\n    const utterance = new SpeechSynthesisUtterance(chapter.text);\n    utterance.lang = \'de-DE\';\n    utterance.rate = startRate;\n    if (selectedVoice) utterance.voice = selectedVoice;\n\n    let charCount = 0;\n    const totalChars = chapter.text.length;\n\n    utterance.onboundary = (e) => {\n      if (e.charIndex !== undefined) {\n        charCount = e.charIndex;\n        setProgressPercent(Math.min(Math.round((charCount / totalChars) * 100), 100));\n      }\n    };\n\n    utterance.onend = () => {\n      setIsPlaying(false);\n      setProgressPercent(100);\n      clearInterval(progressTimerRef.current);\n\n      // Auto-advance to next chapter if available\n      if (index < AUDIO_EXPLANATION_CHAPTERS.length - 1) {\n        setTimeout(() => {\n          setCurrentChapterIdx(index + 1);\n          playChapter(index + 1, startRate);\n        }, 800);\n      }\n    };\n\n    utterance.onerror = () => {\n      setIsPlaying(false);\n      clearInterval(progressTimerRef.current);\n    };\n\n    utteranceRef.current = utterance;\n    window.speechSynthesis.speak(utterance);\n    setIsPlaying(true);\n    setCurrentChapterIdx(index);\n    setProgressPercent(0);\n\n    // Simulated backup progress ticker\n    const intervalMs = Math.max(Math.floor((chapter.text.length * 50) / (100 * startRate)), 200);\n    let p = 0;\n    progressTimerRef.current = setInterval(() => {\n      p += 1;\n      if (p <= 98) setProgressPercent((prev) => Math.max(prev, p));\n    }, intervalMs);\n  };\n\n  const togglePlay = () => {\n    if (typeof window === \'undefined\' || !(\'speechSynthesis\' in window)) return;\n\n    if (isPlaying) {\n      window.speechSynthesis.cancel();\n      clearInterval(progressTimerRef.current);\n      setIsPlaying(false);\n    } else {\n      playChapter(currentChapterIdx, rate);\n    }\n  };\n\n  const handleNextChapter = () => {\n    if (currentChapterIdx < AUDIO_EXPLANATION_CHAPTERS.length - 1) {\n      const nextIdx = currentChapterIdx + 1;\n      setCurrentChapterIdx(nextIdx);\n      if (isPlaying) playChapter(nextIdx, rate);\n      else setProgressPercent(0);\n    }\n  };\n\n  const handlePrevChapter = () => {\n    if (currentChapterIdx > 0) {\n      const prevIdx = currentChapterIdx - 1;\n      setCurrentChapterIdx(prevIdx);\n      if (isPlaying) playChapter(prevIdx, rate);\n      else setProgressPercent(0);\n    }\n  };\n\n  const handleRateChange = () => {\n    const rates = [1.0, 1.25, 1.5, 0.9];\n    const curIdx = rates.indexOf(rate);\n    const nextRate = rates[(curIdx + 1) % rates.length];\n    setRate(nextRate);\n    if (isPlaying) {\n      playChapter(currentChapterIdx, nextRate);\n    }\n  };\n\n  const handleClose = () => {\n    if (typeof window !== \'undefined\' && \'speechSynthesis\' in window) {\n      window.speechSynthesis.cancel();\n    }\n    clearInterval(progressTimerRef.current);\n    setIsPlaying(false);\n    onClose();\n  };\n\n  // Waveform bar heights\n  const bars = [\n    12, 28, 45, 60, 35, 70, 85, 95, 55, 75, 90, 65, 40, 80, 100, 70, 50, 85, 60, 45, 75, 30, 50,\n    20,\n  ];\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-6 bg-black/55 backdrop-blur-md animate-in fade-in duration-200\">\n      <div\n        className={`w-full max-w-4xl max-h-[92vh] rounded-3xl flex flex-col glass-rainbow-edge overflow-hidden shadow-2xl transition-all duration-300 ${\n          isWeiss ? \'glass-white text-slate-800\' : \'glass-bunt text-slate-100\'\n        }`}\n      >\n        {/* Header */}\n        <div className=\"p-4 sm:p-6 border-b border-slate-300/40 flex items-center justify-between\">\n          <div className=\"flex items-center gap-3\">\n            <div\n              className={`w-10 h-10 rounded-2xl flex items-center justify-center ${\n                isWeiss\n                  ? \'bg-gradient-to-tr from-indigo-600 to-purple-600 text-white shadow-md\'\n                  : \'bg-gradient-to-tr from-cyan-400 to-fuchsia-500 text-slate-950 font-bold shadow-lg\'\n              }`}\n            >\n              <Headphones className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <span className=\"text-[10px] font-mono font-bold px-2 py-0.5 rounded-full bg-indigo-500/20 text-indigo-600 dark:text-cyan-300 border border-indigo-500/30\">\n                  DEUTSCHE AUDIO-ERKL\303\204RUNG\n                </span>\n                <span className=\"text-[11px] font-mono text-slate-500\">\n                  Kapitel {currentChapterIdx + 1} von {AUDIO_EXPLANATION_CHAPTERS.length}\n                </span>\n              </div>\n              <h2 className=\"text-lg font-bold font-display text-slate-900 dark:text-white mt-0.5\">\n                Obsidian Hybrid Retrieval & MCP System\n              </h2>\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-2\">\n            <button\n              onClick={handleRateChange}\n              className={`px-2.5 py-1.5 rounded-xl text-xs font-mono font-bold flex items-center gap-1 transition-all cursor-pointer ${\n                isWeiss\n                  ? \'bg-white text-indigo-700 border border-slate-200 hover:bg-slate-50 shadow-sm\'\n                  : \'bg-white/10 text-cyan-300 border border-white/20 hover:bg-white/20\'\n              }`}\n              title=\"Geschwindigkeit anpassen\"\n            >\n              <Gauge className=\"w-3.5 h-3.5\" />\n              <span>{rate}x</span>\n            </button>\n\n            <button\n              onClick={handleClose}\n              className={`p-2 rounded-full transition-all cursor-pointer ${\n                isWeiss ? \'hover:bg-slate-200 text-slate-700\' : \'hover:bg-white/20 text-slate-200\'\n              }`}\n            >\n              <X className=\"w-5 h-5\" />\n            </button>\n          </div>\n        </div>\n\n        {/* Audio Waveform & Player Deck */}\n        <div\n          className={`p-5 sm:p-6 border-b border-slate-300/40 flex flex-col items-center justify-center relative overflow-hidden ${\n            isWeiss ? \'bg-gradient-to-b from-indigo-50/50 to-white/40\' : \'bg-black/30\'\n          }`}\n        >\n          {/* Animated Waveform Visualizer */}\n          <div className=\"h-16 w-full max-w-lg flex items-center justify-center gap-1.5 px-4 mb-3\">\n            {bars.map((barH, i) => {\n              const activeHeight = isPlaying ? Math.max(15, (barH * (0.4 + (i % 5) * 0.15))) : 12;\n              return (\n                <div\n                  key={i}\n                  className={`w-1.5 rounded-full transition-all duration-150 ${\n                    isWeiss\n                      ? isPlaying\n                        ? \'bg-gradient-to-t from-indigo-600 to-purple-500 shadow-sm\'\n                        : \'bg-indigo-300/40\'\n                      : isPlaying\n                      ? \'bg-gradient-to-t from-cyan-400 via-fuchsia-400 to-amber-300 shadow-lg\'\n                      : \'bg-white/20\'\n                  }`}\n                  style={{\n                    height: `${activeHeight}%`,\n                    animation: isPlaying ? `pulse 1.${(i % 4) + 2}s infinite ease-in-out` : \'none\',\n                  }}\n                />\n              );\n            })}\n          </div>\n\n          {/* Current Chapter Title & Subtitle */}\n          <div className=\"text-center max-w-xl mb-4 px-2\">\n            <h3 className=\"text-base sm:text-lg font-bold font-display text-slate-900 dark:text-white\">\n              {currentChapter.title}\n            </h3>\n            <p className=\"text-xs text-slate-600 dark:text-slate-300 mt-1\">\n              {currentChapter.subtitle}\n            </p>\n          </div>\n\n          {/* Progress Bar with scrubber */}\n          <div className=\"w-full max-w-md flex items-center gap-3 mb-4 text-xs font-mono text-slate-500\">\n            <span>\n              {Math.floor((progressPercent * 60) / 10000)}:\n              {String(Math.floor(((progressPercent * 60) / 100) % 60)).padStart(2, \'0\')}\n            </span>\n\n            <div className=\"flex-1 h-2 rounded-full bg-slate-300/40 overflow-hidden relative\">\n              <div\n                className={`h-full transition-all duration-200 rounded-full ${\n                  isWeiss\n                    ? \'bg-gradient-to-r from-indigo-600 to-purple-600\'\n                    : \'bg-gradient-to-r from-cyan-400 to-fuchsia-500\'\n                }`}\n                style={{ width: `${progressPercent}%` }}\n              />\n            </div>\n\n            <span>{currentChapter.durationEst}</span>\n          </div>\n\n          {/* Control Buttons */}\n          <div className=\"flex items-center gap-4\">\n            <button\n              onClick={handlePrevChapter}\n              disabled={currentChapterIdx === 0}\n              className={`p-2.5 rounded-full transition-all cursor-pointer ${\n                currentChapterIdx === 0\n                  ? \'opacity-30 cursor-not-allowed\'\n                  : isWeiss\n                  ? \'hover:bg-slate-200 text-slate-700\'\n                  : \'hover:bg-white/20 text-slate-200\'\n              }`}\n              title=\"Vorheriges Kapitel\"\n            >\n              <SkipBack className=\"w-5 h-5\" />\n            </button>\n\n            {/* Main Play / Pause Button */}\n            <button\n              onClick={togglePlay}\n              className={`w-14 h-14 rounded-full flex items-center justify-center transition-all transform hover:scale-105 active:scale-95 cursor-pointer shadow-xl ${\n                isWeiss\n                  ? \'bg-indigo-600 hover:bg-indigo-700 text-white shadow-indigo-500/30\'\n                  : \'bg-gradient-to-tr from-cyan-400 to-fuchsia-500 text-slate-950 font-bold shadow-cyan-500/30\'\n              }`}\n              title={isPlaying ? \'Pause\' : \'Abspielen\'}\n            >\n              {isPlaying ? (\n                <Pause className=\"w-6 h-6 fill-current\" />\n              ) : (\n                <Play className=\"w-6 h-6 fill-current ml-0.5\" />\n              )}\n            </button>\n\n            <button\n              onClick={handleNextChapter}\n              disabled={currentChapterIdx === AUDIO_EXPLANATION_CHAPTERS.length - 1}\n              className={`p-2.5 rounded-full transition-all cursor-pointer ${\n                currentChapterIdx === AUDIO_EXPLANATION_CHAPTERS.length - 1\n                  ? \'opacity-30 cursor-not-allowed\'\n                  : isWeiss\n                  ? \'hover:bg-slate-200 text-slate-700\'\n                  : \'hover:bg-white/20 text-slate-200\'\n              }`}\n              title=\"N\303\244chstes Kapitel\"\n            >\n              <SkipForward className=\"w-5 h-5\" />\n            </button>\n          </div>\n        </div>\n\n        {/* Bottom Split: Chapter Playlist (Left) & Spoken Transcript (Right) */}\n        <div className=\"flex-1 flex flex-col md:flex-row overflow-hidden\">\n          {/* Chapter Playlist Drawer */}\n          <div\n            className={`w-full md:w-80 border-b md:border-b-0 md:border-r border-slate-300/40 p-4 overflow-y-auto space-y-1.5 ${\n              isWeiss ? \'bg-white/40\' : \'bg-black/20\'\n            }`}\n          >\n            <div className=\"text-[11px] font-mono uppercase tracking-wider text-slate-500 font-bold px-2 mb-2 flex items-center justify-between\">\n              <span>Kapitel\303\274bersicht</span>\n              <ListMusic className=\"w-3.5 h-3.5\" />\n            </div>\n\n            {AUDIO_EXPLANATION_CHAPTERS.map((chap, idx) => {\n              const isSelected = idx === currentChapterIdx;\n              return (\n                <div\n                  key={chap.id}\n                  onClick={() => {\n                    setCurrentChapterIdx(idx);\n                    playChapter(idx, rate);\n                  }}\n                  className={`p-2.5 rounded-xl cursor-pointer text-xs transition-all flex items-center justify-between gap-2 ${\n                    isSelected\n                      ? isWeiss\n                        ? \'bg-indigo-50 border border-indigo-200 text-indigo-950 font-bold shadow-sm\'\n                        : \'bg-white/20 border border-cyan-400/50 text-white font-bold shadow-md\'\n                      : isWeiss\n                      ? \'hover:bg-white/70 text-slate-700\'\n                      : \'hover:bg-white/10 text-slate-300\'\n                  }`}\n                >\n                  <div className=\"flex items-center gap-2 min-w-0\">\n                    <span\n                      className={`w-5 h-5 rounded-full flex items-center justify-center font-mono text-[10px] shrink-0 ${\n                        isSelected\n                          ? isWeiss\n                            ? \'bg-indigo-600 text-white\'\n                            : \'bg-cyan-400 text-slate-950 font-bold\'\n                          : \'bg-slate-200 dark:bg-white/10 text-slate-600 dark:text-slate-400\'\n                      }`}\n                    >\n                      {idx + 1}\n                    </span>\n                    <span className=\"truncate text-[11px]\">{chap.title.replace(/^\\d+\\.\\s*/, \'\')}</span>\n                  </div>\n\n                  <span className=\"text-[10px] font-mono text-slate-400 shrink-0\">\n                    {chap.durationEst}\n                  </span>\n                </div>\n              );\n            })}\n          </div>\n\n          {/* Spoken Text Transcript Drawer */}\n          <div className=\"flex-1 p-4 sm:p-6 overflow-y-auto\">\n            <div className=\"flex items-center justify-between mb-3 text-xs font-medium text-slate-500\">\n              <span className=\"uppercase tracking-wider font-mono text-[11px]\">\n                Gesprochener Text (Transkript)\n              </span>\n              <span className=\"text-[11px] font-mono\">\n                {selectedVoice ? selectedVoice.name : \'System-Stimme (Deutsch)\'}\n              </span>\n            </div>\n\n            <div\n              className={`p-4 rounded-2xl border text-xs sm:text-sm leading-relaxed whitespace-pre-line font-normal transition-all ${\n                isWeiss\n                  ? \'bg-white/80 border-slate-200 text-slate-800\'\n                  : \'bg-white/5 border-white/10 text-slate-200\'\n              }`}\n            >\n              {currentChapter.text}\n            </div>\n\n            <div className=\"mt-4 flex items-center justify-between text-xs text-slate-500 font-mono\">\n              <span>Tipp: Klicke auf \'Play\', um die Erkl\303\244rung laut vorzulesen.</span>\n              <button\n                onClick={() => {\n                  navigator.clipboard.writeText(\n                    AUDIO_EXPLANATION_CHAPTERS.map((c) => `# ${c.title}\\n\\n${c.text}`).join(\'\\n\\n---\\n\\n\')\n                  );\n                }}\n                className=\"hover:text-indigo-600 dark:hover:text-cyan-300 underline cursor-pointer\"\n              >\n                Volltext kopieren\n              </button>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    num_lines: 454
    num_bytes: 17286
  }
}
