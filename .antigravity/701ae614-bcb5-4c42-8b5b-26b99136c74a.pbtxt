        target_content: "/* Water Droplet overlay shimmer */\n.steamy-droplets {\n  background-image: radial-gradient(rgba(255, 255, 255, 0.3) 1px, transparent 1px),\n    radial-gradient(rgba(255, 255, 255, 0.18) 1.5px, transparent 1.5px);\n  background-size: 32px 32px, 48px 48px;\n  background-position: 0 0, 16px 24px;\n}"
        replacement_content: "/* Water Droplet overlay shimmer */\n.steamy-droplets {\n  background-image: radial-gradient(rgba(255, 255, 255, 0.3) 1px, transparent 1px),\n    radial-gradient(rgba(255, 255, 255, 0.18) 1.5px, transparent 1.5px);\n  background-size: 32px 32px, 48px 48px;\n  background-position: 0 0, 16px 24px;\n}\n\n/* Futuristic Telemetry Shimmer & Sparkle Keyframes */\n@keyframes telemetryShimmer {\n  0% {\n    transform: translateY(-120%) translateX(-120%) rotate(25deg);\n  }\n  100% {\n    transform: translateY(120%) translateX(120%) rotate(25deg);\n  }\n}\n\n@keyframes telemetrySparkleSpin {\n  0% {\n    transform: scale(0.2) rotate(0deg);\n    filter: drop-shadow(0 0 2px currentColor);\n  }\n  50% {\n    transform: scale(1.3) rotate(90deg);\n    filter: drop-shadow(0 0 10px currentColor) brightness(1.4);\n  }\n  100% {\n    transform: scale(1) rotate(180deg);\n    filter: drop-shadow(0 0 5px currentColor);\n  }\n}\n\n.animate-telemetry-shimmer {\n  animation: telemetryShimmer 1.1s cubic-bezier(0.2, 0.8, 0.25, 1) forwards;\n}\n\n.animate-telemetry-sparkle-spin {\n  animation: telemetrySparkleSpin 0.75s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;\n}\n\n/* Enhanced telemetry tile hover physics */\n.glass-telemetry-hover {\n  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;\n}\n\n.glass-telemetry-hover:hover {\n  transform: translateY(-2.5px) scale(1.008);\n}\n"
      }
      num_matches: 1
    }
  }
}
