        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "# 14 Reciprocal Rank Fusion (RRF)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "RRF l\303\266st das Kernproblem hybrider Suchen: **Wie kombiniert man unvergleichbare Punktwerte?**"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Formel"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "$$\\\\text{RRF\\\\_Score}(d) = \\\\sum_{m \\\\in M} \\\\frac{w_m}{k + r_m(d)}$$"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Wobei:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- $M$: Menge der Suchsysteme (FTS5 BM25, sqlite-vec Cosine KNN)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- $r_m(d)$: Rang des Dokuments $d$ im System $m$ (1-basiert)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- $k$: Gl\303\244ttungskonstante (Standard: 60)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- $w_m$: Gewicht des Systems (Standard: 1.0)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Warum $k=60$?"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "$k=60$ stammt aus der Originalarbeit von Cormack, Clarke & B\303\274ttcher (SIGIR 2009). Es verhindert, dass Ausrei\303\237er auf Platz 1 eines einzelnen Systems das Gesamtranking dominieren, und belohnt Chunks, die in **beiden** Systemen unter den Top 20 landen.`,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
