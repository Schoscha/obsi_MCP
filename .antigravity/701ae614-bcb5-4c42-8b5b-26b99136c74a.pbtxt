      replacement_content: "  Sparkles,\n  ListTodo,\n  Headphones,\n} from \'lucide-react\';\n\ninterface Props {\n  themeMode: \'weiss\' | \'bunt\';\n  setThemeMode: (mode: \'weiss\' | \'bunt\') => void;\n  onOpenChecklist: () => void;\n  onOpenSimulator: () => void;\n  onOpenGraph: () => void;\n  onOpenAnalysis: () => void;\n  onOpenAudio: () => void;\n  onNewNote: () => void;\n  onDailyNote: () => void;\n}\n\nexport const GlassBottomBar = ({\n  themeMode,\n  setThemeMode,\n  onOpenChecklist,\n  onOpenSimulator,\n  onOpenGraph,\n  onOpenAnalysis,\n  onOpenAudio,\n  onNewNote,\n  onDailyNote,\n}: Props) => {\n  const isWeiss = themeMode === \'weiss\';\n\n  return (\n    <div className=\"fixed bottom-4 inset-x-0 z-40 flex justify-center px-4 pointer-events-none\">\n      <div\n        className={`pointer-events-auto rounded-full py-2 px-3 sm:px-5 flex flex-wrap items-center justify-center gap-1.5 sm:gap-3 glass-rainbow-edge shadow-2xl transition-all duration-300 ${\n          isWeiss ? \'glass-white text-slate-800\' : \'glass-bunt text-slate-100\'\n        }`}\n      >\n        {/* Audio Player Button */}\n        <button\n          onClick={onOpenAudio}\n          className={`px-3.5 py-1.5 rounded-full text-xs font-semibold flex items-center gap-2 transition-all cursor-pointer ${\n            isWeiss\n              ? \'bg-gradient-to-r from-indigo-500 to-purple-600 text-white shadow-md hover:scale-105\'\n              : \'bg-gradient-to-r from-cyan-400 to-fuchsia-500 text-slate-950 font-bold shadow-lg hover:scale-105\'\n          }`}\n          title=\"Audio-Erkl\303\244rung anh\303\266ren\"\n        >\n          <Headphones className=\"w-3.5 h-3.5\" />\n          <span>Audio</span>\n        </button>\n\n        {/* Neue Notiz */}"
