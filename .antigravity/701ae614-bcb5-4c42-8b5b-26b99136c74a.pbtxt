    web_documents {
      url: "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQGZCDPIh3uZ4CDcsXNg3i-SAnabfYWIigosK2vm0fbgU5B0dFB2IAtXlrTwayJbxahhRdVzqz6DQGW8ghQU86G36DNa9bL_L46kTETWi-JjpgTRebW4R3VGdC2zcJ49C44RsaoiQ_Q="
      title: "github.com"
