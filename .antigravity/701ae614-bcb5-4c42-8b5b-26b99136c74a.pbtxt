nClose={() => setIsNewsOpen(false)}\n        themeMode={themeMode}\n      />\n    </div>"
        replacement_content: "      {/* Floating Horizontal Glass Bottom Bar */}\n      <GlassBottomBar\n        themeMode={themeMode}\n        setThemeMode={setThemeMode}\n        onOpenChecklist={() => setIsChecklistOpen(true)}\n        onOpenSimulator={() => setIsSimulatorOpen(true)}\n        onOpenGraph={() => setIsGraphOpen(true)}\n        onOpenAnalysis={() => setIsAnalysisOpen(true)}\n        onOpenAudio={() => setIsAudioPlayerOpen(true)}\n        onNewNote={handleCreateNewNote}\n        onDailyNote={handleCreateDailyNote}\n      />\n\n      {/* Full 32-Chapter Task Checklist Modal */}\n      <GlassChecklistModal\n        isOpen={isChecklistOpen}\n        onClose={() => setIsChecklistOpen(false)}\n        tasks={tasks}\n        onToggleTask={handleToggleTask}\n        onBatchTogglePhase={handleBatchTogglePhase}\n        themeMode={themeMode}\n      />\n\n      {/* RRF Simulator & Hybrid Search Modal */}\n      <GlassSimulatorModal\n        isOpen={isSimulatorOpen}\n        onClose={() => setIsSimulatorOpen(false)}\n        themeMode={themeMode}\n      />\n\n      {/* Interactive Obsidian Markdown Note Reader & Editor */}\n      <GlassNoteModal\n        isOpen={isNoteModalOpen}\n        onClose={() => setIsNoteModalOpen(false)}\n        note={selectedNote}\n        onSaveNote={handleSaveNote}\n        themeMode={themeMode}\n      />\n\n      {/* Interactive Obsidian 2D Graph View Modal */}\n      <GlassGraphModal\n        isOpen={isGraphOpen}\n        onClose={() => setIsGraphOpen(false)}\n        themeMode={themeMode}\n        onSelectNode={(nodeName) => {\n          showNotification(`Knoten im Graph fokussiert: ${nodeName}`);\n        }}\n      />\n\n      {/* Full Concept & Sinnhaftigkeit Analysis Modal */}\n      <GlassAnalysisModal\n        isOpen={isAnalysisOpen}\n        onClose={() => setIsAnalysisOpen(false)}\n        themeMode={themeMode}\n        onOpenChecklist={() => setIsChecklistOpen(true)}\n        onOpenAudio={() => setIsAudioPlayerOpen(true)}