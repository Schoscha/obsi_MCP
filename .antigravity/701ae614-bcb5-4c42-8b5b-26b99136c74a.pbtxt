  file_change {
    absolute_path_uri: "file:///src/components/GlassChecklistModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { useState } from \'react\';\nimport { TaskItem } from \'../data/tasksData\';\nimport {\n  X,\n  CheckCircle2,\n  Circle,\n  Search,\n  Download,\n  Filter,\n  Code,\n  FileText,\n  ChevronDown,\n  ChevronUp,\n  RotateCcw,\n  Sparkles,\n} from \'lucide-react\';\n\ninterface Props {\n  isOpen: boolean;\n  onClose: () => void;\n  tasks: TaskItem[];\n  onToggleTask: (id: string) => void;\n  onBatchTogglePhase: (phase: string, completed: boolean) => void;\n  themeMode: \'weiss\' | \'bunt\';\n}\n\nexport const GlassChecklistModal = ({\n  isOpen,\n  onClose,\n  tasks,\n  onToggleTask,\n  onBatchTogglePhase,\n  themeMode,\n}: Props) => {\n  if (!isOpen) return null;\n\n  const isWeiss = themeMode === \'weiss\';\n  const [searchQuery, setSearchQuery] = useState(\'\');\n  const [selectedPhase, setSelectedPhase] = useState(\'Alle\');\n  const [expandedTaskId, setExpandedTaskId] = useState<string | null>(null);\n\n  const phases = [\'Alle\', ...Array.from(new Set(tasks.map((t) => t.phase)))];\n\n  const filteredTasks = tasks.filter((task) => {\n    const matchesPhase = selectedPhase === \'Alle\' || task.phase === selectedPhase;\n    const matchesSearch =\n      task.title.toLowerCase().includes(searchQuery.toLowerCase()) ||\n      task.description.toLowerCase().includes(searchQuery.toLowerCase()) ||\n      task.fileName.toLowerCase().includes(searchQuery.toLowerCase()) ||\n      task.chapter.includes(searchQuery);\n    return matchesPhase && matchesSearch;\n  });\n\n  const completedCount = tasks.filter((t) => t.completed).length;\n  const progressPercent = Math.round((completedCount / tasks.length) * 100);\n\n  const handleExportMarkdown = () => {\n    let md = `# Obsidian MCP + Hybrid Retrieval 2026 - Master Taskliste\\n\\n`;\n    md += `*Generiert aus dem Obsidian Cockpit | Fortschritt: ${completedCount}/${tasks.length} (${progressPercent}%)*\\n\\n`;\n\n    phases\n      .filter((p) => p !== \'Alle\')\n      .forEach((phase) => {\n        md += `## ${phase}\\n\\n`;\n        tasks\n          .filter((t) => t.phase === phase)\n          .forEach((task) => {\n            const check = task.completed ? \'[x]\' : \'[ ]\';\n            md += `- ${check} **Kapitel ${task.chapter}: ${task.title}** (\\`${task.fileName}\\`)\\n`;\n            md += `  - Priorit\303\244t: ${task.priority} | Ebene: ${task.level}\\n`;\n            md += `  - ${task.description}\\n`;\n            task.deliverables.forEach((d) => {\n              md += `    - [ ] ${d}\\n`;\n            });\n            md += `\\n`;\n          });\n      });\n\n    const blob = new Blob([md], { type: \'text/markdown;charset=utf-8\' });\n    const url = URL.createObjectURL(blob);\n    const link = document.createElement(\'a\');\n    link.href = url;\n    link.download = \'Obsidian-MCP-Hybrid-Tasks-2026.md\';\n    link.click();\n    URL.revokeObjectURL(url);\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-6 bg-black/40 backdrop-blur-md animate-in fade-in duration-200\">\n      <div\n        className={`w-full max-w-5xl max-h-[90vh] rounded-3xl flex flex-col glass-rainbow-edge overflow-hidden shadow-2xl transition-all duration-300 ${\n          isWeiss ? \'glass-white text-slate-800\' : \'glass-bunt text-slate-100\'\n        }`}\n      >\n        {/* Modal Header */}\n        <div className=\"p-4 sm:p-6 border-b border-slate-300/40 flex items-center justify-between gap-4\">\n          <div>\n            <div className=\"flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-indigo-600 dark:text-cyan-300\">\n              <Sparkles className=\"w-4 h-4\" />\n              <span>Blake Crosley 2026 Referenz</span>\n            </div>\n            <h2 className=\"text-lg sm:text-xl font-bold font-display text-slate-900 dark:text-white mt-0.5\">\n              32-Kapitel Master-Taskliste zum Abhaken\n            </h2>\n          </div>\n\n          <div className=\"flex items-center gap-2\">\n            <button\n              onClick={handleExportMarkdown}\n              className={`px-3 py-1.5 rounded-xl text-xs font-semibold flex items-center gap-1.5 transition-all cursor-pointer ${\n                isWeiss\n                  ? \'bg-indigo-600 text-white hover:bg-indigo-700 shadow-sm\'\n                  : \'bg-cyan-500 text-slate-950 hover:bg-cyan-400 font-bold shadow-md\'\n              }`}\n              title=\"Als Markdown f\303\274r Obsidian exportieren\"\n            >\n              <Download className=\"w-3.5 h-3.5\" />\n              <span className=\"hidden sm:inline\">Export als .md</span>\n            </button>\n\n            <button\n              onClick={onClose}\n              className={`p-2 rounded-full transition-all cursor-pointer ${\n                isWeiss ? \'hover:bg-slate-200 text-slate-700\' : \'hover:bg-white/20 text-slate-200\'\n              }`}\n            >\n              <X className=\"w-5 h-5\" />\n            </button>\n          </div>\n        </div>\n\n        {/* Progress Bar & Filter Bar */}\n        <div className=\"px-4 sm:px-6 py-3 border-b border-slate-300/40 space-y-3 bg-white/10\">\n          <div className=\"flex items-center justify-between text-xs font-medium\">\n            <span>\n              Fortschritt: <strong>{completedCount}</strong> von {tasks.length} Kapiteln ({progressPercent}%)\n            </span>\n            <span className=\"text-[11px] font-mono text-emerald-500 font-semibold\">\n              {tasks.filter((t) => t.priority === \'Kritisch\' && t.completed).length}/\n              {tasks.filter((t) => t.priority === \'Kritisch\').length} Kritische Tasks erledigt\n            </span>\n          </div>\n\n          <div className=\"w-full h-2 rounded-full bg-slate-300/40 overflow-hidden\">\n            <div\n              className={`h-full transition-all duration-500 rounded-full ${\n                isWeiss\n                  ? \'bg-gradient-to-r from-indigo-500 to-purple-600\'\n                  : \'bg-gradient-to-r from-cyan-400 via-fuchsia-500 to-amber-400\'\n              }`}\n              style={{ width: `${progressPercent}%` }}\n            />\n          </div>\n\n          {/* Search & Phase Pills */}\n          <div className=\"flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 pt-1\">\n            <div className=\"relative flex-1 max-w-sm\">\n              <Search className=\"w-3.5 h-3.5 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400\" />\n              <input\n                type=\"text\"\n                placeholder=\"Kapitel, Datei oder Code durchsuchen...\"\n                value={searchQuery}\n                onChange={(e) => setSearchQuery(e.target.value)}\n                className={`w-full pl-8 pr-3 py-1.5 rounded-xl text-xs font-mono transition-all outline-none border ${\n                  isWeiss\n                    ? \'bg-white/90 border-slate-300 text-slate-900 focus:border-indigo-500\'\n                    : \'bg-black/30 border-white/20 text-white focus:border-cyan-400\'\n                }`}\n              />\n            </div>\n\n            <div className=\"flex items-center gap-1.5 overflow-x-auto pb-1 text-xs\">\n              {phases.map((phase) => (\n                <button\n                  key={phase}\n                  onClick={() => setSelectedPhase(phase)}\n                  className={`px-2.5 py-1 rounded-lg whitespace-nowrap transition-all cursor-pointer text-[11px] font-medium ${\n                    selectedPhase === phase\n                      ? isWeiss\n                        ? \'bg-white font-bold text-indigo-700 shadow-sm border border-indigo-200\'\n                        : \'bg-white/30 font-bold text-white shadow-md border border-cyan-400/60\'\n                      : isWeiss\n                      ? \'hover:bg-white/50 text-slate-600\'\n                      : \'hover:bg-white/10 text-slate-300\'\n                  }`}\n                >\n                  {phase}\n                </button>\n              ))}\n            </div>\n          </div>\n        </div>\n\n        {/* Tasks List Content */}\n        <div className=\"flex-1 overflow-y-auto p-4 sm:p-6 space-y-2.5\">\n          {filteredTasks.length === 0 ? (\n            <div className=\"text-center py-12 text-slate-500 text-xs\">\n              Keine Kapitel f\303\274r diese Suchkriterien gefunden.\n            </div>\n          ) : (\n            filteredTasks.map((task) => {\n              const isExpanded = expandedTaskId === task.id;\n              const isCritical = task.priority === \'Kritisch\';\n\n              return (\n                <div\n                  key={task.id}\n                  className={`rounded-2xl border transition-all duration-200 overflow-hidden ${\n                    task.completed\n                      ? isWeiss\n                        ? \'bg-emerald-50/60 border-emerald-300/60\'\n                        : \'bg-emerald-950/20 border-emerald-500/30\'\n                      : isWeiss\n                      ? \'bg-white/70 border-white hover:bg-white\'\n                      : \'bg-white/5 border-white/10 hover:bg-white/10\'\n                  }`}\n                >\n                  {/* Task Summary Row */}\n                  <div className=\"p-3 sm:p-4 flex items-start gap-3 cursor-pointer\">\n                    <button\n                      onClick={() => onToggleTask(task.id)}\n                      className=\"mt-0.5 text-slate-400 hover:text-emerald-500 transition-colors cursor-pointer shrink-0\"\n                    >\n                      {task.completed ? (\n                        <CheckCircle2 className=\"w-5 h-5 text-emerald-500\" />\n                      ) : (\n                        <Circle className=\"w-5 h-5\" />\n                      )}\n                    </button>\n\n                    <div\n                      className=\"flex-1 min-w-0\"\n                      onClick={() => setExpandedTaskId(isExpanded ? null : task.id)}\n                    >\n                      <div className=\"flex flex-wrap items-center gap-2\">\n                        <span className=\"text-xs font-mono font-bold text-indigo-600 dark:text-cyan-300\">\n                          Kapitel {task.chapter}\n                        </span>\n\n                        <span\n                          className={`text-[10px] px-2 py-0.5 rounded font-mono font-semibold ${\n                            isCritical\n                              ? \'bg-rose-500/20 text-rose-600 dark:text-rose-300 border border-rose-500/30\'\n                              : task.priority === \'Hoch\'\n                              ? \'bg-amber-500/20 text-amber-600 dark:text-amber-300 border border-amber-500/30\'\n                              : \'bg-slate-500/20 text-slate-600 dark:text-slate-300\'\n                          }`}\n                        >\n                          {task.priority}\n                        </span>\n\n                        <span\n                          className={`text-[10px] font-mono px-2 py-0.5 rounded ${\n                            isWeiss ? \'bg-slate-100 text-slate-600\' : \'bg-black/30 text-slate-400\'\n                          }`}\n                        >\n                          {task.fileName}\n                        </span>\n                      </div>\n\n                      <h3\n                        className={`text-sm font-semibold mt-1 ${\n                          task.completed ? \'line-through text-slate-500\' : \'\'\n                        }`}\n                      >\n                        {task.title}\n                      </h3>\n\n                      <p className=\"text-xs text-slate-600 dark:text-slate-300 mt-0.5 line-clamp-2\">\n                        {task.description}\n                      </p>\n                    </div>\n\n                    <button\n                      onClick={() => setExpandedTaskId(isExpanded ? null : task.id)}\n                      className=\"p-1 rounded text-slate-400 hover:text-slate-600 cursor-pointer shrink-0\"\n                    >\n                      {isExpanded ? <ChevronUp className=\"w-4 h-4\" /> : <ChevronDown className=\"w-4 h-4\" />}\n                    </button>\n                  </div>\n\n                  {/* Expanded Detail Drawer */}\n                  {isExpanded && (\n                    <div className=\"px-4 pb-4 pt-1 border-t border-slate-200/50 dark:border-white/10 space-y-3 text-xs\">\n                      <div>\n                        <div className=\"font-semibold text-[11px] uppercase tracking-wider text-slate-500 mb-1.5\">\n                          Liefergegenst\303\244nde & Schritte:\n                        </div>\n                        <ul className=\"space-y-1 pl-1\">\n                          {task.deliverables.map((item, idx) => (\n                            <li key={idx} className=\"flex items-start gap-2\">\n                              <span className=\"text-indigo-500 dark:text-cyan-400 font-bold\">\342\200\272</span>\n                              <span>{item}</span>\n                            </li>\n                          ))}\n                        </ul>\n                      </div>\n\n                      {task.codeSnippet && (\n                        <div>\n                          <div className=\"flex items-center gap-1.5 font-semibold text-[11px] uppercase tracking-wider text-slate-500 mb-1\">\n                            <Code className=\"w-3.5 h-3.5\" />\n                            <span>Referenz-Implementierung:</span>\n                          </div>\n                          <pre\n                            className={`p-3 rounded-xl font-mono-code text-[11px] overflow-x-auto border ${\n                              isWeiss\n                                ? \'bg-slate-900 text-slate-100 border-slate-700\'\n                                : \'bg-black/60 text-cyan-200 border-cyan-900/40\'\n                            }`}\n                          >\n                            <code>{task.codeSnippet}</code>\n                          </pre>\n                        </div>\n                      )}\n                    </div>\n                  )}\n                </div>\n              );\n            })\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
