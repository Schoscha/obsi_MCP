      replacement_content: "@import \"tailwindcss\";\n\n@layer base {\n  body {\n    font-family: \'Plus Jakarta Sans\', sans-serif;\n    background-color: #0b0914;\n    color: #e2e8f0;\n    overflow-x: hidden;\n  }\n}\n\n.font-display {\n  font-family: \'Syne\', sans-serif;\n}\n\n.font-mono-code {\n  font-family: \'JetBrains Mono\', monospace;\n  font-variant-numeric: tabular-nums;\n}\n\n/* Glassmorphic & Glowing HUD utilities matching reference */\n.hud-card {\n  background: linear-gradient(180deg, rgba(25, 20, 48, 0.85) 0%, rgba(14, 11, 28, 0.95) 100%);\n  border: 1px solid rgba(139, 92, 246, 0.22);\n  box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.45), inset 0 1px 1px 0 rgba(255, 255, 255, 0.08);\n  backdrop-filter: blur(12px);\n}\n\n.hud-card-orange {\n  background: linear-gradient(180deg, rgba(35, 22, 45, 0.85) 0%, rgba(18, 12, 28, 0.95) 100%);\n  border: 1px solid rgba(255, 123, 57, 0.3);\n  box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.45), inset 0 1px 1px 0 rgba(255, 165, 79, 0.15);\n  backdrop-filter: blur(12px);\n}\n\n.glow-orange {\n  filter: drop-shadow(0 0 8px rgba(255, 123, 57, 0.6));\n}\n\n.glow-cyan {\n  filter: drop-shadow(0 0 8px rgba(34, 211, 238, 0.6));\n}\n\n.glow-purple {\n  filter: drop-shadow(0 0 10px rgba(168, 85, 247, 0.5));\n}\n\n/* Custom scrollbar */\n::-webkit-scrollbar {\n  width: 6px;\n  height: 6px;\n}\n::-webkit-scrollbar-track {\n  background: #0d0a1a;\n}\n::-webkit-scrollbar-thumb {\n  background: #2a204d;\n  border-radius: 3px;\n}\n::-webkit-scrollbar-thumb:hover {\n  background: #ff772a;\n}\n"
    }
