    web_documents {
      url: "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQFbK_o6KgKGEk0GLo-peaEKQN1l_jHpasxmM-y1rmzgi9eoZp7lpItLThgnFck4xGi05o5izORlqANvIe2wRLPycWn5_YcMG4ybCfJC0Sp2oJBx-Z_s2eiIkDX3VTjJOwaTB7pLu-XW9H8="
