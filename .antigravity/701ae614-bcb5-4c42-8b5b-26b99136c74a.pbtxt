    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "@import \"tailwindcss\";\n\n@layer base {\n  body {\n    font-family: \'Plus Jakarta Sans\', sans-serif;\n    background-color: #0b0914;\n    color: #e2e8f0;\n    overflow-x: hidden;\n  }\n}\n\n.font-display {\n  font-family: \'Syne\', sans-serif;\n}\n\n.font-mono-code {\n  font-family: \'JetBrains Mono\', monospace;\n  font-variant-numeric: tabular-nums;\n}\n\n/* Glassmorphic & Glowing HUD utilities matching reference */\n.hud-card {\n  background: linear-gradient(180deg, rgba(25, 20, 48, 0.85) 0%, rgba(14, 11, 28, 0.95) 100%);\n  border: 1px solid rgba(139, 92, 246, 0.22);\n  box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.45), inset 0 1px 1px 0 rgba(255, 255, 255, 0.08);\n  backdrop-filter: blur(12px);\n}\n\n.hud-card-orange {\n  background: linear-gradient(180deg, rgba(35, 22, 45, 0.85) 0%, rgba(18, 12, 28, 0.95) 100%);\n  border: 1px solid rgba(255, 123, 57, 0.3);\n  box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.45), inset 0 1px 1px 0 rgba(255, 165, 79, 0.15);\n  backdrop-filter: blur(12px);\n}\n\n.glow-orange {\n  filter: drop-shadow(0 0 8px rgba(255, 123, 57, 0.6));\n}\n\n.glow-cyan {\n  filter: drop-shadow(0 0 8px rgba(34, 211, 238, 0.6));\n}\n\n.glow-purple {\n  filter: drop-shadow(0 0 10px rgba(168, 85, 247, 0.5));\n}\n\n/* Custom scrollbar */\n::-webkit-scrollbar {\n  width: 6px;\n  height: 6px;\n}\n::-webkit-scrollbar-track {\n  background: #0d0a1a;\n}\n::-webkit-scrollbar-thumb {\n  background: #2a204d;\n  border-radius: 3px;\n}\n::-webkit-scrollbar-thumb:hover {\n  background: #ff772a;\n}"
      replacement_content: "@import \"tailwindcss\";\n\n@layer base {\n  body {\n    font-family: \'Plus Jakarta Sans\', sans-serif;\n    overflow-x: hidden;\n  }\n}\n\n.font-display {\n  font-family: \'Syne\', sans-serif;\n}\n\n.font-mono-code {\n  font-family: \'JetBrains Mono\', monospace;\n  font-variant-numeric: tabular-nums;\n}\n\n/* 3D Glassmorphism - Weiss (Pure Ice & Frosted Crystal Glass) */\n.glass-white {\n  background: linear-gradient(\n    135deg,\n    rgba(255, 255, 255, 0.72) 0%,\n    rgba(240, 245, 255, 0.55) 50%,\n    rgba(255, 255, 255, 0.65) 100%\n  );\n  backdrop-filter: blur(24px) saturate(180%);\n  -webkit-backdrop-filter: blur(24px) saturate(180%);\n  border: 1.5px solid rgba(255, 255, 255, 0.85);\n  box-shadow:\n    0 20px 50px rgba(0, 20, 60, 0.08),\n    0 4px 12px rgba(0, 0, 0, 0.04),\n    inset 0 2px 2px rgba(255, 255, 255, 0.95),\n    inset 0 -2px 4px rgba(0, 40, 100, 0.04);\n}\n\n/* 3D Glassmorphism - Bunt (Prismatic Holographic & Sunset Glass) */\n.glass-bunt {\n  background: linear-gradient(\n    135deg,\n    rgba(22, 16, 46, 0.65) 0%,\n    rgba(34, 20, 64, 0.5) 50%,\n    rgba(15, 10, 32, 0.75) 100%\n  );\n  backdrop-filter: blur(24px) saturate(200%);\n  -webkit-backdrop-filter: blur(24px) saturate(200%);\n  border: 1.5px solid rgba(255, 255, 255, 0.25);\n  box-shadow:\n    0 20px 50px rgba(0, 0, 0, 0.45),\n    0 0 25px rgba(34, 211, 238, 0.15),\n    0 0 35px rgba(217, 70, 239, 0.12),\n    inset 0 2px 3px rgba(255, 255, 255, 0.45),\n    inset 0 -2px 4px rgba(217, 70, 239, 0.2);\n}\n\n/* Prismatic Rainbow Edge Refraction (Like in the reference images) */\n.glass-rainbow-edge {\n  position: relative;\n}\n.glass-rainbow-edge::before {\n  content: \'\';\n  position: absolute;\n  inset: -1.5px;\n  border-radius: inherit;\n  padding: 1.5px;\n  background: linear-gradient(\n    125deg,\n    rgba(255, 255, 255, 0.9) 0%,\n    rgba(147, 197, 253, 0.8) 22%,\n    rgba(244, 114, 182, 0.8) 45%,\n    rgba(253, 224, 71, 0.7) 68%,\n    rgba(56, 189, 248, 0.9) 88%,\n    rgba(255, 255, 255, 0.95) 100%\n  );\n  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);\n  -webkit-mask-composite: xor;\n  mask-composite: exclude;\n  pointer-events: none;\n  opacity: 0.85;\n}\n\n/* 3D Glass Typography Effect (\"Guten Abend, Sascha\" style) */\n.glass-text-3d {\n  background: linear-gradient(\n    180deg,\n    rgba(255, 255, 255, 0.98) 0%,\n    rgba(240, 248, 255, 0.7) 45%,\n    rgba(200, 225, 255, 0.4) 75%,\n    rgba(255, 255, 255, 0.9) 100%\n  );\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  filter: drop-shadow(0 4px 12px rgba(0, 30, 80, 0.18))\n    drop-shadow(0 1px 2px rgba(255, 255, 255, 0.8));\n}\n\n.glass-text-3d-bunt {\n  background: linear-gradient(\n    180deg,\n    #ffffff 0%,\n    #e0e7ff 35%,\n    #a5f3fc 65%,\n    #fbcfe8 100%\n  );\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  filter: drop-shadow(0 0 15px rgba(56, 189, 248, 0.5))\n    drop-shadow(0 4px 20px rgba(168, 85, 247, 0.4));\n}\n\n/* Glass Pill Buttons */\n.glass-pill-white {\n  background: linear-gradient(180deg, rgba(255, 255, 255, 0.85) 0%, rgba(240, 245, 255, 0.6) 100%);\n  border: 1px solid rgba(255, 255, 255, 0.95);\n  box-shadow: 0 4px 14px rgba(0, 20, 60, 0.08), inset 0 1px 1px #fff;\n  backdrop-filter: blur(16px);\n}\n\n.glass-pill-bunt {\n  background: linear-gradient(180deg, rgba(255, 255, 255, 0.15) 0%, rgba(139, 92, 246, 0.2) 100%);\n  border: 1px solid rgba(255, 255, 255, 0.35);\n  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3), 0 0 12px rgba(34, 211, 238, 0.25), inset 0 1px 1px rgba(255, 255, 255, 0.5);\n  backdrop-filter: blur(16px);\n}\n\n/* Water Droplet overlay shimmer */\n.steamy-droplets {\n  background-image: radial-gradient(rgba(255, 255, 255, 0.3) 1px, transparent 1px),\n    radial-gradient(rgba(255, 255, 255, 0.18) 1.5px, transparent 1.5px);\n  background-size: 32px 32px, 48px 48px;\n  background-position: 0 0, 16px 24px;\n}\n"
    }
