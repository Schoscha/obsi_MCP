    content: "import { useState } from \'react\';\nimport { X, Cpu, Search, Sparkles, Sliders, Database, Layers } from \'lucide-react\';\n\ninterface Props {\n  isOpen: boolean;\n  onClose: () => void;\n  themeMode: \'weiss\' | \'bunt\';\n}\n\nexport const GlassSimulatorModal = ({ isOpen, onClose, themeMode }: Props) => {\n  if (!isOpen) return null;\n  const isWeiss = themeMode === \'weiss\';\n\n  const [kParam, setKParam] = useState(60);\n  const [bm25Weight, setBm25Weight] = useState(1.0);\n  const [vecWeight, setVecWeight] = useState(1.0);\n  const [testQuery, setTestQuery] = useState(\'OAuth Token Rotation\');\n\n  const sampleChunks = [\n    {\n      id: 1,\n      file: \'03-resources/security/oauth-rotation.md\',\n      section: \'## Token Rotation Strategy\',\n      bm25Rank: 1,\n      vecRank: 2,\n      text: \'Der Refresh-Token-Flow erfordert strikte Rotation. Bei jedem Austausch wird ein neuer Refresh-Token generiert...\',\n    },\n    {\n      id: 2,\n      file: \'01-projects/auth-service/session.md\',\n      section: \'## Session Expiry Handling\',\n      bm25Rank: 14,\n      vecRank: 1,\n      text: \'Behandlung abgelaufener Benutzersitzungen: Vor dem API-Aufruf pr\303\274ft der Client die JWT-G\303\274ltigkeit...\',\n    },\n    {\n      id: 3,\n      file: \'05-signals/security/token-storage.md\',\n      section: \'## Secure Storage\',\n      bm25Rank: 3,"
    raw_content: "import { useState } from \'react\';\nimport { X, Cpu, Search, Sparkles, Sliders, Database, Layers } from \'lucide-react\';\n\ninterface Props {\n  isOpen: boolean;\n  onClose: () => void;\n  themeMode: \'weiss\' | \'bunt\';\n}\n\nexport const GlassSimulatorModal = ({ isOpen, onClose, themeMode }: Props) => {\n  if (!isOpen) return null;\n  const isWeiss = themeMode === \'weiss\';\n\n  const [kParam, setKParam] = useState(60);\n  const [bm25Weight, setBm25Weight] = useState(1.0);\n  const [vecWeight, setVecWeight] = useState(1.0);\n  const [testQuery, setTestQuery] = useState(\'OAuth Token Rotation\');\n\n  const sampleChunks = [\n    {\n      id: 1,\n      file: \'03-resources/security/oauth-rotation.md\',\n      section: \'## Token Rotation Strategy\',\n      bm25Rank: 1,\n      vecRank: 2,\n      text: \'Der Refresh-Token-Flow erfordert strikte Rotation. Bei jedem Austausch wird ein neuer Refresh-Token generiert...\',\n    },\n    {\n      id: 2,\n      file: \'01-projects/auth-service/session.md\',\n      section: \'## Session Expiry Handling\',\n      bm25Rank: 14,\n      vecRank: 1,\n      text: \'Behandlung abgelaufener Benutzersitzungen: Vor dem API-Aufruf pr\303\274ft der Client die JWT-G\303\274ltigkeit...\',\n    },\n    {\n      id: 3,\n      file: \'05-signals/security/token-storage.md\',\n      section: \'## Secure Storage\',\n      bm25Rank: 3,\n      vecRank: 8,\n      text: \'Tokens niemals im LocalStorage speichern. Verwende stattdessen HttpOnly-Cookies mit SameSite=Strict...\',\n    },\n    {\n      id: 4,\n      file: \'05-signals/ai-tooling/mcp-auth.md\',\n      section: \'## MCP Authentication Jail\',\n      bm25Rank: null,\n      vecRank: 4,\n      text: \'Der MCP-Server l\303\244uft im lokalen STDIO-Modus. Externe Tokens m\303\274ssen vor der Kontextinjektion gefiltert werden...\',\n    },\n  ];\n\n  // Calculate RRF scores\n  const calculatedResults = sampleChunks\n    .map((chunk) => {\n      const bm25Score = chunk.bm25Rank ? bm25Weight / (kParam + chunk.bm25Rank) : 0;\n      const vecScore = chunk.vecRank ? vecWeight / (kParam + chunk.vecRank) : 0;\n      const totalScore = bm25Score + vecScore;\n      return {\n        ...chunk,\n        bm25Score,\n        vecScore,\n        totalScore,\n        inBoth: chunk.bm25Rank !== null && chunk.vecRank !== null,\n      };\n    })\n    .sort((a, b) => b.totalScore - a.totalScore);\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-6 bg-black/40 backdrop-blur-md animate-in fade-in duration-200\">\n      <div\n        className={`w-full max-w-4xl max-h-[90vh] rounded-3xl flex flex-col glass-rainbow-edge overflow-hidden shadow-2xl transition-all duration-300 ${\n          isWeiss ? \'glass-white text-slate-800\' : \'glass-bunt text-slate-100\'\n        }`}\n      >\n        {/* Header */}\n        <div className=\"p-4 sm:p-6 border-b border-slate-300/40 flex items-center justify-between\">\n          <div className=\"flex items-center gap-3\">\n            <div\n              className={`w-9 h-9 rounded-xl flex items-center justify-center ${\n                isWeiss ? \'bg-indigo-600 text-white\' : \'bg-cyan-500 text-slate-950 font-bold\'\n              }`}\n            >\n              <Cpu className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <h2 className=\"text-lg font-bold font-display text-slate-900 dark:text-white\">\n                RRF Simulator & Hybrides Ranking\n              </h2>\n              <p className=\"text-xs text-slate-600 dark:text-slate-300\">\n                Reciprocal Rank Fusion ($k={kParam}$) \302\267 SQLite FTS5 + sqlite-vec\n              </p>\n            </div>\n          </div>\n\n          <button\n            onClick={onClose}\n            className={`p-2 rounded-full transition-all cursor-pointer ${\n              isWeiss ? \'hover:bg-slate-200 text-slate-700\' : \'hover:bg-white/20 text-slate-200\'\n            }`}\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Controls & Sliders */}\n        <div className=\"p-4 sm:p-6 border-b border-slate-300/40 bg-white/10 space-y-4\">\n          <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs\">\n            <div>\n              <div className=\"flex justify-between font-semibold mb-1\">\n                <span>RRF Konstante (k):</span>\n                <span className=\"font-mono text-indigo-600 dark:text-cyan-300 font-bold\">{kParam}</span>\n              </div>\n              <input\n                type=\"range\"\n                min=\"10\"\n                max=\"120\"\n                value={kParam}\n                onChange={(e) => setKParam(Number(e.target.value))}\n                className=\"w-full accent-indigo-600 dark:accent-cyan-400 cursor-pointer\"\n              />\n              <div className=\"text-[10px] text-slate-500 mt-0.5\">Empfohlener Standard: k = 60</div>\n            </div>\n\n            <div>\n              <div className=\"flex justify-between font-semibold mb-1\">\n                <span>BM25 Gewichtung:</span>\n                <span className=\"font-mono text-amber-600 dark:text-amber-300 font-bold\">\n                  {bm25Weight.toFixed(1)}x\n                </span>\n              </div>\n              <input\n                type=\"range\"\n                min=\"0.1\"\n                max=\"2.0\"\n                step=\"0.1\"\n                value={bm25Weight}\n                onChange={(e) => setBm25Weight(Number(e.target.value))}\n                className=\"w-full accent-amber-500 cursor-pointer\"\n              />\n              <div className=\"text-[10px] text-slate-500 mt-0.5\">FTS5 Spaltengewichte (1.0)</div>\n            </div>\n\n            <div>\n              <div className=\"flex justify-between font-semibold mb-1\">\n                <span>Vektor Gewichtung:</span>\n                <span className=\"font-mono text-purple-600 dark:text-fuchsia-300 font-bold\">\n                  {vecWeight.toFixed(1)}x\n                </span>\n              </div>\n              <input\n                type=\"range\"\n                min=\"0.1\"\n                max=\"2.0\"\n                step=\"0.1\"\n                value={vecWeight}\n                onChange={(e) => setVecWeight(Number(e.target.value))}\n                className=\"w-full accent-purple-500 cursor-pointer\"\n              />\n              <div className=\"text-[10px] text-slate-500 mt-0.5\">Model2Vec 256d KNN (1.0)</div>\n            </div>\n          </div>\n        </div>\n\n        {/* Results Stream */}\n        <div className=\"flex-1 overflow-y-auto p-4 sm:p-6 space-y-3\">\n          <div className=\"text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2\">\n            Fused Retrieval Ranking (Dual-Source Priorisierung):\n          </div>\n\n          {calculatedResults.map((item, idx) => (\n            <div\n              key={item.id}\n              className={`p-3.5 rounded-2xl border transition-all ${\n                idx === 0\n                  ? isWeiss\n                    ? \'bg-indigo-50/80 border-indigo-300 shadow-md\'\n                    : \'bg-cyan-950/30 border-cyan-400/50 shadow-lg\'\n                  : isWeiss\n                  ? \'bg-white/80 border-white\'\n                  : \'bg-white/10 border-white/20\'\n              }`}\n            >\n              <div className=\"flex items-start justify-between gap-3\">\n                <div className=\"flex items-center gap-2 min-w-0\">\n                  <span\n                    className={`w-6 h-6 rounded-full flex items-center justify-center font-mono font-bold text-xs shrink-0 ${\n                      idx === 0\n                        ? \'bg-indigo-600 text-white dark:bg-cyan-400 dark:text-slate-950\'\n                        : \'bg-slate-200 dark:bg-white/20\'\n                    }`}\n                  >\n                    #{idx + 1}\n                  </span>\n\n                  <div className=\"min-w-0\">\n                    <div className=\"font-mono text-xs font-semibold truncate text-slate-900 dark:text-white\">\n                      {item.file}\n                    </div>\n                    <div className=\"text-[11px] text-slate-500\">{item.section}</div>\n                  </div>\n                </div>\n\n                <div className=\"text-right shrink-0\">\n                  <div className=\"font-mono text-xs font-bold text-emerald-600 dark:text-emerald-400\">\n                    Score: {item.totalScore.toFixed(4)}\n                  </div>\n                  {item.inBoth && (\n                    <span className=\"text-[10px] font-semibold text-indigo-600 dark:text-cyan-300\">\n                      \342\230\205 In beiden Ranglisten!\n                    </span>\n                  )}\n                </div>\n              </div>\n\n              <p className=\"text-xs text-slate-600 dark:text-slate-300 mt-2 font-mono-code bg-black/5 dark:bg-black/40 p-2 rounded-lg border border-slate-200/50 dark:border-white/10\">\n                {item.text}\n              </p>\n\n              <div className=\"flex items-center gap-4 mt-2 text-[11px] font-mono text-slate-500\">\n                <span>\n                  BM25 Rang:{\' \'}\n                  <strong className=\"text-amber-600 dark:text-amber-400\">\n                    {item.bm25Rank !== null ? `#${item.bm25Rank}` : \'Nicht gefunden\'}\n                  </strong>\n                </span>\n                <span>\n                  Vektor Rang:{\' \'}\n                  <strong className=\"text-purple-600 dark:text-fuchsia-400\">\n                    {item.vecRank !== null ? `#${item.vecRank}` : \'Nicht gefunden\'}\n                  </strong>\n                </span>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    num_lines: 242
    num_bytes: 9478
  }
}
