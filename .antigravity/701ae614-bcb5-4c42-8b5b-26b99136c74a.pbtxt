    web_documents {
      url: "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQGQvgQ7B1_Qem8IZRBQTYMETtavFIeVdOw0lrfWWQeckdg4_eyhYL7LLyuQWwr5ZG_gZCqfwFZImYS9mB8AoxXc81jO9UzCuLzuXrmRyre0iHai7OPU9o7wruXWHr0oyz9nri4GAWImX_xnRZl__xFrye3G_GtnxbogcTKgpysnCinlDQnAAyRzlMQrinmJUcT8HpRrEnGXgQSXFOlZnNg="
