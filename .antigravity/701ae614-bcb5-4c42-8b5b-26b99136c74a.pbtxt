    replacement_infos {
      original_chunk {
        target_content: "export const GlassGraphModal = ({\n  isOpen,\n  onClose,\n  themeMode,\n  onSelectNode,\n}: Props) => {\n  if (!isOpen) return null;\n  const isWeiss = themeMode === \'weiss\';\n\n  const [nodes, setNodes] = useState<Node[]>(INITIAL_NODES);\n  const [draggedNodeId, setDraggedNodeId] = useState<string | null>(null);\n  const [selectedNode, setSelectedNode] = useState<Node | null>(nodes[0]);\n  const [zoom, setZoom] = useState(1);\n  const containerRef = useRef<HTMLDivElement>(null);\n\n  // Gentle physics simulation\n  useEffect(() => {\n    const timer = setInterval(() => {\n      setNodes((prev) =>\n        prev.map((node) => {\n          if (node.id === draggedNodeId) return node;\n\n          // gentle drift towards origin center\n          const cx = 270;\n          const cy = 240;\n          const dx = cx - node.x;\n          const dy = cy - node.y;\n\n          let vx = (node.vx + dx * 0.0003) * 0.94;\n          let vy = (node.vy + dy * 0.0003) * 0.94;\n\n          return {\n            ...node,\n            x: node.x + vx,\n            y: node.y + vy,\n            vx,\n            vy,\n          };\n        })\n      );\n    }, 50);\n\n    return () => clearInterval(timer);\n  }, [draggedNodeId]);"
        replacement_content: "export const GlassGraphModal = ({\n  isOpen,\n  onClose,\n  themeMode,\n  onSelectNode,\n}: Props) => {\n  const isWeiss = themeMode === \'weiss\';\n\n  const [nodes, setNodes] = useState<Node[]>(INITIAL_NODES);\n  const [draggedNodeId, setDraggedNodeId] = useState<string | null>(null);\n  const [selectedNode, setSelectedNode] = useState<Node | null>(nodes[0]);\n  const [zoom, setZoom] = useState(1);\n  const containerRef = useRef<HTMLDivElement>(null);\n\n  // Gentle physics simulation\n  useEffect(() => {\n    if (!isOpen) return;\n\n    const timer = setInterval(() => {\n      setNodes((prev) =>\n        prev.map((node) => {\n          if (node.id === draggedNodeId) return node;\n\n          // gentle drift towards origin center\n          const cx = 270;\n          const cy = 240;\n          const dx = cx - node.x;\n          const dy = cy - node.y;\n\n          let vx = (node.vx + dx * 0.0003) * 0.94;\n          let vy = (node.vy + dy * 0.0003) * 0.94;\n\n          return {\n            ...node,\n            x: node.x + vx,\n            y: node.y + vy,\n            vx,\n            vy,\n          };\n        })\n      );\n    }, 50);\n\n    return () => clearInterval(timer);\n  }, [draggedNodeId, isOpen]);\n\n  if (!isOpen) return null;"
      }
      num_matches: 1
    }
  }
}
