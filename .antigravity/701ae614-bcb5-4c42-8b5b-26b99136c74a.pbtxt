(() => {\\n    const timer = setInterval(() => {\\n      setNodes((prev) =>\\n        prev.map((node) => {\\n          if (node.id === draggedNodeId) return node;\\n\\n          // gentle drift towards origin center\\n          const cx = 270;\\n          const cy = 240;\\n          const dx = cx - node.x;\\n          const dy = cy - node.y;\\n\\n          let vx = (node.vx + dx * 0.0003) * 0.94;\\n          let vy = (node.vy + dy * 0.0003) * 0.94;\\n\\n          return {\\n            ...node,\\n            x: node.x + vx,\\n            y: node.y + vy,\\n            vx,\\n            vy,\\n          };\\n        })\\n      );\\n    }, 50);\\n\\n    return () => clearInterval(timer);\\n  }, [draggedNodeId]);\", \"TargetFile\":\"/src/components/GlassGraphModal.tsx\", \"toolAction\":\"Fixing hook order in GlassGraphModal\", \"toolSummary\":\"Move hooks before early return in GlassGraphModal\"}"
