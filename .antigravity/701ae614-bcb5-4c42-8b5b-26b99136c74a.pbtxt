  file_change {
    absolute_path_uri: "file:///src/components/GlassBottomBar.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import {\n  FilePlus,\n  CalendarDays,\n  Calendar,\n  Share2,\n  Search,\n  Sun,\n  Moon,\n  Sparkles,\n  ListTodo,\n} from \'lucide-react\';\n\ninterface Props {\n  themeMode: \'weiss\' | \'bunt\';\n  setThemeMode: (mode: \'weiss\' | \'bunt\') => void;\n  onOpenChecklist: () => void;\n  onOpenSimulator: () => void;\n  onNewNote: () => void;\n  onDailyNote: () => void;\n}\n\nexport const GlassBottomBar = ({\n  themeMode,\n  setThemeMode,\n  onOpenChecklist,\n  onOpenSimulator,\n  onNewNote,\n  onDailyNote,\n}: Props) => {\n  const isWeiss = themeMode === \'weiss\';\n\n  return (\n    <div className=\"fixed bottom-4 inset-x-0 z-40 flex justify-center px-4 pointer-events-none\">\n      <div\n        className={`pointer-events-auto rounded-full py-2 px-3 sm:px-5 flex flex-wrap items-center justify-center gap-1.5 sm:gap-3 glass-rainbow-edge shadow-2xl transition-all duration-300 ${\n          isWeiss ? \'glass-white text-slate-800\' : \'glass-bunt text-slate-100\'\n        }`}\n      >\n        {/* Neue Notiz */}\n        <button\n          onClick={onNewNote}\n          className={`px-3.5 py-1.5 rounded-full text-xs font-semibold flex items-center gap-2 transition-all cursor-pointer ${\n            isWeiss\n              ? \'glass-pill-white text-slate-800 hover:text-indigo-900 hover:scale-105\'\n              : \'glass-pill-bunt text-slate-100 hover:text-white hover:scale-105\'\n          }`}\n        >\n          <FilePlus className=\"w-3.5 h-3.5 text-indigo-500 dark:text-cyan-400\" />\n          <span className=\"hidden sm:inline\">Neue Notiz</span>\n        </button>\n\n        {/* Tagesnotiz */}\n        <button\n          onClick={onDailyNote}\n          className={`px-3.5 py-1.5 rounded-full text-xs font-semibold flex items-center gap-2 transition-all cursor-pointer ${\n            isWeiss\n              ? \'glass-pill-white text-slate-800 hover:text-indigo-900 hover:scale-105\'\n              : \'glass-pill-bunt text-slate-100 hover:text-white hover:scale-105\'\n          }`}\n        >\n          <CalendarDays className=\"w-3.5 h-3.5 text-amber-500\" />\n          <span className=\"hidden sm:inline\">Tagesnotiz</span>\n        </button>\n\n        {/* 32 Kapitel Taskliste */}\n        <button\n          onClick={onOpenChecklist}\n          className={`px-3.5 py-1.5 rounded-full text-xs font-semibold flex items-center gap-2 transition-all cursor-pointer ${\n            isWeiss\n              ? \'bg-indigo-600 text-white shadow-md hover:bg-indigo-700 hover:scale-105\'\n              : \'bg-gradient-to-r from-cyan-500 to-fuchsia-500 text-white shadow-lg hover:scale-105\'\n          }`}\n        >\n          <ListTodo className=\"w-3.5 h-3.5\" />\n          <span>32-Kapitel Checklist</span>\n        </button>\n\n        {/* Graph View */}\n        <button\n          onClick={onOpenSimulator}\n          className={`px-3.5 py-1.5 rounded-full text-xs font-semibold flex items-center gap-2 transition-all cursor-pointer ${\n            isWeiss\n              ? \'glass-pill-white text-slate-800 hover:text-indigo-900 hover:scale-105\'\n              : \'glass-pill-bunt text-slate-100 hover:text-white hover:scale-105\'\n          }`}\n        >\n          <Share2 className=\"w-3.5 h-3.5 text-emerald-500\" />\n          <span className=\"hidden sm:inline\">Graph</span>\n        </button>\n\n        {/* Suche (Hybrid) */}\n        <button\n          onClick={onOpenSimulator}\n          className={`px-3.5 py-1.5 rounded-full text-xs font-semibold flex items-center gap-2 transition-all cursor-pointer ${\n            isWeiss\n              ? \'glass-pill-white text-slate-800 hover:text-indigo-900 hover:scale-105\'\n              : \'glass-pill-bunt text-slate-100 hover:text-white hover:scale-105\'\n          }`}\n        >\n          <Search className=\"w-3.5 h-3.5 text-cyan-500\" />\n          <span className=\"hidden sm:inline\">Suche</span>\n        </button>\n\n        <div className={`h-5 w-px ${isWeiss ? \'bg-slate-300\' : \'bg-white/20\'}`} />\n\n        {/* THE MODE SWITCHER: BUNT VS. WEISS */}\n        <button\n          onClick={() => setThemeMode(isWeiss ? \'bunt\' : \'weiss\')}\n          className={`px-3.5 py-1.5 rounded-full text-xs font-bold flex items-center gap-2 transition-all cursor-pointer shadow-md ${\n            isWeiss\n              ? \'bg-gradient-to-r from-purple-600 to-pink-500 text-white hover:scale-105\'\n              : \'bg-white text-slate-900 hover:scale-105\'\n          }`}\n          title={isWeiss ? \'Zu BUNT (Holografisch & Sunset) wechseln\' : \'Zu WEISS (Kristall-Eis-Glas) wechseln\'}\n        >\n          {isWeiss ? (\n            <>\n              <Sparkles className=\"w-3.5 h-3.5 text-yellow-300 animate-spin\" />\n              <span>Modus: BUNT</span>\n            </>\n          ) : (\n            <>\n              <Sun className=\"w-3.5 h-3.5 text-amber-500\" />\n              <span>Modus: WEISS</span>\n            </>\n          )}\n        </button>\n      </div>\n    </div>\n  );\n};\n"
    }
