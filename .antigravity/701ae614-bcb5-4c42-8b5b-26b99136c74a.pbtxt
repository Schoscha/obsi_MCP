    absolute_path_uri: "file:///src/components/GlassGraphModal.tsx"
    start_line: 69
    end_line: 114
    content: "  const [zoom, setZoom] = useState(1);\n  const containerRef = useRef<HTMLDivElement>(null);\n\n  // Gentle physics simulation\n  useEffect(() => {\n    const timer = setInterval(() => {\n      setNodes((prev) =>\n        prev.map((node) => {\n          if (node.id === draggedNodeId) return node;\n\n          // gentle drift towards origin center\n          const cx = 270;\n          const cy = 240;\n          const dx = cx - node.x;\n          const dy = cy - node.y;\n\n          let vx = (node.vx + dx * 0.0003) * 0.94;\n          let vy = (node.vy + dy * 0.0003) * 0.94;\n\n          return {\n            ...node,\n            x: node.x + vx,\n            y: node.y + vy,\n            vx,\n            vy,\n          };\n        })\n      );\n    }, 50);\n\n    return () => clearInterval(timer);\n  }, [draggedNodeId]);\n\n  const handlePointerDown = (id: string) => {\n    setDraggedNodeId(id);\n    const n = nodes.find((item) => item.id === id);\n    if (n) setSelectedNode(n);\n  };\n\n  const handlePointerMove = (e: React.PointerEvent) => {\n    if (!draggedNodeId || !containerRef.current) return;\n    const rect = containerRef.current.getBoundingClientRect();\n    const x = (e.clientX - rect.left) / zoom;\n    const y = (e.clientY - rect.top) / zoom;\n\n    setNodes((prev) =>"
    raw_content: "import { useState, useRef, useEffect } from \'react\';\nimport { X, Share2, ZoomIn, ZoomOut, RotateCcw, Filter, Sparkles } from \'lucide-react\';\n\ninterface Props {\n  isOpen: boolean;\n  onClose: () => void;\n  themeMode: \'weiss\' | \'bunt\';\n  onSelectNode?: (name: string) => void;\n}\n\ninterface Node {\n  id: string;\n  name: string;\n  group: \'mcp\' | \'retrieval\' | \'vault\' | \'agent\' | \'model\';\n  x: number;\n  y: number;\n  vx: number;\n  vy: number;\n  radius: number;\n}\n\ninterface Link {\n  source: string;\n  target: string;\n}\n\nconst INITIAL_NODES: Node[] = [\n  { id: \'1\', name: \'Obsidian Vault\', group: \'vault\', x: 250, y: 220, vx: 0, vy: 0, radius: 24 },\n  { id: \'2\', name: \'SQLite FTS5 (BM25)\', group: \'retrieval\', x: 140, y: 130, vx: 0, vy: 0, radius: 18 },\n  { id: \'3\', name: \'sqlite-vec (KNN)\', group: \'retrieval\', x: 360, y: 130, vx: 0, vy: 0, radius: 18 },\n  { id: \'4\', name: \'Model2Vec (256d)\', group: \'model\', x: 440, y: 80, vx: 0, vy: 0, radius: 16 },\n  { id: \'5\', name: \'Reciprocal Rank Fusion\', group: \'retrieval\', x: 250, y: 90, vx: 0, vy: 0, radius: 20 },\n  { id: \'6\', name: \'Obsidian MCP Server\', group: \'mcp\', x: 250, y: 340, vx: 0, vy: 0, radius: 22 },\n  { id: \'7\', name: \'Claude Code CLI\', group: \'agent\', x: 130, y: 410, vx: 0, vy: 0, radius: 18 },\n  { id: \'8\', name: \'UserPromptSubmit Hook\', group: \'agent\', x: 370, y: 410, vx: 0, vy: 0, radius: 16 },\n  { id: \'9\', name: \'01-projects (PARA)\', group: \'vault\', x: 100, y: 250, vx: 0, vy: 0, radius: 14 },\n  { id: \'10\', name: \'03-resources (MOC)\', group: \'vault\', x: 400, y: 250, vx: 0, vy: 0, radius: 14 },\n  { id: \'11\', name: \'05-signals (12 Dom)\', group: \'vault\', x: 160, y: 30, vx: 0, vy: 0, radius: 14 },\n  { id: \'12\', name: \'.indexignore\', group: \'vault\', x: 80, y: 180, vx: 0, vy: 0, radius: 13 },\n];\n\nconst INITIAL_LINKS: Link[] = [\n  { source: \'1\', target: \'2\' },\n  { source: \'1\', target: \'3\' },\n  { source: \'2\', target: \'5\' },\n  { source: \'3\', target: \'5\' },\n  { source: \'4\', target: \'3\' },\n  { source: \'1\', target: \'6\' },\n  { source: \'6\', target: \'7\' },\n  { source: \'7\', target: \'8\' },\n  { source: \'8\', target: \'5\' },\n  { source: \'1\', target: \'9\' },\n  { source: \'1\', target: \'10\' },\n  { source: \'1\', target: \'11\' },\n  { source: \'1\', target: \'12\' },\n];\n\nexport const GlassGraphModal = ({\n  isOpen,\n  onClose,\n  themeMode,\n  onSelectNode,\n}: Props) => {\n  if (!isOpen) return null;\n  const isWeiss = themeMode === \'weiss\';\n\n  const [nodes, setNodes] = useState<Node[]>(INITIAL_NODES);\n  const [draggedNodeId, setDraggedNodeId] = useState<string | null>(null);\n  const [selectedNode, setSelectedNode] = useState<Node | null>(nodes[0]);\n  const [zoom, setZoom] = useState(1);\n  const containerRef = useRef<HTMLDivElement>(null);\n\n  // Gentle physics simulation\n  useEffect(() => {\n    const timer = setInterval(() => {\n      setNodes((prev) =>\n        prev.map((node) => {\n          if (node.id === draggedNodeId) return node;\n\n          // gentle drift towards origin center\n          const cx = 270;\n          const cy = 240;\n          const dx = cx - node.x;\n          const dy = cy - node.y;\n\n          let vx = (node.vx + dx * 0.0003) * 0.94;\n          let vy = (node.vy + dy * 0.0003) * 0.94;\n\n          return {\n            ...node,\n            x: node.x + vx,\n            y: node.y + vy,\n            vx,\n            vy,\n          };\n        })\n      );\n    }, 50);\n\n    return () => clearInterval(timer);\n  }, [draggedNodeId]);\n\n  const handlePointerDown = (id: string) => {\n    setDraggedNodeId(id);\n    const n = nodes.find((item) => item.id === id);\n    if (n) setSelectedNode(n);\n  };\n\n  const handlePointerMove = (e: React.PointerEvent) => {\n    if (!draggedNodeId || !containerRef.current) return;\n    const rect = containerRef.current.getBoundingClientRect();\n    const x = (e.clientX - rect.left) / zoom;\n    const y = (e.clientY - rect.top) / zoom;\n\n    setNodes((prev) =>\n      prev.map((n) => (n.id === draggedNodeId ? { ...n, x, y, vx: 0, vy: 0 } : n))\n    );\n  };\n\n  const handlePointerUp = () => {\n    setDraggedNodeId(null);\n  };\n\n  const getNodeColor = (group: Node[\'group\']) => {\n    switch (group) {\n      case \'vault\':\n        return isWeiss ? \'#6366f1\' : \'#a855f7\';\n      case \'retrieval\':\n        return isWeiss ? \'#0284c7\' : \'#06b6d4\';\n      case \'model\':\n        return isWeiss ? \'#d97706\' : \'#f59e0b\';\n      case \'mcp\':\n        return isWeiss ? \'#059669\' : \'#10b981\';\n      case \'agent\':\n        return isWeiss ? \'#e11d48\' : \'#f43f5e\';\n    }\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-6 bg-black/45 backdrop-blur-md animate-in fade-in duration-200\">\n      <div\n        className={`w-full max-w-5xl max-h-[92vh] rounded-3xl flex flex-col glass-rainbow-edge overflow-hidden shadow-2xl transition-all duration-300 ${\n          isWeiss ? \'glass-white text-slate-800\' : \'glass-bunt text-slate-100\'\n        }`}\n      >\n        {/* Header */}\n        <div className=\"p-4 sm:p-6 border-b border-slate-300/40 flex items-center justify-between\">\n          <div className=\"flex items-center gap-3\">\n            <div\n              className={`w-9 h-9 rounded-xl flex items-center justify-center ${\n                isWeiss ? \'bg-indigo-600 text-white\' : \'bg-cyan-400 text-slate-950 font-bold\'\n              }`}\n            >\n              <Share2 className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <h2 className=\"text-lg font-bold font-display text-slate-900 dark:text-white\">\n                Obsidian Graph View\n              </h2>\n              <p className=\"text-xs text-slate-600 dark:text-slate-300\">\n                Interaktives Wissensnetz \302\267 12 Kernknoten \302\267 Hybrides Retrieval & MCP\n              </p>\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-2\">\n            <div className=\"flex items-center bg-white/20 rounded-xl p-1 gap-1\">\n              <button\n                onClick={() => setZoom((z) => Math.min(z + 0.15, 1.8))}\n                className=\"p-1.5 rounded-lg hover:bg-white/30 transition-colors\"\n                title=\"Zoom In\"\n              >\n                <ZoomIn className=\"w-4 h-4\" />\n              </button>\n              <button\n                onClick={() => setZoom((z) => Math.max(z - 0.15, 0.6))}\n                className=\"p-1.5 rounded-lg hover:bg-white/30 transition-colors\"\n                title=\"Zoom Out\"\n              >\n                <ZoomOut className=\"w-4 h-4\" />\n              </button>\n              <button\n                onClick={() => {\n                  setZoom(1);\n                  setNodes(INITIAL_NODES);\n                }}\n                className=\"p-1.5 rounded-lg hover:bg-white/30 transition-colors\"\n                title=\"Reset\"\n              >\n                <RotateCcw className=\"w-4 h-4\" />\n              </button>\n            </div>\n\n            <button\n              onClick={onClose}\n              className={`p-2 rounded-full transition-all cursor-pointer ${\n                isWeiss ? \'hover:bg-slate-200 text-slate-700\' : \'hover:bg-white/20 text-slate-200\'\n              }`}\n            >\n              <X className=\"w-5 h-5\" />\n            </button>\n          </div>\n        </div>\n\n        {/* Canvas & Sidebar */}\n        <div className=\"flex-1 flex flex-col md:flex-row overflow-hidden relative\">\n          <div\n            ref={containerRef}\n            onPointerMove={handlePointerMove}\n            onPointerUp={handlePointerUp}\n            className=\"flex-1 h-[450px] md:h-auto min-h-[420px] relative overflow-hidden select-none cursor-grab active:cursor-grabbing bg-slate-950/10 dark:bg-black/40\"\n          >\n            <svg\n              className=\"w-full h-full\"\n              style={{ transform: `scale(${zoom})`, transformOrigin: \'center center\' }}\n              viewBox=\"0 0 540 480\"\n            >\n              {/* Links */}\n              {INITIAL_LINKS.map((link, idx) => {\n                const s = nodes.find((n) => n.id === link.source);\n                const t = nodes.find((n) => n.id === link.target);\n                if (!s || !t) return null;\n\n                const isConnected =\n                  selectedNode && (selectedNode.id === s.id || selectedNode.id === t.id);\n\n                return (\n                  <line\n                    key={idx}\n                    x1={s.x}\n                    y1={s.y}\n                    x2={t.x}\n                    y2={t.y}\n                    stroke={\n                      isConnected\n                        ? isWeiss\n                          ? \'#4f46e5\'\n                          : \'#22d3ee\'\n                        : isWeiss\n                        ? \'rgba(148, 163, 184, 0.4)\'\n                        : \'rgba(255, 255, 255, 0.15)\'\n                    }\n                    strokeWidth={isConnected ? 2.2 : 1.2}\n                    strokeDasharray={isConnected ? \'none\' : \'4,2\'}\n                  />\n                );\n              })}\n\n              {/* Nodes */}\n              {nodes.map((node) => {\n                const isSelected = selectedNode?.id === node.id;\n                const color = getNodeColor(node.group);\n\n                return (\n                  <g\n                    key={node.id}\n                    transform={`translate(${node.x}, ${node.y})`}\n                    onPointerDown={() => handlePointerDown(node.id)}\n                    className=\"cursor-pointer\"\n                  >\n                    {/* Glow circle */}\n                    {isSelected && (\n                      <circle\n                        r={node.radius + 8}\n                        fill={color}\n                        opacity={0.3}\n                        className=\"animate-pulse\"\n                      />\n                    )}\n\n                    {/* Main node body */}\n                    <circle\n                      r={node.radius}\n                      fill={color}\n                      stroke={isSelected ? \'#ffffff\' : \'rgba(255, 255, 255, 0.6)\'}\n                      strokeWidth={isSelected ? 3 : 1.5}\n                      className=\"transition-transform hover:scale-110 drop-shadow-md\"\n                    />\n\n                    {/* Label */}\n                    <text\n                      y={node.radius + 14}\n                      textAnchor=\"middle\"\n                      className={`text-[10px] font-mono font-bold select-none pointer-events-none ${\n                        isWeiss ? \'fill-slate-800\' : \'fill-slate-100\'\n                      }`}\n                    >\n                      {node.name}\n                    </text>\n                  </g>\n                );\n              })}\n            </svg>\n          </div>\n\n          {/* Node Inspector Drawer */}\n          {selectedNode && (\n            <div\n              className={`w-full md:w-80 p-4 sm:p-5 border-t md:border-t-0 md:border-l border-slate-300/40 flex flex-col justify-between ${\n                isWeiss ? \'bg-white/40\' : \'bg-black/20\'\n              }`}\n            >\n              <div>\n                <div className=\"flex items-center gap-2 mb-2\">\n                  <span\n                    className=\"w-3 h-3 rounded-full\"\n                    style={{ backgroundColor: getNodeColor(selectedNode.group) }}\n                  />\n                  <span className=\"text-[11px] font-mono font-bold uppercase tracking-wider text-slate-500\">\n                    Gruppe: {selectedNode.group}\n                  </span>\n                </div>\n\n                <h3 className=\"text-base font-bold font-display text-slate-900 dark:text-white mb-2\">\n                  {selectedNode.name}\n                </h3>\n\n                <p className=\"text-xs text-slate-600 dark:text-slate-300 leading-relaxed mb-4\">\n                  {selectedNode.group === \'retrieval\' &&\n                    \'Kernkomponente des hybriden Retrieval-Pipelines. Verbindet Volltext- mit Vektorsuche unter Beachtung des Token-Budgets.\'}\n                  {selectedNode.group === \'vault\' &&\n                    \'Strukturierte Ordnerhierarchie im lokalen Markdown-Dateisystem mit .indexignore-Filtern.\'}\n                  {selectedNode.group === \'mcp\' &&\n                    \'Model Context Protocol Server f\303\274r direkten Dateisystemzugriff ohne laufende Obsidian GUI.\'}\n                  {selectedNode.group === \'agent\' &&\n                    \'Claude Code CLI Hooks injizieren automatisch relevante Vault-Snippets in den Prompt.\'}\n                  {selectedNode.group === \'model\' &&\n                    \'Ultraschnelles 30MB CPU-Embedding-Modell mit 256 Dimensionen ohne PyTorch-Abh\303\244ngigkeit.\'}\n                </p>\n\n                <div className=\"space-y-2 text-xs font-mono\">\n                  <div className=\"p-2.5 rounded-xl bg-white/30 dark:bg-white/5 border border-white/20 flex items-center justify-between\">\n                    <span className=\"text-slate-500\">Konnektivit\303\244t:</span>\n                    <span className=\"font-bold\">\n                      {\n                        INITIAL_LINKS.filter(\n                          (l) => l.source === selectedNode.id || l.target === selectedNode.id\n                        ).length\n                      }{\' \'}\n                      Verbindungen\n                    </span>\n                  </div>\n                </div>\n              </div>\n\n              <button\n                onClick={() => {\n                  if (onSelectNode) onSelectNode(selectedNode.name);\n                  onClose();\n                }}\n                className={`mt-4 w-full py-2 rounded-xl text-xs font-bold transition-all cursor-pointer ${\n                  isWeiss\n                    ? \'bg-indigo-600 hover:bg-indigo-700 text-white\'\n                    : \'bg-cyan-500 hover:bg-cyan-400 text-slate-950\'\n                }`}\n              >\n                In Notizen filtern\n              </button>\n            </div>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    num_lines: 366
    num_bytes: 13812
  }
}
