    tool_call {
      id: "call_100261"
      name: "create_file"
      arguments_json: "{\"Content\":\"export interface TaskItem {\\n  id: string;\\n  chapterNumber: number;\\n  filename: string;\\n  title: string;\\n  phase: \'Phase 1: Fundament & Vault\' | \'Phase 2: Indexierung & DB\' | \'Phase 3: Hybride Retrieval Engine\' | \'Phase 4: MCP Server & Protokoll\' | \'Phase 5: Agent-Integrationen\' | \'Phase 6: Intake, Caching & Graph\' | \'Phase 7: Tuning, Ops & Wartung\';\\n  priority: \'Kritisch\' | \'Hoch\' | \'Mittel\';\\n  summary: string;\\n  deliverables: string[];\\n  codeSnippets?: {\\n    language: string;\\n    description: string;\\n    code: string;\\n  }[];\\n  notesCountEstimate?: string;\\n  completed?: boolean;\\n}\\n\\nexport const CHAPTER_TASKS: TaskItem[] = [\\n  {\\n    id: \'ch-01\',\\n    chapterNumber: 1,\\n    filename: \'01 wichtigste-erkenntnisse.md\',\\n    title: \'Context Engineering & Leitprinzipien\',\\n    phase: \'Phase 1: Fundament & Vault\',\\n    priority: \'Kritisch\',\\n    summary: \'Grundsatz: Notizen sind Rohstoff, Retrieval-Infrastruktur ist das Produkt. 100% Local-First ohne API-Kosten und ohne Datenabfluss.\',\\n    deliverables: [\\n      \'Leitprinzip \\\"Context Engineering vor Notizanh\303\244ufung\\\" im Projektteam etablieren\',\\n      \'Architekturziel definieren: Sub-30ms Latenz, SQLite-Single-File-DB, null externe Cloud-Abh\303\244ngigkeiten\',\\n      \'Dualer Retrieval-Ansatz festlegen: BM25 (Exaktheit) + Vektor (Semantik) vereint durch Reciprocal Rank Fusion (RRF)\'\\n    ],\\n    codeSnippets: [\\n      {\\n        language: \'bash\',\\n        description: \'Retriever Test-Pipeline\',\\n        code: \'$ retriever search --hybrid \\\"oauth token rotation\\\"\\\\n# 16.894 Files, 49.746 Chunks in 23ms, 0 API calls\'\\n      }\\n    ]\\n  },\\n  {\\n    id: \'ch-02\',\\n    chapterNumber: 2,\\n    filename: \'02 so-verwenden-sie-diesen-leitfaden.md\',\\n    title: \'Rollen-Routing & Leitfaden-Struktur\',\\n    phase: \'Phase 1: Fundament & Vault\',\\n    priority: \'Mittel\',\\n    summary: \'Einstiegspfade je nach Vorwissen und Zielgruppe (Einsteiger, bestehende Vault-Besitzer, Systemingenieure, Enterprise).\',\\n    deliverables: [\\n      \'Eigenen Ziel-Pfad ausw\303\244hlen (z.B. Retrieval-System bauen vs. Claude Code anbinden)\',\\n      \'Konventionen pr\303\274fen: [Contract] (Konfigurationen), [Narrative] (Architektur), [Recipe] (Schritt-f\303\274r-Schritt)\'\\n    ]\\n  },\\n  {\\n    id: \'ch-03\',\\n    chapterNumber: 3,\\n    filename: \'03 warum-obsidian-f\303\274r-ai-infrastruktur.md\',\\n    title: \'Technologieentscheidung: Obsidian f\303\274r KI\',\\n    phase: \'Phase 1: Fundament & Vault\',\\n    priority: \'Hoch\',\\n    summary: \'Plaintext-Markdown, Local-First, bidirektionaler Wiki-Link-Graph und ein \303\226kosystem mit 2.500+ Plugins ohne Vendor-Lockin.\',\\n    deliverables: [\\n      \'Dateisystem als \\\"Source of Truth\\\" best\303\244tigen (Index ist stets fl\303\274chtig & neu generierbar)\',\\n      \'Datenschutz-Garantie sicherstellen: Medizin-, Finanz- und API-Daten verlassen den Rechner nie\',\\n      \'Trennung definieren: Was Obsidian liefert (Editor & Graph) vs. was die externe Pipeline liefert (FTS5 + Vektoren + MCP)\'\\n    ]\\n  },\\n  {\\n    id: \'ch-04\',\\n    chapterNumber: 4,\\n    filename: \'04 obsidian-mcp-einrichten.md\',\\n    title: \'Schnellstart: Obsidian MCP Server Setup\',\\n    phase: \'Phase 4: MCP Server & Protokoll\',\\n    priority: \'Kritisch\',\\n    summary: \'Verbindung des Vaults \303\274ber Model Context Protocol (MCP) in 5 Minuten mit Claude Code, Codex CLI und Cursor.\',\\n    deliverables: [\\n      \'Installation des verifizierten npm-Pakets `obsidian-mcp@2` (Achtung vor Namenskollision mit `obsidian-mcp-server`)\',\\n      \'Konfiguration in `~/.claude.json` (bzw. Projekt-`.mcp.json`) mit absolutem Vault-Pfad\',\\n      \'Testabfrage durchf\303\274hren: \\\"Search my Obsidian vault for notes about...\\\"\',\\n      \'Lese-Schreib-Grenzen pr\303\274fen: MCP liest (schreibgesch\303\274tzt), Intake schreibt via Hooks/CLI\'\\n    ],\\n    codeSnippets: [\\n      {\\n        language: \'bash\',\\n        description: \'Claude Code MCP Setup\',\\n        code: \'npm install -g obsidian-mcp\\\\nclaude mcp add obsidian -s user -- npx -y obsidian-mcp@2 serve --vault notes=/absolute/path/to/vault\'\\n      }\\n    ]\\n  },\\n  {\\n    id: \'ch-05\',\\n    chapterNumber: 5,\\n    filename: \'05 obsidian-cli-f\303\274r-ai-workflows.md\',\\n    title: \'Obsidian CLI (v1.12+) f\303\274r AI-Automatisierung\',\\n    phase: \'Phase 5: Agent-Integrationen\',\\n    priority: \'Hoch\',\\n    summary: \'Native Command Line Interface ab Obsidian 1.12 als GUI-Fernbedienung f\303\274r Scripting, Vorlagen und Eigenschaften.\',\\n    deliverables: [\\n      \'CLI in Obsidian aktivieren (Einstellungen > Allgemein > Command line interface)\',\\n      \'CLI-Befehle f\303\274r Intake-Automatisierung einrichten (`obsidian daily`, `obsidian file append`, `obsidian property set`)\',\\n      \'Klare Arbeitsteilung etablieren: CLI f\303\274r Intake/Vorlagen/Metadaten, MCP f\303\274r semantisches Hybrides Retrieval\'\\n    ],\\n    codeSnippets: [\\n      {\\n        language: \'bash\',\\n        description: \'T\303\244glicher Briefing Hook via CLI\',\\n        code: \'DATE=$(date +%Y-%m-%d)\\\\nobsidian daily\\\\nobsidian file append \\\"Daily Notes/${DATE}.md\\\" \\\"## AI Summary\\\\\\\\n${SUMMARY}\\\"\'\\n      }\\n    ]\\n  },\\n  {\\n    id: \'ch-06\',\\n    chapterNumber: 6,\\n    filename: \'06 obsidian-agent-plugins.md\',\\n    title: \'Eingebettete Agent-Plugins (Claudian & Agent Client)\',\\n    phase: \'Phase 5: Agent-Integrationen\',\\n    priority: \'Mittel\',\\n    summary: \'Sidebar-Assistenten direkt in Obsidian: Claudian (Claude Code) und Agent Client (Claude, Codex, Gemini CLI \303\274ber ACP).\',\\n    deliverables: [\\n      \'Vergleich durchf\303\274hren: Externes Terminal-MCP (Multi-Repo & Full Retrieval) vs. Sidebar-Plugin (Editor-Kontext)\',\\n      \'Claudian / Agent Client f\303\274r Schreib- und Revisions-Workflows evaluieren\',\\n      \'Berechtigungsmodi konfigurieren: YOLO vs. Safe vs. Plan-Modus mit Vault-Sicherheitsblockliste\'\\n    ]\\n  },\\n  {\\n    id: \'ch-07\',\\n    chapterNumber: 7,\\n    filename: \'07 entscheidungsrahmen-obsidian-vs.-alternativen.md\',\\n    title: \'Entscheidungsbaum & Skalierungsstufen\',\\n    phase: \'Phase 1: Fundament & Vault\',\\n    priority: \'Hoch\',\\n    summary: \'Wann gen\303\274gt eine einfache Ordnerstruktur, wann BM25 allein, und ab wann ist die volle hybride Retrieval-Pipeline zwingend?\',\\n    deliverables: [\\n      \'Vault-Gr\303\266\303\237e analysieren: <50 Notizen (Grep), 50-500 (BM25 FTS5), 500-5.000 (Vektor + RRF), 5.000+ (Full Pipeline)\',\\n      \'Abgrenzung verifizieren: Tabellendaten in Datenbanken auslagern, Single-Project-Context in CLAUDE.md belassen\',\\n      \'Langzeitwert sichern: Dom\303\244nen\303\274bergreifende Wissensakkumulation \303\274ber Jahre hinweg planen\'\\n    ]\\n  },\\n  {\\n    id: \'ch-08\',\\n    chapterNumber: 8,\\n    filename: \'08 mentales-modell-drei-ebenen.md\',\\n    title: \'Das 3-Ebenen-Architekturmodell\',\\n    phase: \'Phase 1: Fundament & Vault\',\\n    priority: \'Kritisch\',\\n    summary: \'Entkoppelte Schichten: 1. Intake Layer (Kuratierung), 2. Retrieval Layer (FTS5, Vec, RRF), 3. Integration Layer (MCP, Hooks, Skills).\',\\n    deliverables: [\\n      \'Schichtgrenzen im Code strikt trennen: Retriever wei\303\237 nichts \303\274ber Routing, MCP wei\303\237 nichts \303\274ber Notizursprung\',\\n      \'Fehlermodi je Ebene absichern (Intake = Rauschen/Dubletten, Retrieval = Ranking-Drift, Integration = Context Overflow)\',\\n      \'Unabh\303\244ngige Wartbarkeit sicherstellen: Vektormodell tauschbar, ohne Notizstruktur zu brechen\'\\n    ]\\n  },\\n  {\\n    id: \'ch-09\',\\n    chapterNumber: 9,\\n    filename: \'09 vault-architektur-f\303\274r-ai-consumption.md\',\\n    title: \'Vault-Architektur & .indexignore Konventionen\',\\n    phase: \'Phase 1: Fundament & Vault\',\\n    priority: \'Kritisch\',\\n    summary: \'Pr\303\244fix-Ordnerstruktur (00-inbox bis 08-attachments), YAML-Frontmatter-Schema und Chunking an H2-Grenzen (##).\',\\n    deliverables: [\\n      \'Nummerierte Ordner anlegen: `00-inbox`, `01-projects`, `02-areas`, `03-resources`, `05-signals` (12 Subdom\303\244nen), `07-templates`\',\\n      \'.indexignore anlegen: Templates, Attachments, .obsidian, sensible Ordner (Finanzen, Gesundheit) ausschlie\303\237en\',\\n      \'Notizschema mit YAML Frontmatter definieren: `title`, `type`, `domain`, `tags`, `status`\',\\n      \'H2-\303\234berschriften-Konvention f\303\274r sauberes Chunken durchsetzen\'\\n    ],\\n    codeSnippets: [\\n      {\\n        language: \'yaml\',\\n        description: \'Standard Frontmatter Schema\',\\n        code: \'---\\\\ntitle: \\\"OAuth Token Rotation Patterns\\\"\\\\ntype: note\\\\ndomain: security\\\\ntags: [authentication, oauth, token-management]\\\\nstatus: active\\\\n---\'\\n      }\\n    ]\\n  },\\n  {\\n    id: \'ch-10\',\\n    chapterNumber: 10,\\n    filename: \'10 plugin-\303\266kosystem-f\303\274r-ai-workflows.md\',\\n    title: \'Plugin-\303\226kosystem & Bases-Migration\',\\n    phase: \'Phase 7: Tuning, Ops & Wartung\',\\n    priority: \'Mittel\',\\n    summary: \'Empfohlene Plugins: Bases (Kern-Ersatz f\303\274r Dataview), Templater, Linter, Git, Smart Connections v4.5. St\303\266rende Plugins ausschlie\303\237en.\',\\n    deliverables: [\\n      \'Bases (ab Obsidian 1.9+) als modernen Standard f\303\274r Tabellen- und Datenbankansichten nutzen\',\\n      \'Linter-Regeln f\303\274r sequenzielle H1-H2-Hierarchien und saubere Leerzeilen konfigurieren\',\\n      \'Excalidraw, reine JSON-Kanban-Boards und leere Kalendernotizen aus dem Index ausschlie\303\237en\',\\n      \'Smart Connections v4.5 f\303\274r Editor-interne Vorschl\303\244ge evaluieren\'\\n    ]\\n  },\\n  {\\n    id: \'ch-11\',\\n    chapterNumber: 11,\\n    filename: \'11 embedding-modelle-auswahl-und-konfiguration.md\',\\n    title: \'Embedding-Modell: Model2Vec potion-base-8M\',\\n    phase: \'Phase 2: Indexierung & DB\',\\n    priority: \'Kritisch\',\\n    summary: \'minishlab/potion-base-8M: 256 Dimensionen, 30 MB, 500x schneller als Transformer, reine CPU/NumPy-Inference ohne PyTorch.\',\\n    deliverables: [\\n      \'Model2Vec in isoliertem venv installieren (`~/.claude/venvs/memory/`)\',\\n      \'Lazy-Loading und Batch-Verarbeitung (Batch-Gr\303\266\303\237e 64 Chunks) implementieren\',\\n      \'Model-Hash-Tracking einbauen (Modellname + Vokabulargr\303\266\303\237e) f\303\274r automatische Neuindexierung bei Modellwechsel\',\\n      \'Alternativen kennen: potion-base-32M (h\303\266here Qualit\303\244t), potion-multilingual-128M (101 Sprachen)\'\\n    ],\\n    codeSnippets: [\\n      {\\n        language: \'python\',\\n        description: \'Model2Vec Embedder Setup\',\\n        code: \'from model2vec import StaticModel\\\\nmodel = StaticModel.from_pretrained(\\\"minishlab/potion-base-8M\\\")\\\\nvecs = model.encode([\\\"OAuth token rotation in FastAPI\\\"])\'\\n      }\\n    ]\\n  },\\n  {\\n    id: \'ch-12\',\\n    chapterNumber: 12,\\n    filename: \'12 volltextsuche-mit-fts5.md\',\\n    title: \'Volltextsuche mit SQLite FTS5 (BM25)\',\\n    phase: \'Phase 2: Indexierung & DB\',\\n    priority: \'Kritisch\',\\n    summary: \'FTS5 Virtual Table mit Spaltengewichtung: chunk_text (1.0), section H2 (0.5), heading_context (0.3). Perfekt f\303\274r Bezeichner & Flags.\',\\n    deliverables: [\\n      \'FTS5-Tabelle mit `content=chunks` und `content_rowid=id` einrichten (kein doppelter Speicher)\',\\n      \'Spaltengewichtetes BM25-Ranking implementieren: `bm25(chunks_fts, 1.0, 0.5, 0.3)`\',\\n      \'FTS5-Synchronisation programmieren (`rebuild` bei Initiallauf, Einzelzeilen-Sync bei inkrementellem Lauf)\',\\n      \'Trigram-Tokenizer f\303\274r CJK-Tresore als Option vorsehen\'\\n    ],\\n    codeSnippets: [\\n      {\\n        language: \'sql\',\\n        description: \'FTS5 Schema & BM25 Query\',\\n        code: \'CREATE VIRTUAL TABLE chunks_fts USING fts5(\\\\n    chunk_text, section, heading_context,\\\\n    content=chunks, content_rowid=id\\\\n);\\\\n-- Query:\\\\nSELECT c.id, c.file_path, c.chunk_text, bm25(chunks_fts, 1.0, 0.5, 0.3) AS score\\\\nFROM chunks_fts JOIN chunks c ON chunks_fts.rowid = c.id\\\\nWHERE chunks_fts MATCH ? ORDER BY score LIMIT 30;\'\\n      }\\n    ]\\n  },\\n  {\\n    id: \'ch-13\',\\n    chapterNumber: 13,\\n    filename: \'13 vector-search-mit-sqlite-vec.md\',\\n    title: \'Vektorsuche mit sqlite-vec (vec0)\',\\n    phase: \'Phase 2: Indexierung & DB\',\\n    priority: \'Kritisch\',\\n    summary: \'sqlite-vec v0.1.7+: vec0 Virtual Table f\303\274r 256-dim Vektoren, nativer DELETE-Support, KNN-Distanzbeschr\303\244nkungen.\',\\n    deliverables: [\\n      \'sqlite-vec Extension laden (`enable_load_extension(True)`, `load_extension(\\\"vec0\\\")`)\',\\n      \'Bin\303\244re Vektorserialisierung mit Python `struct.pack(f\\\"{len(vec)}f\\\", *vec)` implementieren\',\\n      \'KNN-Kosinusabfrage \303\274ber `embedding MATCH ? AND k = ?` implementieren\',\\n      \'Graceful Degradation einbauen: Automatischer Fallback auf reines BM25, falls Extension fehlt\'\\n    ],\\n    codeSnippets: [\\n      {\\n        language: \'sql\',\\n        description: \'sqlite-vec Schema & KNN Query\',\\n        code: \'CREATE VIRTUAL TABLE chunk_vecs USING vec0(\\\\n    id INTEGER PRIMARY KEY,\\\\n    embedding float[256]\\\\n);\\\\n-- KNN Query:\\\\nSELECT cv.id, cv.distance, c.file_path, c.chunk_text\\\\nFROM chunk_vecs cv JOIN chunks c ON cv.id = c.id\\\\nWHERE embedding MATCH ? AND k = 30 ORDER BY distance;\'\\n      }\\n    ]\\n  },\\n  {\\n    id: \'ch-14\',\\n    chapterNumber: 14,\\n    filename: \'14 reciprocal-rank-fusion-rrf.md\',\\n    title: \'Reciprocal Rank Fusion (RRF k=60)\',\\n    phase: \'Phase 3: Hybride Retrieval Engine\',\\n    priority: \'Kritisch\',\\n    summary: \'Parameterfreie Fusion: score(d) = \316\243 weight_i / (k + rank_i). Vereint Keyword- und Vektorergebnisse ohne Score-Kalibrierung.\',\\n    deliverables: [\\n      \'RRF-Formel mit Gl\303\244ttungskonstante k=60 implementieren\',\\n      \'Ergebnisse aus BM25 (Top 30) und Vektor (Top 30) aggregieren\',\\n      \'Tie-Breaking-Regeln definieren (Dual-Source-Treffer bevorzugen vor Single-Source)\',\\n      \'Interaktiven Fusion-Rechner zur \303\234berpr\303\274fung extremer Rangunterschiede einbinden\'\\n    ],\\n    codeSnippets: [\\n      {\\n        language: \'python\',\\n        description: \'RRF Fusion Algorithmus\',\\n        code: \'RRF_K = 60\\\\nscore[cid] += weight / (RRF_K + rank)\\\\n# Chunks in beiden Listen steigen stark nach oben!\'\\n      }\\n    ]\\n  },\\n  {\\n    id: \'ch-15\',\\n    chapterNumber: 15,\\n    filename: \'15 die-vollst\303\244ndige-retrieval-pipeline.md\',\\n    title: \'Die komplette End-to-End Retrieval Pipeline\',\\n    phase: \'Phase 3: Hybride Retrieval Engine\',\\n    priority: \'Kritisch\',\\n    summary: \'BM25 (12ms) + Vector KNN (8ms) + RRF Fusion (3ms) + Token-Budget-K\303\274rzung (<1ms) = ~23ms Gesamtlatenz bei 49.746 Chunks.\',\\n    deliverables: [\\n      \'Klasse `HybridRetriever` mit `search(query, limit=10, max_tokens=4000)` zusammenf\303\274hren\',\\n      \'Gierige Token-Budget-K\303\274rzung (4 Zeichen pro Token als N\303\244herung) einbauen\',\\n      \'Vollst\303\244ndiges relationales Schema verkn\303\274pfen: chunks, chunks_fts, chunk_vecs, model_meta\',\\n      \'Graceful Degradation Pfad testen (Full -> BM25 only -> Error if DB missing)\'\\n    ]\\n  },\\n  {\\n    id: \'ch-16\',\\n    chapterNumber: 16,\\n    filename: \'16 content-hashing-und-\303\244nderungserkennung.md\',\\n    title: \'\303\204nderungserkennung via mtime_ns\',\\n    phase: \'Phase 2: Indexierung & DB\',\\n    priority: \'Hoch\',\\n    summary: \'Dateisystem-mtime_ns Vergleich (<100ms f\303\274r 16.000 Dateien) vs. Voll-Content-Hashing (2-3s). Pragmatische Wahl f\303\274r t\303\244gliche AI-Nutzung.\',\\n    deliverables: [\\n      \'Dateiscan mit `mtime_ns` implementieren: Erkennung von neuen, ge\303\244nderten und gel\303\266schten Dateien\',\\n      \'L\303\266schlogik programmieren: Verkn\303\274pfte Chunks aus `chunks`, `chunk_vecs` und `chunks_fts` entfernen\',\\n      \'False-Positive-Toleranz akzeptieren (einige unkritische Extra-Embeddings f\303\274r 30x schnellere Erkennung)\'\\n    ]\\n  },\\n  {\\n    id: \'ch-17\',\\n    chapterNumber: 17,\\n    filename: \'17 inkrementelles-vs.-vollst\303\244ndiges-reindexing.md\',\\n    title: \'Inkrementelles vs. Vollst\303\244ndiges Reindexing\',\\n    phase: \'Phase 2: Indexierung & DB\',\\n    priority: \'Hoch\',\\n    summary: \'Inkrementell (<10s im Alltag) vs. Vollst\303\244ndig (~4 Min f\303\274r 16.894 Dateien). Idempotenz und Wiederherstellung nach Abst\303\274rzen.\',\\n    deliverables: [\\n      \'CLI-Flag `--incremental` als t\303\244glichen Standard definieren\',\\n      \'CLI-Flag `--full` f\303\274r Modellwechsel, Schemamigrationen und DB-Reparaturen implementieren\',\\n      \'Transaktionssicherheit und Idempotenz gew\303\244hrleisten (alte Chunks l\303\266schen vor Neueinf\303\274gen)\',\\n      \'DB als abgeleitetes Artefakt behandeln (kein Backup der SQLite-Datei n\303\266tig, Quelltext liegt im Vault)\'\\n    ]\\n  },\\n  {\\n    id: \'ch-18\',\\n    chapterNumber: 18,\\n    filename: \'18 credential-filtering-und-datengrenzen.md\',\\n    title: \'Credential-Filtering & Datenschutzgrenzen\',\\n    phase: \'Phase 2: Indexierung & DB\',\\n    priority: \'Kritisch\',\\n    summary: \'25 Regex-Muster f\303\274r API-Keys (sk-, sk-ant-, ghp_), JWTs, Private Keys vor dem Embedding durch [REDACTED:pattern] ersetzen.\',\\n    deliverables: [\\n      \'Regex-Filter f\303\274r OpenAI, Anthropic, GitHub, AWS, JWT, SSH-Keys vor der Speicherung anwenden\',\\n      \'Semantischen Kontext erhalten: Ersetzen mit `[REDACTED:pattern_name]` statt Textl\303\266schung\',\\n      \'Defense-in-Depth: Zus\303\244tzliche Filterung am Ausgang des MCP-Servers vor der Agentenausgabe\',\\n      \'Sensibilit\303\244tsebenen definieren (\303\226ffentlich, Intern, Sensibel, Eingeschr\303\244nkt)\'\\n    ],\\n    codeSnippets: [\\n      {\\n        language: \'python\',\\n        description: \'Credential Scrubbing\',\\n        code: \'for pattern in CREDENTIAL_PATTERNS:\\\\n    text = pattern.regex.sub(f\\\"[REDACTED:{pattern.name}]\\\", text)\'\\n      }\\n    ]\\n  },\\n  {\\n    id: \'ch-19\',\\n    chapterNumber: 19,\\n    filename: \'19 mcp-serverarchitektur.md\',\\n    title: \'MCP-Serverarchitektur (STDIO vs. HTTP)\',\\n    phase: \'Phase 4: MCP Server & Protokoll\',\\n    priority: \'Kritisch\',\\n    summary: \'STDIO f\303\274r pers\303\266nliche Vaults, 4 Kern-Tools: obsidian_search, obsidian_read_note, obsidian_list_notes, obsidian_get_context.\',\\n    deliverables: [\\n      \'STDIO-JSON-RPC Transport f\303\274r minimale Latenz und Prozesskopplung einsetzen\',\\n      \'4 Kern-Tools implementieren: search, read_note, list_notes, get_context\',\\n      \'Strikte Berechtigungsgrenzen: Read-only, Vault-Jail (Schutz vor ../../etc/passwd), Token-Limits\',\\n      \'Strukturierte Fehlermeldungen mit L\303\266sungsvorschl\303\244gen zur\303\274ckgeben\'\\n    ]\\n  },\\n  {\\n    id: \'ch-20\',\\n    chapterNumber: 20,\\n    filename: \'20 claude-code-integration.md\',\\n    title: \'Claude Code Integration (Hooks & Bridge)\',\\n    phase: \'Phase 5: Agent-Integrationen\',\\n    priority: \'Kritisch\',\\n    summary: \'UserPromptSubmit-Hook f\303\274r Kontextinjektion, PostToolUse-Hook f\303\274r Erkenntniserfassung, obsidian_bridge.py Python-API.\',\\n    deliverables: [\\n      \'Server via `claude mcp add` in `~/.claude.json` registrieren\',\\n      \'UserPromptSubmit-Hook mit `obsidian-context.sh` via stdin JSON einbinden (1.500-2.000 Token-Budget)\',\\n      \'PostToolUse-Hook mit `capture-insight.sh` f\303\274r gro\303\237e Tool-Ausgaben konfigurieren\',\\n      \'Python Bridge-Modul `obsidian_bridge.py` als Singleton f\303\274r schnelle Abfragen bereitstellen\',\\n      \'Slash-Skill `/capture` zur manuellen Erkenntnis\303\274bernahme nach `00-inbox/` erstellen\'\\n    ]\\n  },\\n  {\\n    id: \'ch-21\',\\n    chapterNumber: 21,\\n    filename: \'21 codex-cli-integration.md\',\\n    title: \'Codex CLI Integration & AGENTS.md\',\\n    phase: \'Phase 5: Agent-Integrationen\',\\n    priority: \'Hoch\',\\n    summary: \'Anbindung via ~/.codex/config.toml und Projekt-Anweisungen in AGENTS.md zur prim\303\244ren Vault-Konsultation.\',\\n    deliverables: [\\n      \'MCP-Server in `~/.codex/config.toml` eintragen mit Environment-Variablen\',\\n      \'AGENTS.md Richtlinien verfassen: Vor Code-\303\204nderungen stets Obsidian-Vault abfragen\',\\n      \'Unterschiede zu Claude Code beachten: Sandbox-Modi & Freigaberichtlinien\'\\n    ]\\n  },\\n  {\\n    id: \'ch-22\',\\n    chapterNumber: 22,\\n    filename: \'22 cursor-und-andere-tools.md\',\\n    title: \'Cursor, Windsurf, Zed & CLI-Fallback\',\\n    phase: \'Phase 5: Agent-Integrationen\',\\n    priority: \'Mittel\',\\n    summary: \'Konfiguration f\303\274r Cursor (.cursor/mcp.json, .cursorrules), Windsurf, Continue.dev, Zed und universelles CLI-Fallback.\',\\n    deliverables: [\\n      \'.cursor/mcp.json und .cursorrules f\303\274r automatische Vault-Suche konfigurieren\',\\n      \'Universal CLI-Wrapper `retriever_cli.py` f\303\274r Tools ohne native MCP-Unterst\303\274tzung bereitstellen\'\\n    ]\\n  },\\n  {\\n    id: \'ch-23\',\\n    chapterNumber: 23,\\n    filename: \'23 prompt-caching-aus-strukturierten-notizen.md\',\\n    title: \'Prompt-Caching aus strukturierten Notizen\',\\n    phase: \'Phase 6: Intake, Caching & Graph\',\\n    priority: \'Hoch\',\\n    summary: \'Wiederverwendbare Kontextbl\303\266cke (Auth-Patterns, API-Conventions, Architecture) mit TTL vorab generieren und Token um 50% senken.\',\\n    deliverables: [\\n      \'Cache-Block-Definitionen mit TTLs (12h bis 168h) anlegen\',\\n      \'Cache-Invalidierung bei Vault-Dateimodifikation verkn\303\274pfen\',\\n      \'Tokenbudget-Strategie: 8.000 Gesamt = 1.500 System + 3.000 Cache + 2.000 Dynamisch + 1.500 Dialog\'\\n    ]\\n  },\\n  {\\n    id: \'ch-24\',\\n    chapterNumber: 24,\\n    filename: \'24 komprimierte-zusammenfassungen-ausf\303\274hrlicher-ausgaben-erfassen.md\',\\n    title: \'Komprimierte Ausgabenerfassung (PostToolUse)\',\\n    phase: \'Phase 6: Intake, Caching & Graph\',\\n    priority: \'Hoch\',\\n    summary: \'Gepr\303\274ftes Wissen f\303\274r k\303\274nftige Sitzungen: 5.000 Token Bash-Testausgaben auf 2-Zeiler zusammenfassen und im Vault sichern.\',\\n    deliverables: [\\n      \'PostToolUse-Hook f\303\274r Bash-Tool-Ausgaben >2000 Zeichen einrichten\',\\n      \'Heuristiken implementieren: Testl\303\244ufe (Bestanden/Fehlgeschlagen z\303\244hlen), Stack-Traces (1. und letzter Frame)\',\\n      \'Komprimierte Notiz in `05-signals/` speichern f\303\274r sitzungs\303\274bergreifenden Abruf\'\\n    ]\\n  },\\n  {\\n    id: \'ch-25\',\\n    chapterNumber: 25,\\n    filename: \'25 signalaufnahme-und-triage-pipeline.md\',\\n    title: \'Signalaufnahme & 4D-Triage-Pipeline\',\\n    phase: \'Phase 6: Intake, Caching & Graph\',\\n    priority: \'Kritisch\',\\n    summary: \'Kuratierung vor Ingestion: Web Clipper, RSS, iOS Share Sheet, 4 Bewertungsdimensionen (Relevanz, Umsetzbarkeit, Tiefe, Autorit\303\244t).\',\\n    deliverables: [\\n      \'Scoring-Formel implementieren: composite = (rel*0.35) + (act*0.25) + (dep*0.25) + (auth*0.15)\',\\n      \'Routing-Schwellenwerte festlegen: >=0.55 (Auto-Routing), 0.40-0.55 (Manuelle Review), <0.40 (Verwerfen)\',\\n      \'12 Domain-Ordner in `05-signals/` einrichten (ai-tooling, security, systems, programming, etc.)\',\\n      \'Obsidian Web Clipper (v1.6+) und iOS Share Extension f\303\274r nahtlose Erfassung konfigurieren\'\\n    ]\\n  },\\n  {\\n    id: \'ch-26\',\\n    chapterNumber: 26,\\n    filename: \'26 knowledge-graph-muster.md\',\\n    title: \'Knowledge Graph Muster & Maps of Content (MOCs)\',\\n    phase: \'Phase 6: Intake, Caching & Graph\',\\n    priority: \'Hoch\',\\n    summary: \'Wiki-Links als absichtliche semantische Br\303\274cken, MOCs als Indexnotizen, Graph-Traversierung zur Kontexterweiterung.\',\\n    deliverables: [\\n      \'Maps of Content (MOCs) f\303\274r Hauptdom\303\244nen erstellen (z.B. Authentication & Security MOC)\',\\n      \'Kontexterweiterung durch Link-Traversierung (Tiefe 1) vorbereiten\',\\n      \'Anti-Patterns vermeiden: Verwaiste Cluster, Tag-Wildwuchs (>500 Tags auf 20-50 konsolidieren), leere Link-Notizen\'\\n    ]\\n  },\\n  {\\n    id: \'ch-27\',\\n    chapterNumber: 27,\\n    filename: \'27 developer-workflow-rezepte.md\',\\n    title: \'Developer Workflow Rezepte\',\\n    phase: \'Phase 6: Intake, Caching & Graph\',\\n    priority: \'Mittel\',\\n    summary: \'T\303\244gliche Muster: Morgenkontext laden, Inline-Recherche w\303\244hrend des Codens (/capture), PR-Review-Vorbereitung mit Vault-Wissen.\',\\n    deliverables: [\\n      \'Morgenroutine einrichten: \\\"Search my vault for notes about [current project] updated in the last week\\\"\',\\n      \'Micro-Captures beim Coden etablieren (schnelle Notizen zu Framework-Eigenheiten)\',\\n      \'Code-Review-Vorbereitung: Abruf historischer Architekturentscheidungen vor dem PR\'\\n    ]\\n  },\\n  {\\n    id: \'ch-28\',\\n    chapterNumber: 28,\\n    filename: \'28 performance-tuning.md\',\\n    title: \'Performance-Tuning (WAL, mmap, FTS5 optimize)\',\\n    phase: \'Phase 7: Tuning, Ops & Wartung\',\\n    priority: \'Hoch\',\\n    summary: \'PRAGMA journal_mode=WAL (paralleles Lesen/Schreiben), mmap_size 256MB, FTS5 optimize B-Tree Merging.\',\\n    deliverables: [\\n      \'SQLite WAL-Modus aktivieren f\303\274r verz\303\266gerungsfreie parallele Lesezugriffe w\303\244hrend Indexierungs-Schreibvorg\303\244ngen\',\\n      \'Memory-mapped I/O konfigurieren (`PRAGMA mmap_size=268435456`)\',\\n      \'FTS5 `optimize` nach vollst\303\244ndigen Indexl\303\244ufen ausf\303\274hren zur B-Tree-Kompaktierung\',\\n      \'Batch-Gr\303\266\303\237e (64 vs. 128) je nach Hardware-RAM abstimmen\'\\n    ],\\n    codeSnippets: [\\n      {\\n        language: \'sql\',\\n        description: \'High-Performance Pragmas\',\\n        code: \'PRAGMA journal_mode=WAL;\\\\nPRAGMA mmap_size=268435456;\\\\nPRAGMA busy_timeout=5000;\\\\nINSERT INTO chunks_fts(chunks_fts) VALUES(\\\"optimize\\\");\'\\n      }\\n    ]\\n  },\\n  {\\n    id: \'ch-29\',\\n    chapterNumber: 29,\\n    filename: \'29 fehlerbehebung.md\',\\n    title: \'Fehlerbehebung & Notfall-Leitfaden\',\\n    phase: \'Phase 7: Tuning, Ops & Wartung\',\\n    priority: \'Hoch\',\\n    summary: \'L\303\266sungen f\303\274r Index-Drift, Modell-Hash-Mismatch, FTS5-Fragmentierung, MCP-Timeouts, SQLITE_BUSY und sqlite-vec Ladefehler.\',\\n    deliverables: [\\n      \'Warmup-Abfrage beim MCP-Serverstart implementieren (verhindert MCP Client Timeout durch Lazy Model Load)\',\\n      \'SQLITE_BUSY durch `busy_timeout=5000` und Single-Writer-Architektur l\303\266sen\',\\n      \'Integrit\303\244tspr\303\274fung und Rebuild-Workflow dokumentieren: `PRAGMA integrity_check` -> `--full` Reindex\'\\n    ]\\n  },\\n  {\\n    id: \'ch-30\',\\n    chapterNumber: 30,\\n    filename: \'30 migrationsleitfaden.md\',\\n    title: \'Migrationsleitfaden (Apple Notes, Notion, Google Docs)\',\\n    phase: \'Phase 7: Tuning, Ops & Wartung\',\\n    priority: \'Mittel\',\\n    summary: \'Schritt-f\303\274r-Schritt Migration aus propriet\303\244ren Silos in Markdown mit YAML Frontmatter und sauberer Ordnerzuordnung.\',\\n    deliverables: [\\n      \'Apple Notes Migration via Pandoc/HTML-Export nach `00-inbox/` strukturieren\',\\n      \'Notion Export (Markdown & CSV) bereinigen: Tabellen in YAML umwandeln, relative Bilder sichern\',\\n      \'Goldene Regel beachten: Nur Inhalte migrieren, niemals alte Vektoren (stets frischer Reindex mit neuem Modell)\'\\n    ]\\n  },\\n  {\\n    id: \'ch-31\',\\n    chapterNumber: 31,\\n    filename: \'31 \303\244nderungsprotokoll.md\',\\n    title: \'Audit & Versionshistorie (2026)\',\\n    phase: \'Phase 7: Tuning, Ops & Wartung\',\\n    priority: \'Mittel\',\\n    summary: \'Aktueller Versionsstand 2026: Obsidian 1.13.7 (Stable+Beta), MCP Spezifikation 2026-07-28 (Zustandsloser Kern), sqlite-vec v0.1.9, Model2Vec v0.8.2.\',\\n    deliverables: [\\n      \'Versionsst\303\244nde im Stack abgleichen: Obsidian 1.13.7, sqlite-vec v0.1.9, mcpvault v0.15.0\',\\n      \'MCP-Spezifikation 2026-07-28 beachten (zustandsloser Kern, MCP Apps, Tasks API)\',\\n      \'Audit-Pr\303\274fung: Keine veralteten Namenskollisionen im Setup verwenden\'\\n    ]\\n  },\\n  {\\n    id: \'ch-32\',\\n    chapterNumber: 32,\\n    filename: \'32 referenzen.md\',\\n    title: \'Referenzen, Papers & Quellverweise\',\\n    phase: \'Phase 7: Tuning, Ops & Wartung\',\\n    priority: \'Mittel\',\\n    summary: \'Wissenschaftliche und technische Quellen: Cormack et al. (RRF SIGIR 2009), Model2Vec arXiv 2025, MCP Spec, sqlite-vec.\',\\n    deliverables: [\\n      \'RRF Paper (Cormack et al. 2009, k=60) als mathematisches Fundament archivieren\',\\n      \'Model2Vec Paper (van Dongen et al. 2025) f\303\274r statische Embeddings referenzieren\',\\n      \'Dokumentationslinks zu MCP und sqlite-vec bereitstellen\'\\n    ]\\n  }\\n];\\n\",\"Overwrite\":true,\"TargetFile\":\"/src/data/tasksData.ts\",\"toolAction\":\"Creating tasks data file\",\"toolSummary\":\"Create comprehensive 32-chapter tasks data\"}"
