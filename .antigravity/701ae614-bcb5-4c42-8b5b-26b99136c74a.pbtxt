    content: "import {\n  Compass,\n  Search,\n  FileText,\n  Share2,\n  Calendar,\n  Star,\n  Tag,\n  Archive,\n  Settings,\n  HelpCircle,\n  ListTodo,\n  Cpu,\n  Layers,\n} from \'lucide-react\';\n\ninterface Props {\n  themeMode: \'weiss\' | \'bunt\';\n  activeSection: string;\n  setActiveSection: (s: string) => void;\n  onOpenChecklist: () => void;\n  onOpenSimulator: () => void;\n}\n\nexport const GlassSidebar = ({\n  themeMode,\n  activeSection,\n  setActiveSection,\n  onOpenChecklist,\n  onOpenSimulator,\n}: Props) => {\n  const isWeiss = themeMode === \'weiss\';\n\n  const navItems = [\n    { id: \'home\', icon: Compass, label: \'Vault Cockpit\', action: () => setActiveSection(\'home\') },\n    { id: \'search\', icon: Search, label: \'Suche (Hybrid)\', action: onOpenSimulator },\n    { id: \'checklist\', icon: ListTodo, label: \'32-Kapitel Tasks\', action: onOpenChecklist },\n    { id: \'notes\', icon: FileText, label: \'Alle Notizen (16.894)\', action: () => setActiveSection(\'notes\') },\n    { id: \'graph\', icon: Share2, label: \'Graph View (MOCs)\', action: onOpenSimulator },\n    { id: \'calendar\', icon: Calendar, label: \'Kalender 2026\', action: () => setActiveSection(\'calendar\') },\n    { id: \'starred\', icon: Star, label: \'Favoriten & MOCs\', action: () => setActiveSection(\'starred\') },\n    { id: \'tags\', icon: Tag, label: \'Tags & Dom\303\244nen\', action: () => setActiveSection(\'tags\') },\n    { id: \'archive\', icon: Archive, label: \'Archiv & Speicher\', action: () => setActiveSection(\'archive\') },\n    { id: \'settings\', icon: Settings, label: \'MCP & FTS5 Einstellungen\', action: onOpenSimulator },\n    { id: \'help\', icon: HelpCircle, label: \'Leitfaden 2026\', action: onOpenChecklist },\n  ];\n\n  return (\n    <aside className=\"hidden md:flex flex-col items-center py-4 px-2 select-none z-20\">\n      <div\n        className={`rounded-full py-4 px-2 flex flex-col items-center gap-3.5 glass-rainbow-edge transition-all duration-300 ${\n          isWeiss ? \'glass-white text-slate-700 shadow-xl\' : \'glass-bunt text-slate-200 shadow-2xl\'\n        }`}\n      >\n        {/* Top Obsidian Logo Diamond */}\n        <div\n          onClick={() => setActiveSection(\'home\')}\n          className={`w-9 h-9 rounded-full flex items-center justify-center cursor-pointer transition-transform hover:scale-110 ${\n            isWeiss\n              ? \'bg-gradient-to-tr from-indigo-500/20 to-purple-500/30 text-indigo-700 border border-white\'\n              : \'bg-gradient-to-tr from-cyan-500/30 to-fuchsia-500/40 text-cyan-300 border border-white/30\'\n          }`}\n          title=\"Obsidian AI Knowledge Vault\"\n        >\n          <svg className=\"w-5 h-5 fill-current\" viewBox=\"0 0 100 100\">\n            <polygon points=\"50,5 92,30 75,95 25,95 8,30\" opacity=\"0.85\" />\n            <polygon points=\"50,15 82,35 68,85 32,85 18,35\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"6\" />\n          </svg>\n        </div>\n\n        <div className={`w-5 h-px ${isWeiss ? \'bg-slate-300/60\' : \'bg-white/20\'}`} />\n\n        {/* Action icons list */}\n        {navItems.map((item) => {\n          const Icon = item.icon;\n          const isActive = activeSection === item.id;\n\n          return (\n            <button\n              key={item.id}\n              onClick={item.action}\n              title={item.label}\n              className={`relative p-2 rounded-full transition-all duration-200 cursor-pointer group ${\n                isActive\n                  ? isWeiss\n                    ? \'bg-white shadow-md text-indigo-600 scale-105\'\n                    : \'bg-white/25 shadow-lg text-cyan-300 scale-105\'\n                  : isWeiss\n                  ? \'hover:bg-white/60 hover:text-indigo-900 text-slate-600\'\n                  : \'hover:bg-white/15 hover:text-white text-slate-300\'\n              }`}\n            >\n              <Icon className=\"w-4 h-4\" />\n\n              {/* Tooltip on hover */}\n              <span\n                className={`absolute left-full ml-3 px-2.5 py-1 rounded-md text-xs font-medium whitespace-nowrap opacity-0 pointer-events-none group-hover:opacity-100 transition-opacity z-50 shadow-lg ${\n                  isWeiss\n                    ? \'bg-white/95 text-slate-800 border border-slate-200\'\n                    : \'bg-slate-900/95 text-slate-100 border border-purple-500/40\'\n                }`}\n              >\n                {item.label}\n              </span>\n            </button>\n          );\n        })}\n      </div>\n    </aside>\n  );\n};\n"
    raw_content: "import {\n  Compass,\n  Search,\n  FileText,\n  Share2,\n  Calendar,\n  Star,\n  Tag,\n  Archive,\n  Settings,\n  HelpCircle,\n  ListTodo,\n  Cpu,\n  Layers,\n} from \'lucide-react\';\n\ninterface Props {\n  themeMode: \'weiss\' | \'bunt\';\n  activeSection: string;\n  setActiveSection: (s: string) => void;\n  onOpenChecklist: () => void;\n  onOpenSimulator: () => void;\n}\n\nexport const GlassSidebar = ({\n  themeMode,\n  activeSection,\n  setActiveSection,\n  onOpenChecklist,\n  onOpenSimulator,\n}: Props) => {\n  const isWeiss = themeMode === \'weiss\';\n\n  const navItems = [\n    { id: \'home\', icon: Compass, label: \'Vault Cockpit\', action: () => setActiveSection(\'home\') },\n    { id: \'search\', icon: Search, label: \'Suche (Hybrid)\', action: onOpenSimulator },\n    { id: \'checklist\', icon: ListTodo, label: \'32-Kapitel Tasks\', action: onOpenChecklist },\n    { id: \'notes\', icon: FileText, label: \'Alle Notizen (16.894)\', action: () => setActiveSection(\'notes\') },\n    { id: \'graph\', icon: Share2, label: \'Graph View (MOCs)\', action: onOpenSimulator },\n    { id: \'calendar\', icon: Calendar, label: \'Kalender 2026\', action: () => setActiveSection(\'calendar\') },\n    { id: \'starred\', icon: Star, label: \'Favoriten & MOCs\', action: () => setActiveSection(\'starred\') },\n    { id: \'tags\', icon: Tag, label: \'Tags & Dom\303\244nen\', action: () => setActiveSection(\'tags\') },\n    { id: \'archive\', icon: Archive, label: \'Archiv & Speicher\', action: () => setActiveSection(\'archive\') },\n    { id: \'settings\', icon: Settings, label: \'MCP & FTS5 Einstellungen\', action: onOpenSimulator },\n    { id: \'help\', icon: HelpCircle, label: \'Leitfaden 2026\', action: onOpenChecklist },\n  ];\n\n  return (\n    <aside className=\"hidden md:flex flex-col items-center py-4 px-2 select-none z-20\">\n      <div\n        className={`rounded-full py-4 px-2 flex flex-col items-center gap-3.5 glass-rainbow-edge transition-all duration-300 ${\n          isWeiss ? \'glass-white text-slate-700 shadow-xl\' : \'glass-bunt text-slate-200 shadow-2xl\'\n        }`}\n      >\n        {/* Top Obsidian Logo Diamond */}\n        <div\n          onClick={() => setActiveSection(\'home\')}\n          className={`w-9 h-9 rounded-full flex items-center justify-center cursor-pointer transition-transform hover:scale-110 ${\n            isWeiss\n              ? \'bg-gradient-to-tr from-indigo-500/20 to-purple-500/30 text-indigo-700 border border-white\'\n              : \'bg-gradient-to-tr from-cyan-500/30 to-fuchsia-500/40 text-cyan-300 border border-white/30\'\n          }`}\n          title=\"Obsidian AI Knowledge Vault\"\n        >\n          <svg className=\"w-5 h-5 fill-current\" viewBox=\"0 0 100 100\">\n            <polygon points=\"50,5 92,30 75,95 25,95 8,30\" opacity=\"0.85\" />\n            <polygon points=\"50,15 82,35 68,85 32,85 18,35\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"6\" />\n          </svg>\n        </div>\n\n        <div className={`w-5 h-px ${isWeiss ? \'bg-slate-300/60\' : \'bg-white/20\'}`} />\n\n        {/* Action icons list */}\n        {navItems.map((item) => {\n          const Icon = item.icon;\n          const isActive = activeSection === item.id;\n\n          return (\n            <button\n              key={item.id}\n              onClick={item.action}\n              title={item.label}\n              className={`relative p-2 rounded-full transition-all duration-200 cursor-pointer group ${\n                isActive\n                  ? isWeiss\n                    ? \'bg-white shadow-md text-indigo-600 scale-105\'\n                    : \'bg-white/25 shadow-lg text-cyan-300 scale-105\'\n                  : isWeiss\n                  ? \'hover:bg-white/60 hover:text-indigo-900 text-slate-600\'\n                  : \'hover:bg-white/15 hover:text-white text-slate-300\'\n              }`}\n            >\n              <Icon className=\"w-4 h-4\" />\n\n              {/* Tooltip on hover */}\n              <span\n                className={`absolute left-full ml-3 px-2.5 py-1 rounded-md text-xs font-medium whitespace-nowrap opacity-0 pointer-events-none group-hover:opacity-100 transition-opacity z-50 shadow-lg ${\n                  isWeiss\n                    ? \'bg-white/95 text-slate-800 border border-slate-200\'\n                    : \'bg-slate-900/95 text-slate-100 border border-purple-500/40\'\n                }`}\n              >\n                {item.label}\n              </span>\n            </button>\n          );\n        })}\n      </div>\n    </aside>\n  );\n};\n"
