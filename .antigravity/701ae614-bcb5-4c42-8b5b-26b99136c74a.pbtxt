    replacement_chunks {
      target_content: "import { useState, useEffect } from \'react\';\nimport { CHAPTER_TASKS, TaskItem } from \'./data/tasksData\';\nimport { GlassBackground } from \'./components/GlassBackground\';\nimport { GlassSidebar } from \'./components/GlassSidebar\';\nimport { GlassProfileCard } from \'./components/GlassProfileCard\';\nimport { GlassMetricsCard } from \'./components/GlassMetricsCard\';\nimport { GlassCalendarCard } from \'./components/GlassCalendarCard\';\nimport { GlassRecentNotesCard } from \'./components/GlassRecentNotesCard\';\nimport { GlassWeatherStatusCard } from \'./components/GlassWeatherStatusCard\';\nimport { GlassAiInsightCard } from \'./components/GlassAiInsightCard\';\nimport { GlassDirectoryCard } from \'./components/GlassDirectoryCard\';\nimport { GlassTodoWidget } from \'./components/GlassTodoWidget\';\nimport { GlassNewsCard } from \'./components/GlassNewsCard\';\nimport { GlassBottomBar } from \'./components/GlassBottomBar\';\nimport { GlassChecklistModal } from \'./components/GlassChecklistModal\';\nimport { GlassSimulatorModal } from \'./components/GlassSimulatorModal\';\nimport { Sparkles, Sun, Moon, CheckCircle } from \'lucide-react\';\n\nconst STORAGE_KEY = \'obsidian_mcp_checklist_state_v2\';\nconst THEME_KEY = \'obsidian_glass_theme_mode\';\n\nexport default function App() {\n  // Theme mode: \'weiss\' (Pure Crystal Ice Glass) or \'bunt\' (Vibrant Sunset & Neon Holographic Glass)\n  const [themeMode, setThemeMode] = useState<\'weiss\' | \'bunt\'>(() => {\n    try {\n      const saved = localStorage.getItem(THEME_KEY);\n      if (saved === \'weiss\' || saved === \'bunt\') return saved;\n    } catch {\n      // fallback\n    }\n    return \'weiss\'; // default to the pristine white frosted glass requested by user\n  });\n\n  // Task list items\n  const [tasks, setTasks] = useState<TaskItem[]>(() => {\n    try {\n      const saved = localStorage.getItem(STORAGE_KEY);\n      if (saved) {\n        const savedIds: string[] = JSON.parse(saved);\n        return CHAPTER_TASKS.map((t) => ({\n          ...t,\n          completed: savedIds.includes(t.id),\n        }));\n      }\n    } catch {\n      // fallback\n    }\n    return CHAPTER_TASKS.map((t) => ({ ...t, completed: false }));\n  });\n\n  // Navigation & Modals\n  const [activeSection, setActiveSection] = useState(\'home\');\n  const [activeFolderFilter, setActiveFolderFilter] = useState<string | null>(null);\n  const [isChecklistOpen, setIsChecklistOpen] = useState(false);\n  const [isSimulatorOpen, setIsSimulatorOpen] = useState(false);\n  const [notification, setNotification] = useState<string | null>(null);\n\n  // Save theme mode to localStorage\n  useEffect(() => {\n    localStorage.setItem(THEME_KEY, themeMode);\n  }, [themeMode]);\n\n  // Save completed tasks to localStorage\n  useEffect(() => {\n    const completedIds = tasks.filter((t) => t.completed).map((t) => t.id);\n    localStorage.setItem(STORAGE_KEY, JSON.stringify(completedIds));\n  }, [tasks]);\n\n  const handleToggleTask = (id: string) => {\n    setTasks((prev) =>\n      prev.map((t) => (t.id === id ? { ...t, completed: !t.completed } : t))\n    );\n  };\n\n  const handleBatchTogglePhase = (phase: string, completed: boolean) => {\n    setTasks((prev) =>\n      prev.map((t) => (t.phase === phase ? { ...t, completed } : t))\n    );\n  };\n\n  const showNotification = (msg: string) => {\n    setNotification(msg);\n    setTimeout(() => setNotification(null), 2500);\n  };\n\n  const completedCount = tasks.filter((t) => t.completed).length;\n  const isWeiss = themeMode === \'weiss\';\n\n  return (\n    <div\n      className={`min-h-screen relative flex flex-col selection:bg-cyan-500/30 selection:text-cyan-200 transition-colors duration-500 overflow-x-hidden ${\n        isWeiss ? \'text-slate-800\' : \'text-slate-100\'\n      }`}\n    >\n      {/* Dynamic Alpine Lake & Mountain Backdrop with Steam / Droplet textures */}\n      <GlassBackground themeMode={themeMode} />\n\n      {/* Floating Notification Toast */}\n      {notification && (\n        <div className=\"fixed top-6 left-1/2 -translate-x-1/2 z-50 px-4 py-2 rounded-2xl glass-white shadow-xl text-xs font-semibold flex items-center gap-2 animate-in fade-in slide-in-from-top-4\">\n          <CheckCircle className=\"w-4 h-4 text-emerald-500\" />\n          <span>{notification}</span>\n        </div>\n      )}\n\n      {/* Main Container */}\n      <div className=\"relative z-10 flex-1 flex flex-col md:flex-row p-3 sm:p-6 lg:p-8 max-w-[1700px] mx-auto w-full gap-5 pb-24\">\n        {/* Far Left Vertical Glass Pill Bar (Exactly matching image-1790114036816.png) */}\n        <GlassSidebar\n          themeMode={themeMode}\n          activeSection={activeSection}\n          setActiveSection={setActiveSection}\n          onOpenChecklist={() => setIsChecklistOpen(true)}\n          onOpenSimulator={() => setIsSimulatorOpen(true)}\n        />\n\n        {/* Center Dashboard Workspace */}\n        <div className=\"flex-1 flex flex-col gap-5\">\n          {/* Top Giant 3D Glass Typography Greeting (\"Guten Abend, Sascha\" style) */}\n          <div className=\"flex flex-col sm:flex-row items-center justify-between gap-3 px-2\">\n            <h1\n              className={`text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight font-display select-none transition-all ${\n                isWeiss ? \'glass-text-3d\' : \'glass-text-3d-bunt\'\n              }`}\n            >\n              Guten Abend, Sascha\n            </h1>\n\n            {/* Quick Theme Switcher Pill in Top Bar */}\n            <div\n              className={`flex items-center gap-1.5 p-1 rounded-full glass-rainbow-edge shadow-md transition-all ${\n                isWeiss ? \'glass-white\' : \'glass-bunt\'\n              }`}\n            >\n              <button\n                onClick={() => setThemeMode(\'weiss\')}\n                className={`px-3 py-1 rounded-full text-xs font-semibold flex items-center gap-1.5 transition-all cursor-pointer ${\n                  isWeiss\n                    ? \'bg-white text-indigo-900 shadow-sm font-bold\'\n                    : \'text-slate-300 hover:text-white\'\n                }`}\n              >\n                <Sun className=\"w-3.5 h-3.5 text-amber-500\" />\n                <span>Weiss</span>\n              </button>\n\n              <button\n                onClick={() => setThemeMode(\'bunt\')}\n                className={`px-3 py-1 rounded-full text-xs font-semibold flex items-center gap-1.5 transition-all cursor-pointer ${\n                  !isWeiss\n                    ? \'bg-gradient-to-r from-cyan-500 to-fuchsia-500 text-white shadow-md font-bold\'\n                    : \'text-slate-600 hover:text-slate-900\'\n                }`}\n              >\n                <Sparkles className=\"w-3.5 h-3.5 text-yellow-300\" />\n                <span>Bunt</span>\n              </button>\n            </div>\n          </div>\n\n          {/* Upper Dashboard Grid: 4 Pillars (Profile, Notiz-Statistik, Kalender, Zuletzt ge\303\266ffnet) */}\n          <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5\">\n            {/* 1. Profile Card with Avatar & Colored Folders */}\n            <GlassProfileCard\n              themeMode={themeMode}\n              userName=\"Sascha\"\n              totalNotesCount=\"16.894\"\n              activeFolderFilter={activeFolderFilter}\n              setActiveFolderFilter={setActiveFolderFilter}\n              onOpenChecklist={() => setIsChecklistOpen(true)}\n            />\n\n            {/* 2. Notiz- & Retrieval-Statistik Card (4 insets) */}\n            <GlassMetricsCard\n              themeMode={themeMode}\n              notesCount=\"16.894\"\n              wordCount=\"49,7k\"\n              folderCount=\"12\"\n              avgWords=\"23ms\"\n              onOpenDetails={() => setIsSimulatorOpen(true)}\n            />\n\n            {/* 3. Kalender Card (September 2026) */}\n            <GlassCalendarCard themeMode={themeMode} />\n\n            {/* 4. Zuletzt ge\303\266ffnet (Markdown Documents) */}\n            <GlassRecentNotesCard\n              themeMode={themeMode}\n              onSelectNote={(note) => {\n                showNotification(`Dokument ge\303\266ffnet: ${note}`);\n                setIsChecklistOpen(true);\n              }}\n            />\n          </div>\n\n          {/* Lower Row Grid: 5 Glass Tiles (Wetter, KI-Einblick, Verzeichnis, To-dos, News) */}\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 sm:gap-5\">\n            {/* Tile 1: Wetter & System */}\n            <GlassWeatherStatusCard themeMode={themeMode} />\n\n            {/* Tile 2: KI-Einblick */}\n            <GlassAiInsightCard\n              themeMode={themeMode}\n              onOpenSimulator={() => setIsSimulatorOpen(true)}\n            />\n\n            {/* Tile 3: Verzeichnis */}\n            <GlassDirectoryCard\n              themeMode={themeMode}\n              onOpenVaultView={() => setIsChecklistOpen(true)}\n            />\n\n            {/* Tile 4: To-dos (All 32 Chapters integrated) */}\n            <GlassTodoWidget\n              themeMode={themeMode}\n              completedCount={completedCount}\n              totalCount={tasks.length}\n              onOpenChecklist={() => setIsChecklistOpen(true)}\n            />\n\n            {/* Tile 5: News & Release */}\n            <GlassNewsCard\n              themeMode={themeMode}\n              onOpenAudit={() => setIsChecklistOpen(true)}\n            />\n          </div>\n        </div>\n      </div>\n\n      {/* Floating Horizontal Glass Bottom Bar (Exactly matching image-1790114036816.png) */}\n      <GlassBottomBar\n        themeMode={themeMode}\n        setThemeMode={setThemeMode}\n        onOpenChecklist={() => setIsChecklistOpen(true)}\n        onOpenSimulator={() => setIsSimulatorOpen(true)}\n        onNewNote={() => showNotification(\'Neue Notiz im Obsidian Vault erstellt\')}\n        onDailyNote={() => showNotification(\'Tagesnotiz 2026-09-22.md angelegt\')}\n      />\n\n      {/* Full 32-Chapter Task Checklist Modal */}\n      <GlassChecklistModal\n        isOpen={isChecklistOpen}\n        onClose={() => setIsChecklistOpen(false)}\n        tasks={tasks}\n        onToggleTask={handleToggleTask}\n        onBatchTogglePhase={handleBatchTogglePhase}\n        themeMode={themeMode}\n      />\n\n      {/* RRF Simulator & Hybrid Search Modal */}\n      <GlassSimulatorModal\n        isOpen={isSimulatorOpen}\n        onClose={() => setIsSimulatorOpen(false)}\n        themeMode={themeMode}\n      />\n    </div>\n  );\n}"
      replacement_content: "import { useState, useEffect } from \'react\';\nimport { CHAPTER_TASKS, TaskItem } from \'./data/tasksData\';\nimport { SAMPLE_VAULT_NOTES, VaultNote } from \'./data/notesData\';\nimport { GlassBackground } from \'./components/GlassBackground\';\nimport { GlassSidebar } from \'./components/GlassSidebar\';\nimport { GlassProfileCard } from \'./components/GlassProfileCard\';\nimport { GlassMetricsCard } from \'./components/GlassMetricsCard\';\nimport { GlassCalendarCard } from \'./components/GlassCalendarCard\';\nimport { GlassRecentNotesCard } from \'./components/GlassRecentNotesCard\';\nimport { GlassWeatherStatusCard } from \'./components/GlassWeatherStatusCard\';\nimport { GlassAiInsightCard } from \'./components/GlassAiInsightCard\';\nimport { GlassDirectoryCard } from \'./components/GlassDirectoryCard\';\nimport { GlassTodoWidget } from \'./components/GlassTodoWidget\';\nimport { GlassNewsCard } from \'./components/GlassNewsCard\';\nimport { GlassBottomBar } from \'./components/GlassBottomBar\';\nimport { GlassChecklistModal } from \'./components/GlassChecklistModal\';\nimport { GlassSimulatorModal } from \'./components/GlassSimulatorModal\';\nimport { GlassNoteModal } from \'./components/GlassNoteModal\';\nimport { GlassGraphModal } from \'./components/GlassGraphModal\';\nimport { GlassAnalysisModal } from \'./components/GlassAnalysisModal\';\nimport { GlassNewsModal } from \'./components/GlassNewsModal\';\nimport { Sparkles, Sun, Moon, CheckCircle } from \'lucide-react\';\n\nconst STORAGE_KEY = \'obsidian_mcp_checklist_state_v2\';\nconst THEME_KEY = \'obsidian_glass_theme_mode\';\nconst NOTES_STORAGE_KEY = \'obsidian_vault_notes_v2\';\n\nexport default function App() {\n  // Theme mode: \'weiss\' (Pure Crystal Ice Glass) or \'bunt\' (Vibrant Sunset & Neon Holographic Glass)\n  const [themeMode, setThemeMode] = useState<\'weiss\' | \'bunt\'>(() => {\n    try {\n      const saved = localStorage.getItem(THEME_KEY);\n      if (saved === \'weiss\' || saved === \'bunt\') return saved;\n    } catch {\n      // fallback\n    }\n    return \'weiss\'; // default to the pristine white frosted glass requested by user\n  });\n\n  // Task list items\n  const [tasks, setTasks] = useState<TaskItem[]>(() => {\n    try {\n      const saved = localStorage.getItem(STORAGE_KEY);\n      if (saved) {\n        const savedIds: string[] = JSON.parse(saved);\n        return CHAPTER_TASKS.map((t) => ({\n          ...t,\n          completed: savedIds.includes(t.id),\n        }));\n      }\n    } catch {\n      // fallback\n    }\n    return CHAPTER_TASKS.map((t) => ({ ...t, completed: false }));\n  });\n\n  // Vault Notes State\n  const [vaultNotes, setVaultNotes] = useState<Record<string, VaultNote>>(() => {\n    try {\n      const saved = localStorage.getItem(NOTES_STORAGE_KEY);\n      if (saved) return JSON.parse(saved);\n    } catch {\n      // fallback\n    }\n    return SAMPLE_VAULT_NOTES;\n  });\n\n  // Active Note Modal\n  const [selectedNote, setSelectedNote] = useState<VaultNote | null>(null);\n  const [isNoteModalOpen, setIsNoteModalOpen] = useState(false);\n\n  // Other Modals\n  const [activeSection, setActiveSection] = useState(\'home\');\n  const [activeFolderFilter, setActiveFolderFilter] = useState<string | null>(null);\n  const [isChecklistOpen, setIsChecklistOpen] = useState(false);\n  const [isSimulatorOpen, setIsSimulatorOpen] = useState(false);\n  const [isGraphOpen, setIsGraphOpen] = useState(false);\n  const [isAnalysisOpen, setIsAnalysisOpen] = useState(false);\n  const [isNewsOpen, setIsNewsOpen] = useState(false);\n  const [notification, setNotification] = useState<string | null>(null);\n\n  // Save theme mode to localStorage\n  useEffect(() => {\n    localStorage.setItem(THEME_KEY, themeMode);\n  }, [themeMode]);\n\n  // Save completed tasks to localStorage\n  useEffect(() => {\n    const completedIds = tasks.filter((t) => t.completed).map((t) => t.id);\n    localStorage.setItem(STORAGE_KEY, JSON.stringify(completedIds));\n  }, [tasks]);\n\n  // Save notes to localStorage\n  useEffect(() => {\n    localStorage.setItem(NOTES_STORAGE_KEY, JSON.stringify(vaultNotes));\n  }, [vaultNotes]);\n\n  const handleToggleTask = (id: string) => {\n    setTasks((prev) =>\n      prev.map((t) => (t.id === id ? { ...t, completed: !t.completed } : t))\n    );\n  };\n\n  const handleBatchTogglePhase = (phase: string, completed: boolean) => {\n    setTasks((prev) =>\n      prev.map((t) => (t.phase === phase ? { ...t, completed } : t))\n    );\n  };\n\n  const showNotification = (msg: string) => {\n    setNotification(msg);\n    setTimeout(() => setNotification(null), 2500);\n  };\n\n  const handleOpenNote = (filename: string) => {\n    if (vaultNotes[filename]) {\n      setSelectedNote(vaultNotes[filename]);\n      setIsNoteModalOpen(true);\n    } else {\n      // create fallback note\n      const newNote: VaultNote = {\n        id: `note-${Date.now()}`,\n        filename,\n        title: filename.replace(/\\.md$/, \'\'),\n        folder: \'01-projects\',\n        updated: \'Gerade eben\',\n        tags: [\'markdown\', \'obsidian\'],\n        content: `# ${filename}\\n\\nNotizinhalt hier bearbeiten...`,\n      };\n      setSelectedNote(newNote);\n      setIsNoteModalOpen(true);\n    }\n  };\n\n  const handleSaveNote = (updated: VaultNote) => {\n    setVaultNotes((prev) => ({\n      ...prev,\n      [updated.filename]: updated,\n    }));\n    setSelectedNote(updated);\n    showNotification(`Gespeichert: ${updated.filename}`);\n  };\n\n  const handleCreateNewNote = () => {\n    const newFilename = `Neue-Notiz-${Date.now().toString().slice(-4)}.md`;\n    const newNote: VaultNote = {\n      id: `note-${Date.now()}`,\n      filename: newFilename,\n      title: \'Unbenannte Notiz\',\n      folder: \'00-inbox\',\n      updated: \'Gerade eben\',\n      tags: [\'inbox\', \'idee\'],\n      content: `---\\ntitle: \"Unbenannte Notiz\"\\ncreated: 2026-09-22\\ntags: [inbox]\\n---\\n\\n# Neue Notiz\\n\\nSchreibe deine Gedanken hier auf...`,\n    };\n    setSelectedNote(newNote);\n    setIsNoteModalOpen(true);\n  };\n\n  const handleCreateDailyNote = () => {\n    const dailyFilename = \'2026-09-22.md\';\n    if (vaultNotes[dailyFilename]) {\n      setSelectedNote(vaultNotes[dailyFilename]);\n    } else {\n      const dailyNote: VaultNote = {\n        id: \'note-daily-today\',\n        filename: dailyFilename,\n        title: \'Tagesnotiz: 22. September 2026\',\n        folder: \'06-daily\',\n        updated: \'Gerade eben\',\n        tags: [\'daily\', \'journal\', \'standup\'],\n        content: `---\\ntitle: \"Tagesnotiz 2026-09-22\"\\ntype: daily\\ndate: 2026-09-22\\n---\\n\\n# Tagesjournal \302\267 22. September 2026\\n\\n## Fokus des Tages\\n- [ ] Obsidian MCP Pipeline verifizieren\\n- [ ] sqlite-vec Indizierung der 16.894 Notizen pr\303\274fen\\n- [ ] Claude Code Hook \'UserPromptSubmit\' testen\\n\\n## Notizen & Beobachtungen\\n- Hybrides Retrieval liefert unter 23ms exakte Treffer.\\n- Keine API-Kosten dank Model2Vec auf lokaler CPU.`,\n      };\n      setVaultNotes((prev) => ({ ...prev, [dailyFilename]: dailyNote }));\n      setSelectedNote(dailyNote);\n    }\n    setIsNoteModalOpen(true);\n  };\n\n  const completedCount = tasks.filter((t) => t.completed).length;\n  const isWeiss = themeMode === \'weiss\';\n\n  return (\n    <div\n      className={`min-h-screen relative flex flex-col selection:bg-cyan-500/30 selection:text-cyan-200 transition-colors duration-500 overflow-x-hidden ${\n        isWeiss ? \'text-slate-800\' : \'text-slate-100\'\n      }`}\n    >\n      {/* Dynamic Alpine Lake & Mountain Backdrop with Steam / Droplet textures */}\n      <GlassBackground themeMode={themeMode} />\n\n      {/* Floating Notification Toast */}\n      {notification && (\n        <div className=\"fixed top-6 left-1/2 -translate-x-1/2 z-50 px-4 py-2 rounded-2xl glass-white shadow-xl text-xs font-semibold flex items-center gap-2 animate-in fade-in slide-in-from-top-4\">\n          <CheckCircle className=\"w-4 h-4 text-emerald-500\" />\n          <span>{notification}</span>\n        </div>\n      )}\n\n      {/* Main Container */}\n      <div className=\"relative z-10 flex-1 flex flex-col md:flex-row p-3 sm:p-6 lg:p-8 max-w-[1700px] mx-auto w-full gap-5 pb-24\">\n        {/* Far Left Vertical Glass Pill Bar (Matching image-1790114036816.png) */}\n        <GlassSidebar\n          themeMode={themeMode}\n          activeSection={activeSection}\n          setActiveSection={setActiveSection}\n          onOpenChecklist={() => setIsChecklistOpen(true)}\n          onOpenSimulator={() => setIsSimulatorOpen(true)}\n          onOpenGraph={() => setIsGraphOpen(true)}\n          onOpenAnalysis={() => setIsAnalysisOpen(true)}\n          onOpenAllNotes={() => handleOpenNote(\'15 die-vollst\303\244ndige-retrieval-pipeline.md\')}\n        />\n\n        {/* Center Dashboard Workspace */}\n        <div className=\"flex-1 flex flex-col gap-5\">\n          {/* Top Giant 3D Glass Typography Greeting */}\n          <div className=\"flex flex-col sm:flex-row items-center justify-between gap-3 px-2\">\n            <h1\n              className={`text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight font-display select-none transition-all ${\n                isWeiss ? \'glass-text-3d\' : \'glass-text-3d-bunt\'\n              }`}\n            >\n              Guten Abend, Sascha\n            </h1>\n\n            {/* Top Action & Theme Switcher Pills */}\n            <div className=\"flex items-center gap-2\">\n              <button\n                onClick={() => setIsAnalysisOpen(true)}\n                className={`px-3 py-1.5 rounded-full text-xs font-semibold flex items-center gap-1.5 transition-all cursor-pointer shadow-md ${\n                  isWeiss\n                    ? \'glass-pill-white text-indigo-700 hover:bg-white\'\n                    : \'glass-pill-bunt text-cyan-300 hover:bg-white/20\'\n                }`}\n              >\n                <Sparkles className=\"w-3.5 h-3.5\" />\n                <span className=\"hidden sm:inline\">Konzept & Analyse</span>\n              </button>\n\n              <div\n                className={`flex items-center gap-1.5 p-1 rounded-full glass-rainbow-edge shadow-md transition-all ${\n                  isWeiss ? \'glass-white\' : \'glass-bunt\'\n                }`}\n              >\n                <button\n                  onClick={() => setThemeMode(\'weiss\')}\n                  className={`px-3 py-1 rounded-full text-xs font-semibold flex items-center gap-1.5 transition-all cursor-pointer ${\n                    isWeiss\n                      ? \'bg-white text-indigo-900 shadow-sm font-bold\'\n                      : \'text-slate-300 hover:text-white\'\n                  }`}\n                >\n                  <Sun className=\"w-3.5 h-3.5 text-amber-500\" />\n                  <span>Weiss</span>\n                </button>\n\n                <button\n                  onClick={() => setThemeMode(\'bunt\')}\n                  className={`px-3 py-1 rounded-full text-xs font-semibold flex items-center gap-1.5 transition-all cursor-pointer ${\n                    !isWeiss\n                      ? \'bg-gradient-to-r from-cyan-500 to-fuchsia-500 text-white shadow-md font-bold\'\n                      : \'text-slate-600 hover:text-slate-900\'\n                  }`}\n                >\n                  <Sparkles className=\"w-3.5 h-3.5 text-yellow-300\" />\n                  <span>Bunt</span>\n                </button>\n              </div>\n            </div>\n          </div>\n\n          {/* Upper Dashboard Grid: 4 Pillars */}\n          <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5\">\n            {/* 1. Profile Card with Avatar & Colored Folders */}\n            <GlassProfileCard\n              themeMode={themeMode}\n              userName=\"Sascha\"\n              totalNotesCount=\"16.894\"\n              activeFolderFilter={activeFolderFilter}\n              setActiveFolderFilter={(folder) => {\n                setActiveFolderFilter(folder);\n                showNotification(`Filter aktiv: ${folder || \'Alle Ordner\'}`);\n              }}\n              onOpenChecklist={() => setIsChecklistOpen(true)}\n            />\n\n            {/* 2. Notiz- & Retrieval-Statistik Card (4 insets) */}\n            <GlassMetricsCard\n              themeMode={themeMode}\n              notesCount=\"16.894\"\n              wordCount=\"49,7k\"\n              folderCount=\"12\"\n              avgWords=\"23ms\"\n              onOpenDetails={() => setIsSimulatorOpen(true)}\n            />\n\n            {/* 3. Kalender Card (September 2026) */}\n            <GlassCalendarCard\n              themeMode={themeMode}\n              onSelectDate={(day) => {\n                showNotification(`Kalendertag gew\303\244hlt: ${day}. September 2026`);\n                handleCreateDailyNote();\n              }}\n            />\n\n            {/* 4. Zuletzt ge\303\266ffnet (Markdown Documents) */}\n            <GlassRecentNotesCard\n              themeMode={themeMode}\n              onSelectNote={(noteFilename) => {\n                handleOpenNote(noteFilename);\n              }}\n            />\n          </div>\n\n          {/* Lower Row Grid: 5 Glass Tiles */}\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 sm:gap-5\">\n            {/* Tile 1: Wetter & System */}\n            <GlassWeatherStatusCard themeMode={themeMode} />\n\n            {/* Tile 2: KI-Einblick */}\n            <GlassAiInsightCard\n              themeMode={themeMode}\n              onOpenSimulator={() => setIsSimulatorOpen(true)}\n            />\n\n            {/* Tile 3: Verzeichnis */}\n            <GlassDirectoryCard\n              themeMode={themeMode}\n              onOpenVaultView={() => setIsChecklistOpen(true)}\n            />\n\n            {/* Tile 4: To-dos (All 32 Chapters integrated) */}\n            <GlassTodoWidget\n              themeMode={themeMode}\n              completedCount={completedCount}\n              totalCount={tasks.length}\n              onOpenChecklist={() => setIsChecklistOpen(true)}\n            />\n\n            {/* Tile 5: News & Release */}\n            <GlassNewsCard\n              themeMode={themeMode}\n              onOpenAudit={() => setIsNewsOpen(true)}\n            />\n          </div>\n        </div>\n      </div>\n\n      {/* Floating Horizontal Glass Bottom Bar */}\n      <GlassBottomBar\n        themeMode={themeMode}\n        setThemeMode={setThemeMode}\n        onOpenChecklist={() => setIsChecklistOpen(true)}\n        onOpenSimulator={() => setIsSimulatorOpen(true)}\n        onOpenGraph={() => setIsGraphOpen(true)}\n        onOpenAnalysis={() => setIsAnalysisOpen(true)}\n        onNewNote={handleCreateNewNote}\n        onDailyNote={handleCreateDailyNote}\n      />\n\n      {/* Full 32-Chapter Task Checklist Modal */}\n      <GlassChecklistModal\n        isOpen={isChecklistOpen}\n        onClose={() => setIsChecklistOpen(false)}\n        tasks={tasks}\n        onToggleTask={handleToggleTask}\n        onBatchTogglePhase={handleBatchTogglePhase}\n        themeMode={themeMode}\n      />\n\n      {/* RRF Simulator & Hybrid Search Modal */}\n      <GlassSimulatorModal\n        isOpen={isSimulatorOpen}\n        onClose={() => setIsSimulatorOpen(false)}\n        themeMode={themeMode}\n      />\n\n      {/* Interactive Obsidian Markdown Note Reader & Editor */}\n      <GlassNoteModal\n        isOpen={isNoteModalOpen}\n        onClose={() => setIsNoteModalOpen(false)}\n        note={selectedNote}\n        onSaveNote={handleSaveNote}\n        themeMode={themeMode}\n      />\n\n      {/* Interactive Obsidian 2D Graph View Modal */}\n      <GlassGraphModal\n        isOpen={isGraphOpen}\n        onClose={() => setIsGraphOpen(false)}\n        themeMode={themeMode}\n        onSelectNode={(nodeName) => {\n          showNotification(`Knoten im Graph fokussiert: ${nodeName}`);\n        }}\n      />\n\n      {/* Full Concept & Sinnhaftigkeit Analysis Modal */}\n      <GlassAnalysisModal\n        isOpen={isAnalysisOpen}\n        onClose={() => setIsAnalysisOpen(false)}\n        themeMode={themeMode}\n        onOpenChecklist={() => setIsChecklistOpen(true)}\n      />\n\n      {/* News & Release Notes Modal */}\n      <GlassNewsModal\n        isOpen={isNewsOpen}\n        onClose={() => setIsNewsOpen(false)}\n        themeMode={themeMode}\n      />\n    </div>\n  );\n}"
    }
