        target_content: "import { X, BookOpen, CheckCircle, ShieldCheck, Zap, Layers, AlertTriangle } from \'lucide-react\';\n\ninterface Props {\n  isOpen: boolean;\n  onClose: () => void;\n  themeMode: \'weiss\' | \'bunt\';\n  onOpenChecklist: () => void;\n}\n\nexport const GlassAnalysisModal = ({\n  isOpen,\n  onClose,\n  themeMode,\n  onOpenChecklist,\n}: Props) => {\n  if (!isOpen) return null;\n  const isWeiss = themeMode === \'weiss\';"
