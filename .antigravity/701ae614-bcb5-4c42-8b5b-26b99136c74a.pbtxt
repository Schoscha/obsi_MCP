    replacement_infos {
      original_chunk {
        target_content: "                      <div className=\"flex flex-wrap items-center gap-2\">\n                        <span className=\"text-xs font-mono font-bold text-indigo-600 dark:text-cyan-300\">\n                          Kapitel {task.chapter}\n                        </span>\n\n                        <span\n                          className={`text-[10px] px-2 py-0.5 rounded font-mono font-semibold ${\n                            isCritical\n                              ? \'bg-rose-500/20 text-rose-600 dark:text-rose-300 border border-rose-500/30\'\n                              : task.priority === \'Hoch\'\n                              ? \'bg-amber-500/20 text-amber-600 dark:text-amber-300 border border-amber-500/30\'\n                              : \'bg-slate-500/20 text-slate-600 dark:text-slate-300\'\n                          }`}\n                        >\n                          {task.priority}\n                        </span>\n\n                        <span\n                          className={`text-[10px] font-mono px-2 py-0.5 rounded ${\n                            isWeiss ? \'bg-slate-100 text-slate-600\' : \'bg-black/30 text-slate-400\'\n                          }`}\n                        >\n                          {task.fileName}\n                        </span>\n                      </div>\n\n                      <h3\n                        className={`text-sm font-semibold mt-1 ${\n                          task.completed ? \'line-through text-slate-500\' : \'\'\n                        }`}\n                      >\n                        {task.title}\n                      </h3>\n\n                      <p className=\"text-xs text-slate-600 dark:text-slate-300 mt-0.5 line-clamp-2\">\n                        {task.description}\n                      </p>\n                    </div>\n\n                    <button\n                      onClick={() => setExpandedTaskId(isExpanded ? null : task.id)}\n                      className=\"p-1 rounded text-slate-400 hover:text-slate-600 cursor-pointer shrink-0\"\n                    >\n                      {isExpanded ? <ChevronUp className=\"w-4 h-4\" /> : <ChevronDown className=\"w-4 h-4\" />}\n                    </button>\n                  </div>\n\n                  {/* Expanded Detail Drawer */}\n                  {isExpanded && (\n                    <div className=\"px-4 pb-4 pt-1 border-t border-slate-200/50 dark:border-white/10 space-y-3 text-xs\">\n                      <div>\n                        <div className=\"font-semibold text-[11px] uppercase tracking-wider text-slate-500 mb-1.5\">\n                          Liefergegenst\303\244nde & Schritte:\n                        </div>\n                        <ul className=\"space-y-1 pl-1\">\n                          {task.deliverables.map((item, idx) => (\n                            <li key={idx} className=\"flex items-start gap-2\">\n                              <span className=\"text-indigo-500 dark:text-cyan-400 font-bold\">\342\200\272</span>\n                              <span>{item}</span>\n                            </li>\n                          ))}\n                        </ul>\n                      </div>\n\n                      {task.codeSnippet && (\n                        <div>\n                          <div className=\"flex items-center gap-1.5 font-semibold text-[11px] uppercase tracking-wider text-slate-500 mb-1\">\n                            <Code className=\"w-3.5 h-3.5\" />\n                            <span>Referenz-Implementierung:</span>\n                          </div>\n                          <pre\n                            className={`p-3 rounded-xl font-mono-code text-[11px] overflow-x-auto border ${\n                              isWeiss\n                                ? \'bg-slate-900 text-slate-100 border-slate-700\'\n                                : \'bg-black/60 text-cyan-200 border-cyan-900/40\'\n                            }`}\n                          >\n                            <code>{task.codeSnippet}</code>\n                          </pre>\n                        </div>\n                      )}\n                    </div>\n                  )}"
        replacement_content: "                      <div className=\"flex flex-wrap items-center gap-2\">\n                        <span className=\"text-xs font-mono font-bold text-indigo-600 dark:text-cyan-300\">\n                          Kapitel {task.chapterNumber}\n                        </span>\n\n                        <span\n                          className={`text-[10px] px-2 py-0.5 rounded font-mono font-semibold ${\n                            isCritical\n                              ? \'bg-rose-500/20 text-rose-600 dark:text-rose-300 border border-rose-500/30\'\n                              : task.priority === \'Hoch\'\n                              ? \'bg-amber-500/20 text-amber-600 dark:text-amber-300 border border-amber-500/30\'\n                              : \'bg-slate-500/20 text-slate-600 dark:text-slate-300\'\n                          }`}\n                        >\n                          {task.priority}\n                        </span>\n\n                        <span\n                          className={`text-[10px] font-mono px-2 py-0.5 rounded ${\n                            isWeiss ? \'bg-slate-100 text-slate-600\' : \'bg-black/30 text-slate-400\'\n                          }`}\n                        >\n                          {task.filename}\n                        </span>\n                      </div>\n\n                      <h3\n                        className={`text-sm font-semibold mt-1 ${\n                          task.completed ? \'line-through text-slate-500\' : \'\'\n                        }`}\n                      >\n                        {task.title}\n                      </h3>\n\n                      <p className=\"text-xs text-slate-600 dark:text-slate-300 mt-0.5 line-clamp-2\">\n                        {task.summary}\n                      </p>\n                    </div>\n\n                    <button\n                      onClick={() => setExpandedTaskId(isExpanded ? null : task.id)}\n                      className=\"p-1 rounded text-slate-400 hover:text-slate-600 cursor-pointer shrink-0\"\n                    >\n                      {isExpanded ? <ChevronUp className=\"w-4 h-4\" /> : <ChevronDown className=\"w-4 h-4\" />}\n                    </button>\n                  </div>\n\n                  {/* Expanded Detail Drawer */}\n                  {isExpanded && (\n                    <div className=\"px-4 pb-4 pt-1 border-t border-slate-200/50 dark:border-white/10 space-y-3 text-xs\">\n                      <div>\n                        <div className=\"font-semibold text-[11px] uppercase tracking-wider text-slate-500 mb-1.5\">\n                          Liefergegenst\303\244nde & Schritte:\n                        </div>\n                        <ul className=\"space-y-1 pl-1\">\n                          {task.deliverables.map((item, idx) => (\n                            <li key={idx} className=\"flex items-start gap-2\">\n                              <span className=\"text-indigo-500 dark:text-cyan-400 font-bold\">\342\200\272</span>\n                              <span>{item}</span>\n                            </li>\n                          ))}\n                        </ul>\n                      </div>\n\n                      {task.codeSnippets && task.codeSnippets.length > 0 && (\n                        <div className=\"space-y-2\">\n                          {task.codeSnippets.map((cs, cIdx) => (\n                            <div key={cIdx}>\n                              <div className=\"flex items-center gap-1.5 font-semibold text-[11px] uppercase tracking-wider text-slate-500 mb-1\">\n                                <Code className=\"w-3.5 h-3.5\" />\n                                <span>{cs.description || \'Referenz-Implementierung\'}:</span>\n                              </div>\n                              <pre\n                                className={`p-3 rounded-xl font-mono-code text-[11px] overflow-x-auto border ${\n                                  isWeiss\n                                    ? \'bg-slate-900 text-slate-100 border-slate-700\'\n                                    : \'bg-black/60 text-cyan-200 border-cyan-900/40\'\n                                }`}\n                              >\n                                <code>{cs.code}</code>\n                              </pre>\n                            </div>\n                          ))}\n                        </div>\n                      )}\n                    </div>\n                  )}"
      }
