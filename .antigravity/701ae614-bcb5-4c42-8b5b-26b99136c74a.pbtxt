  file_change {
    absolute_path_uri: "file:///src/data/audioExplanationData.ts"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "export interface AudioChapter {\n  id: string;\n  title: string;\n  subtitle: string;\n  durationEst: string;\n  text: string;\n}\n\nexport const AUDIO_EXPLANATION_CHAPTERS: AudioChapter[] = [\n  {\n    id: \'intro\',\n    title: \'1. Das Kernproblem herk\303\266mmlicher KI-Notizen\',\n    subtitle: \'Warum reine Stichwortsuche und reine Vektorsuche bisher scheitern\',\n    durationEst: \'1:10\',\n    text: `Willkommen zur Audio-Erkl\303\244rung des Obsidian Hybrid Retrieval Systems 2026.\n\nWenn du ein KI-Modell wie Claude oder GPT nach Inhalten in deinen Notizen fragst, gab es bisher zwei Extreme, die beide fehlschlagen:\n\nErstens: Die reine Stichwortsuche mit Grep oder Standard-Suchleisten. Suchst du nach der Absicherung von Benutzersitzungen, deine Notiz hei\303\237t aber OAuth Refresh Token Rotation, findest du genau null Treffer, obwohl der Inhalt exakt passt.\n\nZweitens: Die reine semantische Vektorsuche. Sie versteht zwar Konzepte, scheitert aber kl\303\244glich an exakten Bezeichnern. Suchst du nach einer bestimmten Funktion wie authMiddleware_v2 oder einem Fehlercode, findet die Vektorsuche oft beliebige allgemeine Programmiernotizen, aber nicht die exakte Codezeile.\n\nDazu kommt der Cloud-Zwang: Herk\303\266mmliche Vektor-Datenbanken schicken deine privaten Notizen ins Internet, kosten Geld und sind mit 200 bis 500 Millisekunden qu\303\244lend langsam.`,\n  },\n  {\n    id: \'solution\',\n    title: \'2. Die L\303\266sung: Die hybride 2026er Pipeline\',\n    subtitle: \'100% lokal, 23 Millisekunden p50 Latenz und null Cloud-Kosten\',\n    durationEst: \'1:20\',\n    text: `Die hier implementierte Architektur l\303\266st dieses Dilemma durch eine hybride Dual-Pipeline, die vollst\303\244ndig auf deinem lokalen Rechner l\303\244uft.\n\nSobald du eine Frage stellst, passiert folgendes in unter 25 Millisekunden:\n\nSchritt eins: SQLite FTS5 f\303\274hrt eine blitzschnelle BM25-Volltextsuche nach exakten W\303\266rtern, Begriffen und IDs durch. Das dauert nur 3 bis 5 Millisekunden.\n\nSchritt zwei: Zeitgleich berechnet Model2Vec ein 256-dimensionales Embedding deiner Frage und sqlite-vec f\303\274hrt eine Kosinus-\303\204hnlichkeitssuche durch. Das dauert 8 bis 14 Millisekunden.\n\nBeide Teilsysteme liefern jeweils ihre Top 60 Treffer ab. Und genau hier kommt das mathematische Herzst\303\274ck ins Spiel: Die Reciprocal Rank Fusion.`,\n  },\n  {\n    id: \'model2vec\',\n    title: \'3. Model2Vec: Das 30-Megabyte-Wunder\',\n    subtitle: \'Kein PyTorch, kein GPU-Zwang \342\200\223 500x schnellere Vektoren auf reiner CPU\',\n    durationEst: \'1:05\',\n    text: `Der absolute technologische Durchbruch in diesem Konzept ist Model2Vec mit dem Modell potion-base-8M.\n\nFr\303\274here Vektor-Modelle brauchten gigantische Bibliotheken wie PyTorch mit hunderten Megabytes an Abh\303\244ngigkeiten und viel Arbeitsspeicher.\n\nModel2Vec wiegt gerade einmal 30 Megabyte. Es l\303\244uft mit purem NumPy direkt auf deiner normalen Computer-CPU. Es ist 500-mal schneller als herk\303\266mmliche BERT-Modelle.\n\nEin Vault mit 16.000 Notizen wird damit in unter 4 Minuten komplett indiziert. Es gibt keine API-Kosten, keine Datenweitergabe und keine Netzwerkabh\303\244ngigkeit.`,\n  },\n  {\n    id: \'rrf\',\n    title: \'4. Reciprocal Rank Fusion (RRF mit k = 60)\',\n    subtitle: \'Wie zwei v\303\266llig unvergleichbare Scores perfekt vereint werden\',\n    durationEst: \'1:15\',\n    text: `Das gr\303\266\303\237te mathematische Problem bei hybriden Suchen war bisher: Wie vergleicht man einen BM25-Score von beispielsweise 14,2 mit einer Kosinus-\303\204hnlichkeit von 0,87? Normierungen schlagen hier oft fehl.\n\nDie Reciprocal Rank Fusion l\303\266st das genial \303\274ber R\303\244nge statt \303\274ber absolute Punktwerte.\n\nDie Formel lautet: Eins geteilt durch sechzig plus den BM25-Rang, plus eins geteilt durch sechzig plus den Vektor-Rang.\n\nDie Konstante k gleich 60 sorgt daf\303\274r, dass ein einzelner Ausrei\303\237er das Ranking nicht verzerrt. Landet eine Notiz aber in beiden Ranglisten weit oben, katapultiert die RRF-Formel sie unangefochten auf Platz eins. Das liefert eine Treffsicherheit, die reine Vektorsuchen meilenweit \303\274bertrifft.`,\n  },\n  {\n    id: \'mcp-claude\',\n    title: \'5. Obsidian MCP & Claude Code Integration\',\n    subtitle: \'Headless Dateisystem-Zugriff und Token-Budgetierung\',\n    durationEst: \'1:10\',\n    text: `Der letzte Baustein ist die Anbindung an deinen KI-Agenten \303\274ber das Model Context Protocol.\n\nDer Server obsidian-mcp l\303\244uft im lokalen STDIO-Modus ohne offene Web-Ports. Er greift direkt auf die Markdown-Dateien zu \342\200\223 Obsidian muss daf\303\274r nicht einmal gestartet sein.\n\n\303\234ber den Hook UserPromptSubmit in Claude Code werden die relevanten Abschnitte automatisch dem Prompt vorangestellt.\n\nDabei wird ein striktes Token-Budget von maximal 1.500 bis 4.000 Tokens eingehalten. So bleibt der Prompt Cache von Claude intakt, Kosten werden minimiert und das Modell leidet nicht unter Kontext-\303\234berladung.\n\n\303\234ber die .indexignore-Datei sch\303\274tzt du gleichzeitig private Notizen, Finanzen oder Passw\303\266rter vor der Indizierung.`,\n  },\n  {\n    id: \'cockpit\',\n    title: \'6. Deine Steuerzentrale im Cockpit\',\n    subtitle: \'Weiss/Bunt Design, 32 Kapitel Taskliste und Live-Simulator\',\n    durationEst: \'0:50\',\n    text: `Dieses Cockpit b\303\274ndelt die gesamte Architektur in einer eleganten 3D-Glasoberfl\303\244che:\n\nDu kannst jederzeit zwischen dem reinweissen Kristall-Eisglas und dem holografischen Bunt-Modus wechseln.\n\nIm RRF-Simulator kannst du live testen, wie sich die Trefferliste ver\303\244ndert, wenn du an den Gewichten f\303\274r Volltext und Vektoren drehst.\n\nUnd in der 32-Kapitel-Taskliste findest du jeden einzelnen Implementierungsschritt zum Abhaken, inklusive Code-Vorlagen und 1-Klick-Export f\303\274r deinen eigenen Obsidian-Vault.`,\n  },\n];\n"
    }
    diff {
      unified_diff {
