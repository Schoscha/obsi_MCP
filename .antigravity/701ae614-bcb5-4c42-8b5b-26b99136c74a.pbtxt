    replacement_chunks {
      replacement_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport { useState, useEffect } from \'react\';\nimport { CHAPTER_TASKS, TaskItem } from \'./data/tasksData\';\nimport { MountainSunsetBanner } from \'./components/MountainSunsetBanner\';\nimport { CircularGauges } from \'./components/CircularGauges\';\nimport { TaskChecklistView } from \'./components/TaskChecklistView\';\nimport { ArchitectureSimulator } from \'./components/ArchitectureSimulator\';\nimport { AnalysisConceptView } from \'./components/AnalysisConceptView\';\nimport { VaultStructureView } from \'./components/VaultStructureView\';\nimport { BottomControlDock } from \'./components/BottomControlDock\';\nimport {\n  ListTodo,\n  Cpu,\n  BookOpen,\n  FolderTree,\n  Terminal,\n  Shield,\n  Activity,\n  Download,\n  Flame,\n  CheckCircle2,\n} from \'lucide-react\';\n\nconst STORAGE_KEY = \'obsidian_mcp_checklist_state_v1\';\n\nexport default function App() {\n  const [tasks, setTasks] = useState<TaskItem[]>(() => {\n    try {\n      const saved = localStorage.getItem(STORAGE_KEY);\n      if (saved) {\n        const savedIds: string[] = JSON.parse(saved);\n        return CHAPTER_TASKS.map((t) => ({\n          ...t,\n          completed: savedIds.includes(t.id),\n        }));\n      }\n    } catch {\n      // fallback\n    }\n    return CHAPTER_TASKS.map((t) => ({ ...t, completed: false }));\n  });\n\n  const [activeTab, setActiveTab] = useState<\'tasks\' | \'simulator\' | \'analysis\' | \'vault\'>(\'tasks\');\n  const [activePhase, setActivePhase] = useState<string>(\'Alle Phasen\');\n\n  // Save to localStorage\n  useEffect(() => {\n    const completedIds = tasks.filter((t) => t.completed).map((t) => t.id);\n    localStorage.setItem(STORAGE_KEY, JSON.stringify(completedIds));\n  }, [tasks]);\n\n  const handleToggleTask = (id: string) => {\n    setTasks((prev) =>\n      prev.map((t) => (t.id === id ? { ...t, completed: !t.completed } : t))\n    );\n  };\n\n  const handleBatchTogglePhase = (phase: string, completed: boolean) => {\n    setTasks((prev) =>\n      prev.map((t) => (t.phase === phase ? { ...t, completed } : t))\n    );\n  };\n\n  const handleResetAllTasks = () => {\n    if (window.confirm(\'M\303\266chtest du wirklich alle gesetzten H\303\244kchen zur\303\274cksetzen?\')) {\n      setTasks((prev) => prev.map((t) => ({ ...t, completed: false })));\n    }\n  };\n\n  const completedCount = tasks.filter((t) => t.completed).length;\n  const criticalTasks = tasks.filter((t) => t.priority === \'Kritisch\');\n  const criticalCompletedCount = criticalTasks.filter((t) => t.completed).length;\n\n  return (\n    <div className=\"min-h-screen bg-[#0b0914] text-slate-100 flex flex-col selection:bg-orange-500/30 selection:text-orange-200 pb-24\">\n      {/* 3-Zone Clean Top Bar Contract per Frontend Guidelines */}\n      <header className=\"sticky top-0 z-30 bg-[#0c0918]/90 backdrop-blur-md border-b border-purple-500/20 px-4 sm:px-8 py-3.5\">\n        <div className=\"max-w-7xl mx-auto flex items-center justify-between\">\n          {/* Zone 1: Single text element wordmark */}\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-8 h-8 rounded-lg bg-gradient-to-br from-orange-500 to-purple-600 flex items-center justify-center shadow-lg shadow-orange-500/20 glow-orange\">\n              <Terminal className=\"w-4 h-4 text-white\" />\n            </div>\n            <span className=\"text-base sm:text-lg font-bold font-display tracking-tight text-white flex items-center gap-2\">\n              OBSIDIAN MCP COCKPIT\n              <span className=\"text-[10px] font-mono text-orange-400 bg-orange-950/60 border border-orange-500/30 px-2 py-0.5 rounded hidden sm:inline\">\n                REF 2026\n              </span>\n            </span>\n          </div>\n\n          {/* Zone 2: 4 Clean text navigation links */}\n          <nav className=\"hidden md:flex items-center gap-6 text-xs font-mono text-slate-400\">\n            <button\n              onClick={() => setActiveTab(\'tasks\')}\n              className={`hover:text-orange-400 transition-colors cursor-pointer ${\n                activeTab === \'tasks\' ? \'text-orange-400 font-bold border-b-2 border-orange-500 pb-0.5\' : \'\'\n              }`}\n            >\n              Master Taskliste ({completedCount}/32)\n            </button>\n            <button\n              onClick={() => setActiveTab(\'simulator\')}\n              className={`hover:text-cyan-400 transition-colors cursor-pointer ${\n                activeTab === \'simulator\' ? \'text-cyan-400 font-bold border-b-2 border-cyan-400 pb-0.5\' : \'\'\n              }`}\n            >\n              RRF Simulator\n            </button>\n            <button\n              onClick={() => setActiveTab(\'analysis\')}\n              className={`hover:text-purple-400 transition-colors cursor-pointer ${\n                activeTab === \'analysis\' ? \'text-purple-400 font-bold border-b-2 border-purple-400 pb-0.5\' : \'\'\n              }`}\n            >\n              Sinn & Konzept\n            </button>\n            <button\n              onClick={() => setActiveTab(\'vault\')}\n              className={`hover:text-amber-400 transition-colors cursor-pointer ${\n                activeTab === \'vault\' ? \'text-amber-400 font-bold border-b-2 border-amber-400 pb-0.5\' : \'\'\n              }`}\n            >\n              Vault Schema\n            </button>\n          </nav>\n\n          {/* Zone 3: 1-2 primary actions */}\n          <div className=\"flex items-center gap-3\">\n            <div className=\"hidden sm:flex items-center gap-1.5 text-xs font-mono text-emerald-400 bg-emerald-950/40 border border-emerald-500/30 px-3 py-1.5 rounded-lg\">\n              <Activity className=\"w-3.5 h-3.5 animate-pulse\" />\n              <span>23ms Hybrid Latency</span>\n            </div>\n          </div>\n        </div>\n      </header>\n\n      {/* Main Dashboard Body */}\n      <main className=\"flex-1 max-w-7xl w-full mx-auto px-4 sm:px-8 py-6 space-y-6\">\n        {/* Top Artistic Hero Window: Mountain Sunset Horizon with Audio Waveform Equalizer (strictly matching vorlage.jpg) */}\n        <MountainSunsetBanner\n          completedCount={completedCount}\n          totalCount={tasks.length}\n          activePhaseTitle={activePhase}\n        />\n\n        {/* Circular Telemetry Gauges & HUD Meters (strictly matching vorlage.jpg) */}\n        <CircularGauges\n          completedTasks={completedCount}\n          totalTasks={tasks.length}\n          criticalCompleted={criticalCompletedCount}\n          totalCritical={criticalTasks.length}\n        />\n\n        {/* Dynamic Content Views */}\n        <div className=\"transition-all duration-300\">\n          {activeTab === \'tasks\' && (\n            <TaskChecklistView\n              tasks={tasks}\n              onToggleTask={handleToggleTask}\n              onBatchTogglePhase={handleBatchTogglePhase}\n              activePhase={activePhase}\n              setActivePhase={setActivePhase}\n            />\n          )}\n\n          {activeTab === \'simulator\' && <ArchitectureSimulator />}\n\n          {activeTab === \'analysis\' && <AnalysisConceptView />}\n\n          {activeTab === \'vault\' && <VaultStructureView />}\n        </div>\n      </main>\n\n      {/* Bottom Floating Control Dock matching vorlage.jpg */}\n      <BottomControlDock\n        activeTab={activeTab}\n        setActiveTab={setActiveTab}\n        onResetAllTasks={handleResetAllTasks}\n        completedTasks={completedCount}\n        totalTasks={tasks.length}\n      />\n    </div>\n  );\n}\n"
    }
