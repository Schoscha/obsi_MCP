  view_file {
    absolute_path_uri: "file:///src/components/GlassCalendarCard.tsx"
    end_line: 129
    content: "import { useState } from \'react\';\nimport { Calendar as CalendarIcon, ChevronLeft, ChevronRight } from \'lucide-react\';\n\ninterface Props {\n  themeMode: \'weiss\' | \'bunt\';\n}\n\nexport const GlassCalendarCard = ({ themeMode }: Props) => {\n  const isWeiss = themeMode === \'weiss\';\n  const [selectedDay, setSelectedDay] = useState(22);\n\n  const weekdays = [\'Mo\', \'Di\', \'Mi\', \'Do\', \'Fr\', \'Sa\', \'So\'];\n\n  // Days in September 2026 (starting Tuesday)\n  // August 31 is previous Monday\n  const days = [\n    { day: 31, isPrev: true },\n    { day: 1 },\n    { day: 2 },\n    { day: 3 },\n    { day: 4 },\n    { day: 5 },\n    { day: 6 },\n    { day: 7 },\n    { day: 8 },\n    { day: 9 },\n    { day: 10 },\n    { day: 11 },\n    { day: 12 },\n    { day: 13 },\n    { day: 14 },\n    { day: 15 },\n    { day: 16 },\n    { day: 17 },\n    { day: 18 },\n    { day: 19 },\n    { day: 20 },\n    { day: 21 },\n    { day: 22, isAuditDay: true },\n    { day: 23 },\n    { day: 24 },\n    { day: 25 },\n    { day: 26 },\n    { day: 27 },\n    { day: 28 },\n    { day: 29 },\n    { day: 30 },\n    { day: 1, isNext: true },\n    { day: 2, isNext: true },\n    { day: 3, isNext: true },\n    { day: 4, isNext: true },\n  ];\n\n  return (\n    <div\n      className={`rounded-2xl p-4 flex flex-col justify-between glass-rainbow-edge transition-all duration-300 ${\n        isWeiss ? \'glass-white text-slate-800\' : \'glass-bunt text-slate-100\'\n      }`}\n    >\n      {/* Calendar Header */}\n      <div className=\"flex items-center justify-between mb-2 px-1\">\n        <div className=\"flex items-center gap-2 text-xs font-bold\">\n          <CalendarIcon className={`w-4 h-4 ${isWeiss ? \'text-indigo-600\' : \'text-cyan-400\'}`} />\n          <span className={isWeiss ? \'text-slate-900\' : \'text-white\'}>Kalender</span>\n        </div>\n\n        <div className=\"flex items-center gap-1 text-xs font-medium\">\n          <span className={isWeiss ? \'text-slate-700\' : \'text-slate-200\'}>September 2026</span>\n          <div className=\"flex items-center ml-1\">\n            <button\n              className={`p-0.5 rounded hover:scale-110 transition-transform ${\n                isWeiss ? \'hover:bg-slate-200 text-slate-600\' : \'hover:bg-white/20 text-slate-300\'\n              }`}\n            >\n              <ChevronLeft className=\"w-3.5 h-3.5\" />\n            </button>\n            <button\n              className={`p-0.5 rounded hover:scale-110 transition-transform ${\n                isWeiss ? \'hover:bg-slate-200 text-slate-600\' : \'hover:bg-white/20 text-slate-300\'\n              }`}\n            >\n              <ChevronRight className=\"w-3.5 h-3.5\" />\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Weekday Row */}\n      <div className=\"grid grid-cols-7 text-center text-[10px] font-semibold text-slate-500 mb-1\">\n        {weekdays.map((wd) => (\n          <div key={wd} className=\"py-0.5\">\n            {wd}\n          </div>\n        ))}\n      </div>\n\n      {/* Days Grid */}\n      <div className=\"grid grid-cols-7 gap-1 text-center text-xs font-mono\">\n        {days.map((item, idx) => {\n          const isSelected = selectedDay === item.day && !item.isPrev && !item.isNext;\n          const isMuted = item.isPrev || item.isNext;\n\n          return (\n            <button\n              key={idx}\n              onClick={() => !isMuted && setSelectedDay(item.day)}\n              className={`py-1 rounded-md transition-all cursor-pointer relative ${\n                isSelected\n                  ? isWeiss\n                    ? \'bg-white text-indigo-700 font-bold shadow-md border border-indigo-400/50 scale-105\'\n                    : \'bg-white/30 text-white font-bold shadow-lg border border-cyan-400/80 scale-105\'\n                  : isMuted\n                  ? \'text-slate-400/60\'\n                  : isWeiss\n                  ? \'hover:bg-white/60 text-slate-700\'\n                  : \'hover:bg-white/10 text-slate-200\'\n              }`}\n            >\n              <span>{item.day}</span>\n              {item.isAuditDay && (\n                <span className=\"absolute bottom-0.5 left-1/2 -translate-x-1/2 w-1 h-1 rounded-full bg-indigo-500 dark:bg-cyan-400\" />\n              )}\n            </button>\n          );\n        })}\n      </div>\n    </div>\n  );\n};\n"
    raw_content: "import { useState } from \'react\';\nimport { Calendar as CalendarIcon, ChevronLeft, ChevronRight } from \'lucide-react\';\n\ninterface Props {\n  themeMode: \'weiss\' | \'bunt\';\n}\n\nexport const GlassCalendarCard = ({ themeMode }: Props) => {\n  const isWeiss = themeMode === \'weiss\';\n  const [selectedDay, setSelectedDay] = useState(22);\n\n  const weekdays = [\'Mo\', \'Di\', \'Mi\', \'Do\', \'Fr\', \'Sa\', \'So\'];\n\n  // Days in September 2026 (starting Tuesday)\n  // August 31 is previous Monday\n  const days = [\n    { day: 31, isPrev: true },\n    { day: 1 },\n    { day: 2 },\n    { day: 3 },\n    { day: 4 },\n    { day: 5 },\n    { day: 6 },\n    { day: 7 },\n    { day: 8 },\n    { day: 9 },\n    { day: 10 },\n    { day: 11 },\n    { day: 12 },\n    { day: 13 },\n    { day: 14 },\n    { day: 15 },\n    { day: 16 },\n    { day: 17 },\n    { day: 18 },\n    { day: 19 },\n    { day: 20 },\n    { day: 21 },\n    { day: 22, isAuditDay: true },\n    { day: 23 },\n    { day: 24 },\n    { day: 25 },\n    { day: 26 },\n    { day: 27 },\n    { day: 28 },\n    { day: 29 },\n    { day: 30 },\n    { day: 1, isNext: true },\n    { day: 2, isNext: true },\n    { day: 3, isNext: true },\n    { day: 4, isNext: true },\n  ];\n\n  return (\n    <div\n      className={`rounded-2xl p-4 flex flex-col justify-between glass-rainbow-edge transition-all duration-300 ${\n        isWeiss ? \'glass-white text-slate-800\' : \'glass-bunt text-slate-100\'\n      }`}\n    >\n      {/* Calendar Header */}\n      <div className=\"flex items-center justify-between mb-2 px-1\">\n        <div className=\"flex items-center gap-2 text-xs font-bold\">\n          <CalendarIcon className={`w-4 h-4 ${isWeiss ? \'text-indigo-600\' : \'text-cyan-400\'}`} />\n          <span className={isWeiss ? \'text-slate-900\' : \'text-white\'}>Kalender</span>\n        </div>\n\n        <div className=\"flex items-center gap-1 text-xs font-medium\">\n          <span className={isWeiss ? \'text-slate-700\' : \'text-slate-200\'}>September 2026</span>\n          <div className=\"flex items-center ml-1\">\n            <button\n              className={`p-0.5 rounded hover:scale-110 transition-transform ${\n                isWeiss ? \'hover:bg-slate-200 text-slate-600\' : \'hover:bg-white/20 text-slate-300\'\n              }`}\n            >\n              <ChevronLeft className=\"w-3.5 h-3.5\" />\n            </button>\n            <button\n              className={`p-0.5 rounded hover:scale-110 transition-transform ${\n                isWeiss ? \'hover:bg-slate-200 text-slate-600\' : \'hover:bg-white/20 text-slate-300\'\n              }`}\n            >\n              <ChevronRight className=\"w-3.5 h-3.5\" />\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Weekday Row */}\n      <div className=\"grid grid-cols-7 text-center text-[10px] font-semibold text-slate-500 mb-1\">\n        {weekdays.map((wd) => (\n          <div key={wd} className=\"py-0.5\">\n            {wd}\n          </div>\n        ))}\n      </div>\n\n      {/* Days Grid */}\n      <div className=\"grid grid-cols-7 gap-1 text-center text-xs font-mono\">\n        {days.map((item, idx) => {\n          const isSelected = selectedDay === item.day && !item.isPrev && !item.isNext;\n          const isMuted = item.isPrev || item.isNext;\n\n          return (\n            <button\n              key={idx}\n              onClick={() => !isMuted && setSelectedDay(item.day)}\n              className={`py-1 rounded-md transition-all cursor-pointer relative ${\n                isSelected\n                  ? isWeiss\n                    ? \'bg-white text-indigo-700 font-bold shadow-md border border-indigo-400/50 scale-105\'\n                    : \'bg-white/30 text-white font-bold shadow-lg border border-cyan-400/80 scale-105\'\n                  : isMuted\n                  ? \'text-slate-400/60\'\n                  : isWeiss\n                  ? \'hover:bg-white/60 text-slate-700\'\n                  : \'hover:bg-white/10 text-slate-200\'\n              }`}\n            >\n              <span>{item.day}</span>\n              {item.isAuditDay && (\n                <span className=\"absolute bottom-0.5 left-1/2 -translate-x-1/2 w-1 h-1 rounded-full bg-indigo-500 dark:bg-cyan-400\" />\n              )}\n            </button>\n          );\n        })}\n      </div>\n    </div>\n  );\n};\n"
    num_lines: 130
    num_bytes: 4198
  }
}
